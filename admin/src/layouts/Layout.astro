---
import { API_URL, APP_URL, CLIENT_URL } from "../lib/adrese";
const { title } = Astro.props;
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import TemaDugme from "../components/TemaDugme.astro";
import type { AstroCookies } from "astro";


const cookies = Astro.cookies as AstroCookies;
const refreshToken = cookies.get("refreshToken");

const authHeaders: Record<string, string> = refreshToken?.value
  ? {
      Authorization: `Bearer ${refreshToken.value}`,
    }
  : {};

let userData: { error?: string; email?: string; role?: string } = { error: "Unauthorized" };

try {
  const response = await fetch(`${API_URL}/api/auth/me`, {
    headers: authHeaders,
  });

  userData = response.ok ? await response.json() : { error: "Unauthorized" };
} catch {
  userData = { error: "Unauthorized" };
}

// Admin panel je samo za administratore (student koji je prijavljen ne vidi ništa)
const prijavljen = !userData.error;
const jesteAdmin = prijavljen && userData.role === "ADMIN";
---

<!DOCTYPE html>
<html lang="sr" data-tema="svetla">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem("tema");
        if (t === "svetla" || t === "tamna") document.documentElement.dataset.tema = t;
      } catch (e) {}
    </script>
    <title>{title} — Studio 27 Admin</title>
  </head>
  <body class="bg-neutral-950 min-h-dvh overflow-x-hidden">
    {jesteAdmin ? (
      <div class="flex min-h-dvh md:h-dvh">
        <Sidebar email={userData.email} />
        <main class="flex-1 min-w-0 overflow-y-auto flex flex-col">
          <header class="sticky top-0 z-10 h-12 bg-neutral-950/85 backdrop-blur-md border-b border-neutral-800/60 flex items-center px-5 md:px-6 lg:px-8 shrink-0">
            <div class="w-full max-w-7xl mx-auto flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-xs text-neutral-600">Admin</span>
                <svg class="w-3 h-3 text-neutral-700 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span class="text-sm font-medium text-neutral-300">{title}</span>
              </div>
              <div class="flex items-center gap-2">
                <a
                  href={CLIENT_URL}
                  target="_blank"
                  rel="noopener"
                  class="hidden sm:inline-flex items-center border border-neutral-800 px-3 py-1.5 text-xs font-medium text-neutral-400 hover:text-white hover:bg-neutral-800/70 transition-colors"
                >
                  Sajt ↗
                </a>
                <a
                  href={APP_URL}
                  target="_blank"
                  rel="noopener"
                  class="hidden sm:inline-flex items-center border border-neutral-800 px-3 py-1.5 text-xs font-medium text-neutral-400 hover:text-white hover:bg-neutral-800/70 transition-colors"
                >
                  Aplikacija ↗
                </a>
                <TemaDugme />
              </div>
            </div>
          </header>

          <div class="flex-1 p-5 md:p-6 lg:p-8">
            <div class="max-w-7xl mx-auto">
              <slot />
            </div>
          </div>
        </main>
      </div>
    ) : (
      <div class="flex items-center justify-center min-h-dvh px-4">
        <div class="text-center max-w-md">
          <div class="w-16 h-16 rounded-2xl bg-red-900/15 border border-red-900/20 flex items-center justify-center mx-auto mb-6">
            <svg viewBox="0 0 20 20" fill="currentColor" class="w-8 h-8 text-red-400">
              <path
                fill-rule="evenodd"
                d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Pristup odbijen</h1>
          <p class="text-neutral-400 text-sm mb-6">
            {prijavljen
              ? "Ovaj nalog nema administratorska prava."
              : "Nemate pristup ovoj stranici. Vaša sesija je možda istekla."}
          </p>
          <a
            href={CLIENT_URL}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-900 hover:bg-red-800 text-white text-sm font-medium transition-colors duration-200"
          >
            Prijavi se ponovo
          </a>
        </div>
      </div>
    )}
  </body>
</html>