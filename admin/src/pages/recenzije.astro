---
import Layout from "../layouts/Layout.astro";
import RecenzijePage from "../react components/RecenzijePage";
import type { AstroCookies } from "astro";

const cookies = Astro.cookies as AstroCookies;
const refreshToken = cookies.get("refreshToken");
const token = refreshToken?.value;
---

<Layout title="Recenzije">
  <RecenzijePage token={token ? token : ""} client:load />
</Layout>
