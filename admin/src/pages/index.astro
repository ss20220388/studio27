---
import Layout from "../layouts/Layout.astro";
import Dashboard from "../react components/Dashboard";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

let students = [];
const token = Astro.cookies.get("refreshToken")?.value;

try {
	const sviStudentiRes = await fetch(`${API_URL}/api/students`, {
		method: "GET",
		headers: {
			Authorization: `Bearer ${token}`,
		},
		credentials: "include"
	});
	
	if (!sviStudentiRes.ok) {
		students = [];
	} else {
		students = await sviStudentiRes.json();
	}
} catch (error) {
	students = [];
}
let prihodi = [];
try{
	const prihodiRes = await fetch(`${API_URL}/api/kupljeni-poslednjih-12meseci`, {
	method: "GET",
	headers: {
		Authorization: `Bearer ${token}`,
	},
	credentials: "include"
});
	prihodi = await prihodiRes.json();

}catch(error){
}

let kursProdatoOvajMesec = [];
try{
	const kursProdatoOvajMesecRes = await fetch(`${API_URL}/api/kurs-prodato-ovaj-mesec`, {
	method: "GET",
	headers: {
		Authorization: `Bearer ${token}`,
	},
});
	kursProdatoOvajMesec = await kursProdatoOvajMesecRes.json();
}catch(error){
}

let stats = []

try{
	const statsRes = await fetch(`${API_URL}/api/admin-stats`, {
	method: "GET",
	headers: {
		Authorization: `Bearer ${token}`,
	},
});
	stats = await statsRes.json();
}catch(error){
}

---

<Layout title="Dashboard">
	<Dashboard client:load students={students.students} prihodi={prihodi.data} kursProdato={kursProdatoOvajMesec.data} stats = {stats} />
</Layout>
