---
import { API_URL } from "../lib/adrese";
import Layout from "../layouts/Layout.astro";
import Dashboard from "../react components/Dashboard";

const token = Astro.cookies.get("refreshToken")?.value;
const zaglavlja = token ? { Authorization: `Bearer ${token}` } : {};

// Svaki poziv je zaštićen: ako API vrati grešku, stranica i dalje radi sa praznim podacima
async function ucitaj(putanja: string): Promise<any> {
	try {
		const res = await fetch(`${API_URL}${putanja}`, { headers: zaglavlja });
		if (!res.ok) {
			console.error(`Dashboard: ${putanja} vratio ${res.status}`);
			return null;
		}
		return await res.json();
	} catch (error) {
		console.error(`Dashboard: greška za ${putanja}`, error);
		return null;
	}
}

const [studentiOdg, prihodiOdg, prodatoOdg, statsOdg] = await Promise.all([
	ucitaj("/api/students"),
	ucitaj("/api/kupljeni-poslednjih-12meseci"),
	ucitaj("/api/kurs-prodato-ovaj-mesec"),
	ucitaj("/api/admin-stats"),
]);

const niz = (v: unknown) => (Array.isArray(v) ? v : []);
// Najnoviji korisnici prvi (veći id = kasnije registrovan)
const students = niz(studentiOdg?.students).sort((a: any, b: any) => Number(b.studentId) - Number(a.studentId));
const prihodi = niz(prihodiOdg?.data);
const kursProdato = niz(prodatoOdg?.data);
const stats = statsOdg && !statsOdg.error ? statsOdg : {};
---

<Layout title="Dashboard">
	<Dashboard client:load students={students} prihodi={prihodi} kursProdato={kursProdato} stats={stats} />
</Layout>
