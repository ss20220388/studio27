---
import { API_URL, CLIENT_URL } from "../lib/adrese";
import Layout from "../layouts/Layout.astro";
import SettingsPage from "../react components/SettingsPage";
const token = Astro.cookies.get("refreshToken")?.value || null;
---

<Layout title="Podešavanja">
    <SettingsPage clientUrl={CLIENT_URL} token={token} apiUrl={API_URL} client:load />
</Layout>
