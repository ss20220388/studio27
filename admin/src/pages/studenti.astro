---
import Layout from "../layouts/Layout.astro";
import UsersPage from "../react components/UsersPage";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

// 1. Preuzimanje tokena iz kolačića
const accessToken = Astro.cookies.get("refreshToken")?.value;

const authHeaders: Record<string, string> = accessToken
  ? { Authorization: `Bearer ${accessToken}` }
  : {};

let studentsData = { students: [], count: 0, message: "" };
let kurseviData = { kursevi: [], message: "" };

try {
  const [studentsResponse, kurseviResponse] = await Promise.all([
    fetch(`${API_URL}/api/students`, { headers: authHeaders }),
    fetch(`${API_URL}/api/kursevi`, { headers: authHeaders })
  ]);

  if (studentsResponse.ok) {
    studentsData = await studentsResponse.json();
  } else {
    console.error(`Students API Error: ${studentsResponse.status}`, await studentsResponse.text());
  }

  if (kurseviResponse.ok) {
    kurseviData = await kurseviResponse.json();
  } else {
    console.error(`Kursevi API Error: ${kurseviResponse.status}`, await kurseviResponse.text());
  }
} catch (error) {
  console.error("Greška pri komunikaciji sa API-jem:", error);
}
---

<Layout title="Korisnici">
  <UsersPage 
    students={studentsData.students} 
    token={accessToken || ""} 
    sviKursevi={kurseviData.kursevi} 
    client:load 
  />
</Layout>