---
import Layout from "../layouts/Layout.astro";
import UsersPage from "../react components/UsersPage";
import type { AstroCookies } from "astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

const cookies = Astro.cookies as AstroCookies;
const refreshToken = cookies.get("refreshToken");
const token = refreshToken?.value;
const authHeaders: Record<string, string> = token
  ? {
      Authorization: `Bearer ${token}`,
    }
  : {};

console.log("=== DEBUG INFO ===");
console.log("API_URL:", API_URL);
console.log("Token exists:", !!token);
console.log("Auth headers:", authHeaders);
console.log("==================");

let studentsData = { students: [], count: 0, message: "" };

try {
  const studentsResponse = await fetch(`${API_URL}/api/students`, {
    headers: authHeaders,
  });

  if (!studentsResponse.ok) {
    console.error(`API Error: ${studentsResponse.status} ${studentsResponse.statusText}`);
    const errorText = await studentsResponse.text();
    console.error("Response body:", errorText);
    studentsData = { students: [], count: 0, message: `API Error: ${studentsResponse.status}` };
  } else {
    studentsData = await studentsResponse.json();
  }
} catch (error) {
  console.error("Greška pri učitavanju studenata:", error);
  studentsData = { students: [], count: 0, message: `Error: ${error}` };
}
console.log("Students data fetched from API:");
console.log(studentsData);

let kurseviData = { kursevi: [], message: "" };
try{
  const kurseviResponse = await fetch(`${API_URL}/api/kursevi`, {
    headers: authHeaders,
  });
  
  if (!kurseviResponse.ok) {
    console.error(`Kursevi API Error: ${kurseviResponse.status}`);
    const errorText = await kurseviResponse.text();
    console.error("Kursevi response body:", errorText);
    kurseviData = { kursevi: [], message: `API Error: ${kurseviResponse.status}` };
  } else {
    kurseviData = await kurseviResponse.json();
  }
} catch (error){
    console.error("Greška pri učitavanju kurseva:", error);
    kurseviData = { kursevi: [], message: `Error: ${error}` };
}
console.log("Courses data fetched from API:");
console.log(kurseviData)



---

<Layout title="Korisnici">
  <UsersPage students={studentsData.students} token= {token?token : ""} sviKursevi={kurseviData.kursevi} client:load />
</Layout>