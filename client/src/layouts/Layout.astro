---
import Header2 from "../components/Header2.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import ErrorToastNotifier from "../react-components/ErrorToastNotifier";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string | URL;
  keywords?: string;
  noIndex?: boolean;
  type?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;

  // optional structured data
  breadcrumbs?: Array<{ name: string; url: string }>;
  faq?: Array<{ question: string; answer: string }>;
  course?: {
    name: string;
    description: string;
    url?: string;
    provider?: string;
    educationalLevel?: string;
    inLanguage?: string;
    courseMode?: string;
  };
}

const {
  title,
  description = "Studio 27 – profesionalni kurs 3ds Max i arhitektonske vizualizacije. Naučite 3D modelovanje, renderovanje i archviz od osnova do naprednog nivoa.",
  image = "/images/default-seo-image.png",
  imageAlt = "Studio 27 – 3ds Max i arhitektonska vizualizacija kurs",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin),
  keywords = "3ds Max kurs, 3D Max kurs, 3ds Max kurs online, online 3ds Max kurs, šta je 3ds Max kurs, detalji 3ds Max kursa, trajanje 3ds Max kursa, Autodesk 3ds Max kurs, AutoCAD i 3ds Max kurs, kurs 3D modelovanja, kurs arhitektonske vizualizacije, interior design 3ds Max kurs, 3ds Max kurs za arhitekte, 3ds Max kurs cena, 3ds Max kurs Srbija, 3ds Max kurs Beograd, 3ds Max kurs sa sertifikatom, Corona Render kurs, rendering kurs, archviz kurs, 3D vizualizacija kurs, kurs enterijera 3D, kurs eksterijera 3D",
  noIndex = false,
  type = "website",
  articlePublishedTime,
  articleModifiedTime,
  breadcrumbs = [],
  faq = [],
  course,
} = Astro.props;

const losGmailCookie = Astro.cookies.get("losGmail");

const siteURL = Astro.site ? Astro.site.toString() : Astro.url.origin;
const canonical = new URL(canonicalURL, siteURL).toString();
const fullImageURL = new URL(image, siteURL).toString();

const defaultBreadcrumbs = [
  { name: "Početna", url: siteURL },
  ...breadcrumbs,
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Studio 27",
  url: siteURL,
  logo: new URL("/images/logo.png", siteURL).toString(),
  image: fullImageURL,
  description,
  address: {
    "@type": "PostalAddress",
    addressCountry: "RS",
  },
  sameAs: [],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Studio 27",
  url: siteURL,
  inLanguage: "sr-RS",
  description,
};

const breadcrumbSchema =
  defaultBreadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: defaultBreadcrumbs.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: item.url,
        })),
      }
    : null;

const faqSchema =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : null;

const courseSchema = course
  ? {
      "@context": "https://schema.org",
      "@type": "Course",
      name: course.name,
      description: course.description,
      url: course.url || canonical,
      provider: {
        "@type": "Organization",
        name: course.provider || "Studio 27",
      },
      educationalLevel: course.educationalLevel || "beginner to advanced",
      inLanguage: course.inLanguage || "sr",
      courseMode: course.courseMode || "online",
    }
  : null;
---

<!doctype html>
<html lang="sr-Latn" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Studio 27" />
    <meta name="language" content="Serbian" />
    <meta
      name="robots"
      content={
        noIndex
          ? "noindex, nofollow"
          : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      }
    />
    <meta name="googlebot" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="msapplication-TileColor" content="#1a1a1a" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Studio 27" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@studio27archviz" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    ></script>

    {breadcrumbSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
      ></script>
    )}

    {faqSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      ></script>
    )}

    {courseSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(courseSchema)}
      ></script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link
        rel="preload"
        as="image"
        href={`${API_URL}/api/uploaded-images/towebp/naslovna2.webp`}
        fetchpriority="high"
    />
  </head>

  <body class="relative">
    <div class="fixed top-0 left-0 w-full z-50">
      <Header2 />
    </div>

    <div class="pt-[70px] w-screen overflow-hidden">
      <slot />
      <Footer />
    </div>

    <ErrorToastNotifier losGmailCookie={losGmailCookie} client:load />
  </body>
</html>