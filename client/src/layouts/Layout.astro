---
import { API_URL } from "../data/sajt";
import Zaglavlje from "../components/novo/Zaglavlje.astro";
import Footer from "../components/Footer.astro";
import ErrorToastNotifier from "../react-components/ErrorToastNotifier";
import CartModal from "../react-components/CartModal";
import LoginSectionForm from "../react-components/LoginSectionForm.tsx";
import KontakModal from "../react-components/KontakModal.tsx";
import "../styles/global.css";

const accessToken = Astro.cookies.get("refreshToken")?.value;

// Server odmah prepoznaje ulogovanog korisnika (dugme "Moja aplikacija" u zaglavlju)
let korisnik: Record<string, unknown> | null = null;
if (accessToken) {
  try {
    const res = await fetch(`${API_URL}/api/auth/me`, {
      headers: { Authorization: `Bearer ${accessToken}` },
    });
    if (res.ok) {
      const podaci = await res.json();
      if (podaci && !podaci.error) korisnik = podaci;
    }
  } catch {
    korisnik = null;
  }
}
(Astro.locals as any).korisnik = korisnik;
const imaZaglavlje = Astro.slots.has("zaglavlje");

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string | URL;
  keywords?: string;
  noIndex?: boolean;
  type?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;

  // Novi dizajn: stranica bez zaglavlja/podnožja (mini kviz) i boja pozadine
  bezZaglavlja?: boolean;
  bezPodnozja?: boolean;
  pozadina?: string;

  // Strukturirani podaci (Schema.org)
  breadcrumbs?: Array<{ name: string; url: string }>;
  faq?: Array<{ question: string; answer: string }>;
  course?: {
    name: string;
    description: string;
    url?: string;
    image?: string;
    provider?: string;
    educationalLevel?: string;
    inLanguage?: string;
    courseMode?: string;
    // cena u evrima (Google prikazuje cenu kursa u rezultatima)
    cena?: number;
  };
  // Dodatni JSON-LD objekti koje stranica sama sastavlja (npr. detaljan Course sa recenzijama)
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = "Studio 27 – škola arhitektonske vizualizacije. Kursevi 3ds Max + Corona, vizualizacije eksterijera, dizajna enterijera i AI prezentacije, online i uživo.",
  image = "/images/og-main.webp",
  imageAlt = "Studio 27 – kursevi 3ds Max i arhitektonske vizualizacije",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin),
  keywords = "3ds Max kurs, 3D modelovanje, Corona Render obuka, arhitektonska vizualizacija, archviz kurs Srbija",
  noIndex = false,
  type = "website",
  articlePublishedTime,
  articleModifiedTime,
  breadcrumbs = [],
  faq = [],
  course,
  schema = [],
  bezZaglavlja = false,
  bezPodnozja = false,
  pozadina = "#ffffff",
} = Astro.props;

// Kolačići i URL priprema
const losGmailCookie = Astro.cookies.get("losGmail");
const siteURL = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : Astro.url.origin;
const canonical = new URL(canonicalURL, siteURL).toString();

// Pravilno spajanje slika (bilo da je pun URL ili relativna putanja)
let fullImageURL = image;
if (!image.startsWith("http://") && !image.startsWith("https://")) {
  const cleanImagePath = image.startsWith("/") ? image : `/${image}`;
  fullImageURL = new URL(cleanImagePath, siteURL).toString();
}

const defaultBreadcrumbs = [{ name: "Početna", url: siteURL }, ...breadcrumbs];

const OPIS_ORGANIZACIJE =
  "Studio 27 – škola arhitektonske vizualizacije i dizajna enterijera. Kursevi 3ds Max + Corona, vizualizacije eksterijera, dizajna enterijera i AI prezentacije, online i uživo.";
// Dimenzije su poznate samo za podrazumevanu sliku za deljenje
const podrazumevanaSlika = image === "/images/og-main.webp";

// --- GENERISANJE SCHEMA.ORG JSON-LD PODATAKA ---

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Studio 27 – 27 archviz",
  url: siteURL,
  logo: new URL("/icon-512.png", siteURL).toString(),
  image: fullImageURL,
  description: OPIS_ORGANIZACIJE,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Novi Beograd",
    addressCountry: "RS",
  },
  sameAs: ["https://www.instagram.com/studio27.visualization/"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Studio 27 – 27 archviz",
  url: siteURL,
  inLanguage: "sr-RS",
  description: OPIS_ORGANIZACIJE,
};

const breadcrumbSchema =
  defaultBreadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: defaultBreadcrumbs.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: item.url,
        })),
      }
    : null;

const faqSchema =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : null;

const courseSchema = course
  ? {
      "@context": "https://schema.org",
      "@type": "Course",
      name: course.name,
      description: course.description,
      url: course.url || canonical,
      image: course.image || fullImageURL,
      provider: {
        "@type": "Organization",
        name: course.provider || "Studio 27 – 27 archviz",
        sameAs: siteURL,
      },
      educationalLevel: course.educationalLevel || "beginner to advanced",
      inLanguage: course.inLanguage || "sr",
      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: course.courseMode || "online",
        courseWorkload: "PT20H",
      },
      ...(course.cena
        ? {
            offers: {
              "@type": "Offer",
              price: course.cena,
              priceCurrency: "EUR",
              category: "Paid",
              availability: "https://schema.org/InStock",
              url: course.url || canonical,
            },
          }
        : {}),
    }
  : null;

const robotsContent = noIndex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang="sr-Latn" prefix="og: https://ogp.me/ns#">
  <head>
    <!-- Preconnect i DNS Prefetch -->
    <link rel="preconnect" href={API_URL} />
    <link rel="dns-prefetch" href={API_URL} />

    <script
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="971qb8FEOy/jmMtsImFp1A"
      async></script>

    <!-- Tehnički meta tagovi -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primarni SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Studio 27" />
    <meta name="language" content="Serbian" />
    <meta name="robots" content={robotsContent} />
    <meta
      name="googlebot"
      content={noIndex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />

    <!-- Ikone i Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Studio 27 – 27 archviz" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    {podrazumevanaSlika && <meta property="og:image:width" content="1200" />}
    {podrazumevanaSlika && <meta property="og:image:height" content="630" />}

    {
      articlePublishedTime && (
        <meta
          property="article:published_time"
          content={articlePublishedTime}
        />
      )
    }
    {
      articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- JSON-LD Podaci -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    {
      breadcrumbSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      )
    }
    {
      faqSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(faqSchema)}
        />
      )
    }
    {
      courseSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(courseSchema)}
        />
      )
    }

    {schema.map((objekat) => <script type="application/ld+json" set:html={JSON.stringify(objekat)} />)}

    <!-- Dinamički Preload za primarnu sliku (Poboljšava LCP) -->
    <link rel="preload" as="image" href={fullImageURL} fetchpriority="high" />

    <!-- Google Fonts optimizovano učitavanje -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Poppins:wght@500;600;700;800;900&display=swap"
    />

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-18393028886"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "AW-18393028886");
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1807633947079648');
      fbq('track', 'PageView');
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1807633947079648&ev=PageView&noscript=1"
      /></noscript
    >
    <!-- End Meta Pixel Code -->
  </head>

  <body class="relative text-neutral-900" style={`background:${pozadina}`}>
    <ErrorToastNotifier losGmailCookie={losGmailCookie} client:load />

    <CartModal accessToken={accessToken} client:load />
    <LoginSectionForm publicApiUrl={API_URL} client:load />
    <KontakModal bezDugmeta client:idle />

    <div class="w-full overflow-x-clip">
      {!bezZaglavlja && (imaZaglavlje ? <slot name="zaglavlje" /> : <Zaglavlje />)}
      <slot />
      {!bezPodnozja && <Footer />}
    </div>

    <script>
      // Elementi sa klasom .pojava se pojavljuju kada uđu u ekran
      const posmatrac = new IntersectionObserver(
        (unosi) => {
          for (const u of unosi) {
            if (u.isIntersecting) {
              u.target.classList.add("vidljivo");
              posmatrac.unobserve(u.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );
      document.querySelectorAll(".pojava").forEach((el) => posmatrac.observe(el));

      // Zajednička dugmad novog dizajna (bez React-a, radi na svim stranicama)
      document.addEventListener("click", (e) => {
        const cilj = e.target as HTMLElement | null;
        if (!cilj) return;

        // "Kupi kurs" -> dodaj u korpu i otvori CartModal (isti tok plaćanja kao ranije)
        const kupi = cilj.closest<HTMLElement>("[data-kupi-kurs]");
        if (kupi) {
          e.preventDefault();
          try {
            const kurs = JSON.parse(kupi.dataset.kupiKurs || "{}");
            let korpa: any[] = [];
            try {
              korpa = JSON.parse(localStorage.getItem("cart_items") || "[]");
            } catch {
              korpa = [];
            }
            if (!korpa.some((s) => s.id === kurs.id)) {
              korpa.push({ ...kurs, quantity: 1 });
            }
            localStorage.setItem("cart_items", JSON.stringify(korpa));
            window.dispatchEvent(new CustomEvent("cart-updated", { detail: korpa }));
          } catch (err) {
            console.error("Greška pri dodavanju u korpu:", err);
          }
          return;
        }

        if (cilj.closest("[data-otvori-kontakt]")) {
          e.preventDefault();
          window.dispatchEvent(new Event("openKontaktModal"));
          return;
        }

        if (cilj.closest("[data-otvori-login]")) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent("open-login"));
          return;
        }

        const meniDugme = cilj.closest("[data-meni-dugme]");
        const meni = document.getElementById("s27-nav-mobilni");
        if (meniDugme && meni) {
          meni.classList.toggle("hidden");
          return;
        }
        if (meni && !meni.contains(cilj)) meni.classList.add("hidden");
      });
    </script>
  </body>
</html>
