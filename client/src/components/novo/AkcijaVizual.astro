---
// Akcija na početnoj (admin -> Kursevi -> Akcija na početnoj), npr. Black Friday za ceo sajt.
// Nije vezana za jedan kurs: ima svoj naslov, tekst, boju akcenta, sliku, rok i dugme.
// Izgled prati sajt (topla tamna pozadina, serif naslovi, tanke linije); boja iz admina je samo akcenat.
// - "velika": sekcija ispod naslovnog ekrana, sa odbrojavanjem i kursevima na popustu
// - "traka": uska traka iznad menija
import Ikona from "./Ikona.astro";
import Odbrojavanje from "./Odbrojavanje.astro";
import {
  bojaPopusta,
  cenaKursa,
  kursPutanja,
  lepNaziv,
  manjaSlika,
  popustKursa,
  procenatPopusta,
  slikaIzBaze,
  srcsetSlike,
  type Akcija,
  type KursIzBaze,
} from "../../data/sajt";

interface Props {
  akcija: Akcija;
  varijanta?: "velika" | "traka";
  kursevi?: KursIzBaze[];
}

const { akcija, varijanta = "velika", kursevi = [] } = Astro.props;
const boja = bojaPopusta(akcija);
const oznaka = akcija.oznaka || "Akcija";
const link = akcija.link || "/#edukacije";
const dugme = akcija.dugme || "Pogledaj kurseve";
const naPopustu = kursevi.filter((k) => popustKursa(k));
// pozadina: slika akcije, a bez nje glavna slika prvog kursa na popustu
const slika = akcija.slika ? slikaIzBaze(akcija.slika) : slikaIzBaze(naPopustu[0]?.slikaUrl);
const najveci = Math.max(0, ...naPopustu.map((k) => procenatPopusta(popustKursa(k)!)));
---

{
  varijanta === "traka" && (
    <a
      href={link}
      data-popust-traka
      data-do={akcija.doMs ?? ""}
      class="group relative block border-b border-white/10 bg-[#140f0c] text-white"
      style={`--popust:${boja}`}
    >
      <div class="max-w-[1400px] mx-auto px-5 md:px-10 py-2.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-[12.5px]">
        <span class="text-[10.5px] font-semibold uppercase tracking-[0.28em]" style="color:var(--popust)">{oznaka}</span>
        <span class="text-white/30" aria-hidden="true">·</span>
        <span class="text-white/90">{akcija.naslov}</span>
        {akcija.doMs && (
          <Fragment>
            <span class="hidden sm:inline text-white/30" aria-hidden="true">·</span>
            <span class="text-white/55">
              još <span data-odbrojavanje class="tabular-nums text-white" />
            </span>
          </Fragment>
        )}
        <Ikona ime="strelica" class="hidden sm:block w-3.5 h-3.5 text-white/60 transition-transform group-hover:translate-x-0.5" />
      </div>
    </a>
  )
}

{
  varijanta === "velika" && (
    <section
      data-popust-traka
      data-do={akcija.doMs ?? ""}
      class="relative overflow-hidden bg-[#140f0c] text-white"
      style={`--popust:${boja}`}
      aria-labelledby="akcija-naslov"
    >
      {slika && (
        <Fragment>
          <img
            src={manjaSlika(slika, 1600)}
            srcset={srcsetSlike(slika)}
            sizes="(min-width: 1024px) 60vw, 100vw"
            alt=""
            loading="lazy"
            class="absolute inset-y-0 right-0 h-full w-full lg:w-[62%] object-cover opacity-50"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-[#140f0c] via-[#140f0c]/90 lg:via-[#140f0c]/75 to-[#140f0c]/30" aria-hidden="true" />
        </Fragment>
      )}
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#140f0c] to-transparent" aria-hidden="true" />
      {/* veliki procenat u pozadini, kao vodeni žig */}
      {najveci > 0 && (
        <p
          class="pointer-events-none absolute -bottom-10 right-0 md:right-6 select-none font-serif leading-none tracking-[-0.05em] text-white/[0.05] text-[180px] md:text-[300px]"
          aria-hidden="true"
        >
          -{najveci}%
        </p>
      )}

      <div class="relative max-w-[1300px] mx-auto px-5 md:px-10 py-20 md:py-28 grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div class="pojava">
          <p class="flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.3em]" style="color:var(--popust)">
            <span class="h-px w-10" style="background:var(--popust)" />
            {oznaka}
          </p>
          <h2 id="akcija-naslov" class="mt-7 max-w-[620px] font-serif text-[42px] md:text-[68px] leading-[1] tracking-[-0.03em] text-balance">
            {akcija.naslov}
          </h2>
          {akcija.tekst && <p class="mt-6 max-w-[480px] text-[15px] md:text-[16px] leading-relaxed text-white/70">{akcija.tekst}</p>}

          {akcija.doMs && <Odbrojavanje naslov="Akcija ističe za" class="mt-10" />}

          <a
            href={link}
            class="group mt-10 inline-flex items-center gap-3 bg-white px-7 py-4 text-[13px] font-semibold text-neutral-900 hover:bg-[#f4f2ee] transition-colors"
          >
            {dugme}
            <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>

        {naPopustu.length > 0 && (
          <div class="pojava" style="--kasnjenje:0.15s">
            <p class="text-[10.5px] font-medium uppercase tracking-[0.26em] text-white/50">Kursevi na popustu</p>
            <ul class="mt-4 border-t border-white/15">
              {naPopustu.map((k) => {
                const p = popustKursa(k)!;
                return (
                  <li class="border-b border-white/15">
                    <a href={kursPutanja(k)} class="group grid grid-cols-[72px_1fr_auto] items-center gap-5 py-5">
                      {k.slikaUrl ? (
                        <img
                          src={manjaSlika(slikaIzBaze(k.slikaUrl), 480)}
                          alt=""
                          loading="lazy"
                          class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                        />
                      ) : (
                        <span />
                      )}
                      <span class="min-w-0">
                        <span class="block font-serif text-[21px] md:text-[23px] leading-tight tracking-[-0.01em]">{lepNaziv(k.naziv)}</span>
                        <span class="mt-2 flex items-baseline gap-3 text-[14px]">
                          <s class="text-white/40">{k.cena} €</s>
                          <span class="font-serif text-[20px]" style="color:var(--popust)">{cenaKursa(k)} €</span>
                        </span>
                      </span>
                      <span
                        class="flex h-14 w-14 items-center justify-center rounded-full border text-[13px] font-semibold transition-colors group-hover:bg-white/10"
                        style="border-color:var(--popust);color:var(--popust)"
                      >
                        -{procenatPopusta(p)}%
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  import "../../scripts/odbrojavanje";
</script>
