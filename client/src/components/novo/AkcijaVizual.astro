---
// Akcija na početnoj (admin -> Kursevi -> Akcija na početnoj), npr. Black Friday za ceo sajt.
// Izgled po vizualu klijentkinje: topla tamna pozadina, "STUDIO 27", veliki naslov (BLACK FRIDAY),
// oznaka u boji akcenta (AKCIJA), cenovnik kurseva i paketa na popustu (stara precrtana / nova),
// fotografija enterijera, odbrojavanje i dugme. Nije vezana za jedan kurs.
// - "velika": sekcija ispod naslovnog ekrana
// - "traka": uska traka iznad menija
import Ikona from "./Ikona.astro";
import Odbrojavanje from "./Odbrojavanje.astro";
import {
  bojaPopusta,
  cenaKursa,
  cenaPaketa,
  kursPutanja,
  lepNaziv,
  manjaSlika,
  popustKursa,
  slikaIzBaze,
  srcsetSlike,
  type Akcija,
  type KursIzBaze,
  type PaketKursa,
} from "../../data/sajt";

interface Props {
  akcija: Akcija;
  varijanta?: "velika" | "traka";
  kursevi?: KursIzBaze[];
  // paketi kurseva na popustu (kursId -> paketi), za cenovnik
  paketi?: Record<number, PaketKursa[]>;
  // rad polaznika (putanja iz baze) kad akcija nema svoju sliku
  slikaRada?: string;
}

const { akcija, varijanta = "velika", kursevi = [], paketi = {}, slikaRada = "" } = Astro.props;
const boja = bojaPopusta(akcija);
const oznaka = akcija.oznaka || "Akcija";
const link = akcija.link || "/#edukacije";
// period akcije: "27.11. – 30.11."
const dan = (v?: string | null) => {
  const m = v?.match(/^(\d{4})-(\d{2})-(\d{2})/);
  return m ? `${+m[3]}.${+m[2]}.` : "";
};
const period = akcija.od && akcija.do ? `${dan(akcija.od)} – ${dan(akcija.do)}` : "";
const najnizaCena = (() => { const c = kursevi.filter((k) => popustKursa(k)).map((k) => cenaKursa(k)).filter((c) => c > 0); return c.length ? Math.min(...c) : 0; })();
const dugme = akcija.dugme || "Pogledaj kurseve";
const naPopustu = kursevi.filter((k) => popustKursa(k));
// fotografija: slika akcije iz admina, pa rad polaznika, pa glavna slika prvog kursa na popustu
const slika = slikaIzBaze(akcija.slika || slikaRada || naPopustu[0]?.slikaUrl);

// cenovnik: kurs sa paketima na popustu ima red za svaki takav paket, ostali jedan red
const cenovnik = naPopustu.map((k) => {
  const paketiNaPopustu = (paketi[k.id] || []).filter((p) => p.cenaSaPopustom != null);
  return {
    naziv: lepNaziv(k.naziv).replace(/^Kurs\s*[–-]\s*/i, ""),
    url: kursPutanja(k),
    redovi: paketiNaPopustu.length
      ? paketiNaPopustu.map((p) => ({ naziv: p.naziv, stara: p.cena, nova: cenaPaketa(p) }))
      : [{ naziv: "", stara: k.cena ?? 0, nova: cenaKursa(k) }],
  };
});
---

{
  varijanta === "traka" && (
    <a
      href={link}
      data-popust-traka
      data-do={akcija.doMs ?? ""}
      class="group relative block overflow-hidden border-b border-white/10 bg-[#140f0c] text-white"
      style={`--popust:${boja}`}
      aria-label={`${akcija.naslov}${period ? ", " + period : ""}`}
    >
      {slika && (
        <Fragment>
          <img src={manjaSlika(slika, 800)} alt="" class="absolute inset-y-0 right-0 h-full w-2/3 sm:w-1/2 object-cover opacity-70" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#140f0c] via-[#140f0c]/90 to-[#140f0c]/20" aria-hidden="true" />
        </Fragment>
      )}
      <div class="relative max-w-[1400px] mx-auto px-5 md:px-10 py-3 flex flex-wrap items-center justify-center md:justify-start gap-x-4 gap-y-1.5 text-center">
        <span class="px-2 py-0.5 text-[10.5px] font-bold uppercase tracking-[0.2em] text-white" style="background:var(--popust)">{oznaka}</span>
        <span class="text-[15px] md:text-[17px] font-extrabold uppercase tracking-[0.1em]">{akcija.naslov}</span>
        {period && <span class="text-[13px] md:text-[14px] font-medium tabular-nums text-white/85">{period}</span>}
        {najnizaCena > 0 && (
          <span class="hidden sm:inline text-[13px] text-white/60">
            <span class="mr-3 text-white/25" aria-hidden="true">|</span>kursevi od <b class="text-white font-semibold">{najnizaCena} €</b>
          </span>
        )}
        {akcija.doMs && (
          <span class="hidden md:inline text-[13px] text-white/55">
            <span class="mr-3 text-white/25" aria-hidden="true">|</span>još <span data-odbrojavanje class="tabular-nums text-white" />
          </span>
        )}
        <Ikona ime="strelica" class="hidden md:block w-3.5 h-3.5 text-white/60 transition-transform group-hover:translate-x-0.5" />
      </div>
    </a>
  )
}

{
  varijanta === "velika" && (
    <section
      data-popust-traka
      data-do={akcija.doMs ?? ""}
      class="relative flex flex-col lg:block overflow-hidden bg-[#1d1814] text-[#f3ece0]"
      style={`--popust:${boja}`}
      aria-labelledby="akcija-naslov"
    >
      {/* fotografija: desno na računaru, dole na telefonu (kao na vizualu) */}
      {slika && (
        <div class="relative order-last lg:absolute lg:inset-y-0 lg:right-0 lg:w-[46%] aspect-[4/3] lg:aspect-auto">
          <img
            src={manjaSlika(slika, 1600)}
            srcset={srcsetSlike(slika)}
            sizes="(min-width: 1024px) 46vw, 100vw"
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-b lg:bg-gradient-to-r from-[#1d1814] via-[#1d1814]/30 to-transparent" aria-hidden="true" />
        </div>
      )}

      <div class="relative max-w-[1300px] mx-auto px-5 md:px-10 pt-16 pb-12 md:pt-24 md:pb-24">
        <div class="pojava max-w-[620px] lg:max-w-[600px]">
          <p class="text-[13px] font-semibold uppercase tracking-[0.34em] text-[#f3ece0]/85">Studio 27</p>
          <h2
            id="akcija-naslov"
            class="mt-4 font-poppins font-extrabold uppercase leading-[0.88] tracking-[-0.035em] text-[60px] sm:text-[84px] md:text-[104px] text-balance"
          >
            {akcija.naslov}
          </h2>
          <p class="mt-4 inline-block px-4 py-1 font-poppins text-[22px] md:text-[28px] font-bold uppercase tracking-[0.04em] text-white" style="background:var(--popust)">
            {oznaka}
          </p>
          {akcija.tekst && <p class="mt-6 max-w-[480px] text-[15px] leading-relaxed text-[#f3ece0]/70">{akcija.tekst}</p>}

          {cenovnik.length > 0 && (
            <ul class="mt-9">
              {cenovnik.map((k, i) => (
                <li class:list={["py-5", i > 0 && "border-t border-[#f3ece0]/35"]}>
                  <a href={k.url} class="group block">
                    {k.redovi.length === 1 && !k.redovi[0].naziv ? (
                      <span class="flex items-baseline justify-between gap-4">
                        <span class="font-poppins text-[21px] md:text-[25px] font-semibold leading-tight group-hover:underline underline-offset-4 decoration-1">
                          {k.naziv}
                        </span>
                        <span class="shrink-0 flex items-baseline gap-3">
                          <s class="font-poppins text-[15px] md:text-[17px] text-[#f3ece0]/50">{k.redovi[0].stara} €</s>
                          <span class="font-poppins text-[24px] md:text-[30px] font-bold">{k.redovi[0].nova} €</span>
                        </span>
                      </span>
                    ) : (
                      <Fragment>
                        <span class="block font-poppins text-[21px] md:text-[25px] font-semibold leading-tight group-hover:underline underline-offset-4 decoration-1">
                          {k.naziv}
                        </span>
                        {k.redovi.map((r) => (
                          <span class="mt-2 flex items-baseline justify-between gap-4 pl-1">
                            <span class="font-poppins text-[16px] md:text-[18px] text-[#f3ece0]/85">{r.naziv}</span>
                            <span class="shrink-0 flex items-baseline gap-3">
                              <s class="font-poppins text-[15px] md:text-[17px] text-[#f3ece0]/50">{r.stara} €</s>
                              <span class="font-poppins text-[24px] md:text-[30px] font-bold">{r.nova} €</span>
                            </span>
                          </span>
                        ))}
                      </Fragment>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )}

          <div class="mt-8 flex flex-wrap items-end gap-x-8 gap-y-6">
            {akcija.doMs && <Odbrojavanje naslov="Akcija ističe za" velicina="mala" />}
            <a
              href={link}
              class="group inline-flex items-center gap-3 bg-[#f3ece0] px-7 py-4 text-[13px] font-semibold text-neutral-900 hover:bg-white transition-colors"
            >
              {dugme}
              <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import "../../scripts/odbrojavanje";
</script>
