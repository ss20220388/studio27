---
// Glasovne recenzije polaznika (admin -> Recenzije -> snimak): kartice sa fotografijom, talasom i
// trajanjem; klik pušta snimak, a talas se boji kako snimak napreduje. Istovremeno svira samo jedan.
import { manjaSlika, potpisRecenzije, slikaIzBaze, type PotpisRecenzije } from "../../data/sajt";

export type GlasovnaRecenzija = PotpisRecenzije & {
  id?: number;
  audioUrl?: string | null;
  trajanje?: number | null;
  talas?: string | null;
  slikaUrl?: string | null;
};

interface Props {
  recenzije: GlasovnaRecenzija[];
  naslov?: string;
  pozadina?: string;
}
const { recenzije, naslov = "Poslušajte utiske naših polaznika", pozadina = "bg-white" } = Astro.props;

const glasovne = recenzije.filter((r) => r.audioUrl);
const BROJ_STUBICA = 40;

// sačuvan talas iz admina ili ujednačen "podrazumevani" talas
function stubici(r: GlasovnaRecenzija, i: number) {
  const sacuvan = (r.talas || "").split(",").map(Number).filter((n) => Number.isFinite(n));
  if (sacuvan.length >= 10) return sacuvan.map((n) => 20 + n * 9);
  return Array.from({ length: BROJ_STUBICA }, (_, k) => 25 + Math.round(Math.abs(Math.sin((k + 1) * 1.7 + i * 2.3)) * 70));
}
const vreme = (s?: number | null) => (s ? `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}` : "");
const inicijal = (tekst: string) => (tekst.replace(/[^\p{L}]/gu, "").charAt(0) || "S").toUpperCase();
---

{
  glasovne.length > 0 && (
    <section class={`${pozadina} border-t border-neutral-100`} aria-labelledby="glasovne-recenzije" data-glasovne>
      <div class="max-w-[1300px] mx-auto px-5 md:px-10 py-16 md:py-20 grid lg:grid-cols-[0.75fr_2.25fr] gap-10 items-center">
        <div class="pojava">
          <h2 id="glasovne-recenzije" class="font-serif text-[34px] md:text-[42px] leading-[1.05] tracking-[-0.02em]">{naslov}</h2>
          <p class="mt-4 text-[14px] leading-relaxed text-neutral-600">
            Evo šta kažu polaznici koji su već prošli kroz kurs. Njihova iskustva najbolje govore šta možeš da očekuješ.
          </p>
        </div>

        <ul class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 -mx-5 px-5 lg:mx-0 lg:px-0 lg:grid lg:grid-cols-3 lg:overflow-visible [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {glasovne.map((r, i) => {
            const potpis = potpisRecenzije(r);
            const ime = potpis.ime || (potpis.instagram ? `@${potpis.instagram}` : "Polaznik");
            return (
              <li class="pojava snap-start shrink-0 w-[85%] sm:w-[330px] lg:w-auto" style={`--kasnjenje:${Math.min(i, 3) * 0.06}s`}>
                <button
                  type="button"
                  data-glas={slikaIzBaze(r.audioUrl)}
                  aria-label={`Pusti glasovnu recenziju: ${ime}`}
                  class="group cursor-pointer w-full flex items-center gap-4 border border-neutral-200 bg-white px-4 py-4 text-left hover:border-neutral-400 transition-colors"
                >
                  <span class="s27-krug relative shrink-0 grid place-items-center w-14 h-14 overflow-hidden rounded-full bg-neutral-200">
                    {r.slikaUrl ? (
                      <img src={manjaSlika(slikaIzBaze(r.slikaUrl), 480)} alt="" loading="lazy" class="s27-krug h-full w-full object-cover" />
                    ) : (
                      <span class="font-serif text-[22px] text-neutral-700">{inicijal(ime)}</span>
                    )}
                    <span class="s27-krug absolute inset-0 grid place-items-center bg-black/35 text-white opacity-0 group-hover:opacity-100 group-[.svira]:opacity-100 transition-opacity">
                      <svg data-ikona-play viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M8 5v14l11-7z" /></svg>
                      <svg data-ikona-pauza viewBox="0 0 24 24" class="hidden w-5 h-5 fill-current"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
                    </span>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="flex h-10 items-center gap-[2px]" aria-hidden="true" data-talas>
                      {stubici(r, i).map((v) => (
                        <span class="flex-1 min-w-[2px] max-w-[4px] bg-neutral-300 transition-colors" style={`height:${v}%`} />
                      ))}
                    </span>
                    <span class="mt-1 block text-[11px] text-neutral-500 truncate">{ime}</span>
                  </span>
                  {r.trajanje ? <span class="shrink-0 text-[13px] font-medium text-neutral-800" data-vreme>{vreme(r.trajanje)}</span> : null}
                </button>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<script>
  // Jedan zajednički audio: klik pušta/pauzira snimak kartice, talas se boji po napretku
  let audio: HTMLAudioElement | null = null;
  let aktivno: HTMLElement | null = null;

  function oboji(dugme: HTMLElement, udeo: number) {
    const stubici = dugme.querySelectorAll<HTMLElement>("[data-talas] > span");
    const do_ = Math.round(udeo * stubici.length);
    stubici.forEach((s, i) => s.classList.toggle("!bg-neutral-900", i < do_));
  }

  function stanje(dugme: HTMLElement, svira: boolean) {
    dugme.classList.toggle("svira", svira);
    dugme.querySelector("[data-ikona-play]")?.classList.toggle("hidden", svira);
    dugme.querySelector("[data-ikona-pauza]")?.classList.toggle("hidden", !svira);
  }

  document.querySelectorAll<HTMLElement>("[data-glasovne] [data-glas]").forEach((dugme) => {
    dugme.addEventListener("click", () => {
      if (aktivno === dugme && audio) {
        if (audio.paused) audio.play();
        else audio.pause();
        return;
      }
      if (audio && aktivno) {
        audio.pause();
        stanje(aktivno, false);
        oboji(aktivno, 0);
      }
      audio = new Audio(dugme.dataset.glas);
      aktivno = dugme;
      const ovo = dugme;
      audio.addEventListener("play", () => stanje(ovo, true));
      audio.addEventListener("pause", () => stanje(ovo, false));
      audio.addEventListener("timeupdate", () => {
        if (audio && audio.duration) oboji(ovo, audio.currentTime / audio.duration);
      });
      audio.addEventListener("ended", () => {
        stanje(ovo, false);
        oboji(ovo, 0);
      });
      audio.play().catch(() => stanje(ovo, false));
    });
  });
</script>
