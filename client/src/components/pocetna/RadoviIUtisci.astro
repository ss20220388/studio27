---
// Radovi studenata (mreža 5×3 iz baze, po rasporedu iz admin aplikacije) i utisci polaznika (kartice)
import Ikona from "../novo/Ikona.astro";
import { lepNaziv, manjaSlika, potpisRecenzije, slikaIzBaze, srcsetSlike, ucitajListu } from "../../data/sajt";

type Rad = { idRad: number; url: string; naziv?: string; ime?: string; prezime?: string };
type Recenzija = {
  opis: string;
  ocena: number;
  ime?: string | null;
  instagram?: string | null;
  student?: { ime?: string; prezime?: string } | null;
  kurs: { naziv?: string } | null;
};

const [radovi, sveRecenzije] = await Promise.all([
  ucitajListu<Rad>("/api/radovi-sa-rasporedom"),
  ucitajListu<Recenzija>("/api/recenzije"),
]);

const slike = radovi
  .filter((r) => r.url)
  .slice(0, 15)
  .map((r) => {
    const autor = [r.ime, r.prezime].map((x) => (x || "").trim()).filter(Boolean).join(" ");
    const kurs = lepNaziv(r.naziv) || "kursa 3D vizualizacije";
    return { src: slikaIzBaze(r.url), alt: `Render polaznika${autor ? ` ${autor}` : ""} – ${kurs}, Studio 27` };
  });
// najnovijih šest (sve su na stranicama kurseva)
const recenzije = sveRecenzije.filter((r) => r.opis && r.opis.trim()).reverse().slice(0, 6);
---

<!-- RADOVI STUDENATA -->
<section id="radovi" class="bg-white pt-8 md:pt-12 pb-20 md:pb-28 scroll-mt-16">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 text-center pojava">
    <p class="text-[11px] font-medium uppercase tracking-[0.26em] text-neutral-500">Portfolio polaznika</p>
    <h2 class="mt-4 font-serif text-[40px] md:text-[60px] leading-[1.02] tracking-[-0.02em]">Radovi studenata</h2>
    <p class="mt-4 mx-auto max-w-[540px] text-[15px] leading-relaxed text-neutral-600">
      Renderi enterijera i eksterijera koje su polaznici napravili tokom kursa 3ds Max + Corona.
    </p>
  </div>

  {
    slike.length > 0 && (
      <div class="mt-10 md:mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-1 md:gap-1.5">
        {slike.map((s, i) => (
          <a
            href="/radovi"
            class:list={["group relative block overflow-hidden bg-neutral-100", i >= 14 ? "hidden lg:block" : i >= 12 ? "hidden sm:block" : ""]}
          >
            <img
              src={manjaSlika(s.src, 480)}
              srcset={srcsetSlike(s.src, 1200)}
              sizes="(min-width: 1400px) 280px, (min-width: 1024px) 20vw, (min-width: 640px) 33vw, 50vw"
              alt={s.alt}
              loading="lazy"
              decoding="async"
              class="w-full aspect-[3/4] object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.06]"
            />
            <span class="absolute inset-0 bg-black/0 transition-colors duration-500 group-hover:bg-black/15" />
          </a>
        ))}
      </div>
    )
  }

  <div class="mt-10 text-center">
    <a href="/radovi" class="group inline-flex items-center gap-2 border-b border-neutral-900 pb-1 text-[13px] font-medium">
      Pogledaj sve radove
      <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</section>

<!-- UTISCI POLAZNIKA -->
{
  recenzije.length > 0 && (
    <section id="recenzije" class="bg-bez py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-5 md:px-10">
        <div class="pojava text-center">
          <p class="text-[11px] font-medium uppercase tracking-[0.26em] text-neutral-500">Iskustva</p>
          <h2 class="mt-4 font-serif text-[40px] md:text-[56px] leading-[1.03] tracking-[-0.02em]">Utisci polaznika</h2>
          <p class="mt-4 text-[15px] text-neutral-600">Iskustva studenata koji su završili naše kurseve.</p>
        </div>

        <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
          {recenzije.map((r, i) => (
            <figure
              class="pojava flex flex-col justify-between bg-white p-7 md:p-8 shadow-[0_1px_0_rgba(0,0,0,0.04)] transition-shadow duration-500 hover:shadow-[0_18px_45px_rgba(0,0,0,0.07)]"
              style={`--kasnjenje:${(i % 3) * 0.08}s`}
            >
              <div>
                <span class="block text-[14px] tracking-[0.18em] text-[#c49a5a]" aria-label={`Ocena ${r.ocena || 5} od 5`}>
                  {"★".repeat(r.ocena || 5)}
                </span>
                <blockquote class="mt-5 font-serif text-[18px] leading-[1.5] text-neutral-800">{r.opis.trim()}</blockquote>
              </div>
              <figcaption class="mt-7 pt-5 border-t border-neutral-200">
                {(() => {
                  const potpis = potpisRecenzije(r);
                  return (potpis.ime || potpis.instagram) && (
                    <span class="block mb-2 text-[13px] font-medium text-neutral-900">
                      {potpis.ime}
                      {potpis.instagram && (
                        <a href={potpis.instagramUrl} target="_blank" rel="noopener nofollow" class={`text-neutral-500 hover:text-neutral-900 ${potpis.ime ? "ml-1.5" : ""}`}>@{potpis.instagram}</a>
                      )}
                    </span>
                  );
                })()}
                <span class="block text-[10.5px] font-medium uppercase tracking-[0.16em] text-neutral-500">{lepNaziv(r.kurs?.naziv) || "Studio 27"}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
