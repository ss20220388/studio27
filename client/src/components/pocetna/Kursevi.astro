---
// Svi kursevi iz baze u "bento" mreži: glavna slika kursa, naziv, oznake i cena.
// Na hover se slika približi i otkrije opis (komentarSredina iz baze).
import Ikona from "../novo/Ikona.astro";
import { imaCenu, lepNaziv, slikaIzBaze, type KursIzBaze } from "../../data/sajt";

interface Props {
  kursevi: KursIzBaze[];
}
const { kursevi } = Astro.props;

// Naizmenično široka i uža kartica (7/5, 5/7 ...) da mreža ne bude monotona
const sirine = ["lg:col-span-7", "lg:col-span-5", "lg:col-span-5", "lg:col-span-7"];
const prviPasus = (t?: string) => (t || "").split(/\n\s*\n/)[0]?.trim() || "";
---

<section id="edukacije" class="scroll-mt-20 bg-white">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 pt-24 md:pt-32 pb-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="pojava">
        <p class="text-[11px] font-medium uppercase tracking-[0.26em] text-neutral-500">Edukacije</p>
        <h2 class="mt-4 font-serif text-[40px] md:text-[60px] leading-[1.02] tracking-[-0.02em]">
          Izaberi svoj put<br class="hidden md:block" /> u vizualizaciji.
        </h2>
      </div>
      <p class="pojava max-w-[420px] text-[15px] leading-relaxed text-neutral-600" style="--kasnjenje:0.15s">
        Od fotorealističnih enterijera i eksterijera do dizajna prostora — svaki kurs te vodi korak po korak, uz podršku
        predavača.
      </p>
    </div>

    {
      kursevi.length === 0 ? (
        <p class="mt-16 text-neutral-500">Trenutno nema dostupnih kurseva.</p>
      ) : (
        <div class="mt-12 md:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-4 md:gap-5">
          {kursevi.map((k, i) => (
            <a
              href={`/kurs/${k.id}`}
              class:list={[
                "pojava group relative block overflow-hidden bg-neutral-200 h-[460px] md:h-[560px]",
                kursevi.length === 1 ? "lg:col-span-12" : sirine[i % sirine.length],
              ]}
              style={`--kasnjenje:${(i % 2) * 0.12}s`}
            >
              {k.slikaUrl && (
                <img
                  src={slikaIzBaze(k.slikaUrl)}
                  alt={lepNaziv(k.naziv)}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.06]"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/5" />

              <div class="absolute top-5 left-5 right-5 md:top-7 md:left-7 md:right-7 flex items-start justify-between gap-4 text-white">
                <span class="font-serif text-[22px] opacity-80">{String(i + 1).padStart(2, "0")}</span>
                <span class="border border-white/40 bg-black/25 backdrop-blur-sm px-3 py-1.5 text-[12px] tracking-wide">
                  {imaCenu(k) ? `${k.cena} €` : "Cena na upit"}
                </span>
              </div>

              <div class="absolute inset-x-0 bottom-0 p-6 md:p-8 text-white">
                {k.glavniKurs && <p class="text-[11px] uppercase tracking-[0.22em] text-white/75">{k.glavniKurs}</p>}
                <div class="mt-3 flex items-end justify-between gap-6">
                  <h3 class="font-serif text-[30px] md:text-[38px] leading-[1.04] tracking-[-0.02em] max-w-[480px]">{lepNaziv(k.naziv)}</h3>
                  <span class="shrink-0 w-12 h-12 border border-white/50 flex items-center justify-center transition-all duration-500 group-hover:bg-white group-hover:text-neutral-900">
                    <Ikona ime="strelica" class="w-5 h-5 transition-transform duration-500 group-hover:-rotate-45" />
                  </span>
                </div>
                {prviPasus(k.komentarSredina) && (
                  <div class="grid transition-all duration-700 ease-out lg:grid-rows-[0fr] lg:group-hover:grid-rows-[1fr]">
                    <p class="overflow-hidden text-[14px] md:text-[15px] leading-relaxed text-white/85 max-w-[480px] lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-700">
                      <span class="block pt-3 line-clamp-3">{prviPasus(k.komentarSredina)}</span>
                    </p>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
