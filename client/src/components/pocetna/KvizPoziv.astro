---
// Poziv na mini kviz ispod kurseva. Sam kviz se ne vidi na stranici – otvara se u prozoru
// tek na klik (dugme ovde, "Koji kurs je za mene?" u hero delu i "Mini kviz" u meniju).
import MiniKviz from "../MiniKviz.astro";
import Ikona from "../novo/Ikona.astro";
---

<section class="bg-bez">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 py-14 md:py-16 grid md:grid-cols-[1fr_auto] gap-8 md:gap-16 items-center">
    <div class="pojava">
      <h2 class="font-serif text-[30px] md:text-[42px] leading-[1.05] tracking-[-0.02em]">Nisi siguran/na koji kurs je za tebe?</h2>
      <p class="mt-3 max-w-[620px] text-[15px] leading-relaxed text-neutral-600">
        Odgovori na 4 kratka pitanja i otkrij koji program najbolje odgovara tvom znanju i ciljevima. Bez registracije.
      </p>
    </div>
    <a
      href="/kviz"
      data-otvori-kviz
      class="pojava group inline-flex items-center justify-center gap-3 bg-neutral-900 px-8 py-5 text-[13px] font-medium uppercase tracking-[0.14em] text-white hover:bg-black transition-colors"
      style="--kasnjenje:0.12s"
    >
      Pokreni mini kviz
      <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</section>

<dialog id="s27-kviz-prozor" class="s27-kviz-prozor" aria-label="Mini kviz – koji kurs je za tebe">
  <button type="button" data-zatvori-kviz class="s27-kviz-zatvori" aria-label="Zatvori kviz">
    <Ikona ime="plus" class="w-6 h-6 rotate-45" />
  </button>
  <MiniKviz />
</dialog>

<style is:global>
  .s27-kviz-prozor {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #f7f6f3;
    overflow-y: auto;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.35s ease, transform 0.35s ease, overlay 0.35s allow-discrete, display 0.35s allow-discrete;
  }
  .s27-kviz-prozor[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .s27-kviz-prozor[open] {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .s27-kviz-prozor::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }
  .s27-kviz-zatvori {
    position: fixed;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid #e2dfda;
    cursor: pointer;
    transition: background 0.2s;
  }
  .s27-kviz-zatvori:hover {
    background: #f0ece6;
  }
  .s27-kviz-prozor .s27-root {
    padding-top: 30px;
  }
  .s27-kviz-prozor .s27-topbar {
    padding-right: 60px;
  }
  html:has(.s27-kviz-prozor[open]) {
    overflow: hidden;
  }
</style>

<script>
  // Otvaranje/zatvaranje prozora sa kvizom; /#kviz (stari linkovi) odmah otvara kviz
  const prozor = document.getElementById("s27-kviz-prozor") as HTMLDialogElement | null;
  if (prozor) {
    const otvori = () => {
      if (!prozor.open) prozor.showModal();
      prozor.scrollTop = 0;
    };
    document.addEventListener("click", (e) => {
      const cilj = e.target as HTMLElement | null;
      if (cilj?.closest("[data-otvori-kviz]")) {
        e.preventDefault();
        document.getElementById("s27-nav-mobilni")?.classList.add("hidden");
        otvori();
      }
    });
    prozor.querySelector("[data-zatvori-kviz]")?.addEventListener("click", () => prozor.close());
    if (location.hash === "#kviz") otvori();
  }
</script>
