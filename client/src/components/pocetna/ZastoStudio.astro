---
// "Zašto Studio 27": fotografija sa statistikom i četiri prednosti, u stilu stranica kurseva
import Ikona from "../novo/Ikona.astro";
import { manjaSlika, srcsetSlike } from "../../data/sajt";
interface Props {
  // slike kurseva iz baze (ostale slike kurseva); bez njih sekcija ide bez fotografije
  slike: string[];
}
const { slike } = Astro.props;
const velika = slike[0] || "";
const mala = slike[1] || "";

const prednosti = [
  { ikona: "playKvadrat", naslov: "Video lekcije i uživo nastava", tekst: "Nasnimljeni kursevi koje gledaš svojim tempom ili rad 1 na 1 sa predavačem." },
  { ikona: "beskonacno", naslov: "Neograničen pristup", tekst: "Kurs je tvoj zauvek — vraćaš se lekcijama koliko god puta želiš." },
  { ikona: "folder", naslov: "Scene i fajlovi za vežbu", tekst: "Gotove scene, biblioteke materijala i 3D modela za samostalan rad." },
  { ikona: "poruka", naslov: "Feedback u privatnom chatu", tekst: "Pregled tvojih radova i odgovori na pitanja tokom i nakon kursa." },
];

const proces = ["Model", "Materijali", "Svetlo", "Kamera", "Render", "Prezentacija"];
---

<section class="bg-white py-24 md:py-32">
  <div class:list={["max-w-[1400px] mx-auto px-5 md:px-10 grid gap-14 lg:gap-24 items-center", velika ? "lg:grid-cols-2" : "lg:grid-cols-1 max-w-[900px]"]}>
    {
      velika && (
        <div class="pojava relative">
          <div class="overflow-hidden">
            <img
              src={manjaSlika(velika, 1200)}
              srcset={srcsetSlike(velika, 1600)}
              sizes="(min-width: 1400px) 650px, (min-width: 1024px) 50vw, 100vw"
              alt="Vizualizacija sa kursa Studio 27"
              loading="lazy"
              class="w-full aspect-[4/3.2] object-cover transition-transform duration-[1600ms] hover:scale-[1.04]"
            />
          </div>
          {mala && (
            <div class="absolute -bottom-10 right-4 md:right-[-28px] w-[55%] overflow-hidden border-[10px] border-white shadow-[0_24px_60px_rgba(0,0,0,0.14)] hidden sm:block">
              <img src={manjaSlika(mala, 800)} srcset={srcsetSlike(mala, 1200)} sizes="(min-width: 1024px) 360px, 55vw" alt="Render sa kursa Studio 27" loading="lazy" class="w-full aspect-[147/100] object-cover" />
            </div>
          )}
        </div>
      )
    }

    <div class="lg:pt-0 pt-6">
      <div class="pojava">
        <p class="text-[11px] font-medium uppercase tracking-[0.26em] text-neutral-500">Zašto Studio 27</p>
        <h2 class="mt-4 font-serif text-[40px] md:text-[56px] leading-[1.03] tracking-[-0.02em]">
          Ne učiš samo softver.<br />Učiš kako nastaje dobra slika.
        </h2>
        <p class="mt-6 max-w-[540px] text-[16px] leading-relaxed text-neutral-600">
          Kroz jasno strukturisan proces prolazimo zajedno od prazne scene do finalnog rendera, uz objašnjenje zašto svaka
          odluka utiče na rezultat — kako bi isto znanje primenio/la na svakom svom projektu.
        </p>
      </div>

      <ol class="pojava mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[12px] uppercase tracking-[0.16em] text-neutral-500" style="--kasnjenje:0.1s">
        {
          proces.map((p, i) => (
            <li class="flex items-center gap-5">
              <span>
                <span class="font-serif text-neutral-900 text-[14px] mr-1.5">{String(i + 1).padStart(2, "0")}</span>
                {p}
              </span>
              {i < proces.length - 1 && <span class="h-px w-5 bg-neutral-300" />}
            </li>
          ))
        }
      </ol>

      <div class="mt-10 grid sm:grid-cols-2 gap-x-10 gap-y-8 border-t border-neutral-200 pt-10">
        {
          prednosti.map((p, i) => (
            <div class="pojava flex gap-4" style={`--kasnjenje:${0.1 + i * 0.08}s`}>
              <Ikona ime={p.ikona} class="w-7 h-7 shrink-0 text-neutral-800" debljina={1.3} />
              <div>
                <h3 class="font-serif text-[20px] leading-tight">{p.naslov}</h3>
                <p class="mt-2 text-[14px] leading-relaxed text-neutral-600">{p.tekst}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
