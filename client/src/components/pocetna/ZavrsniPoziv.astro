---
// Završni poziv na dnu početne strane
import Ikona from "../novo/Ikona.astro";
interface Props {
  // jedna od slika kurseva iz baze (ako je nema, pozadina je tamna)
  slika?: string;
}
const { slika } = Astro.props;
---

<section class="relative overflow-hidden bg-neutral-900 text-white">
  {slika && <img src={slika} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />}
  <div class="absolute inset-0 bg-black/55"></div>
  <div class="relative max-w-[1400px] mx-auto px-5 md:px-10 py-28 md:py-40 text-center">
    <p class="pojava text-[11px] font-medium uppercase tracking-[0.26em] text-white/70">Studio 27</p>
    <h2 class="pojava mt-5 mx-auto max-w-[860px] font-serif text-[42px] md:text-[68px] leading-[1.0] tracking-[-0.02em]" style="--kasnjenje:0.1s">
      Tvoj sledeći projekat počinje ovde.
    </h2>
    <p class="pojava mt-6 mx-auto max-w-[520px] text-[16px] leading-relaxed text-white/80" style="--kasnjenje:0.2s">
      Pridruži se našim polaznicima i nauči da praviš vizualizacije koje se izdvajaju.
    </p>
    <div class="pojava mt-10 flex flex-wrap justify-center gap-3" style="--kasnjenje:0.3s">
      <a
        href="#edukacije"
        class="group inline-flex items-center gap-3 bg-white px-8 py-4 text-[13px] font-medium text-neutral-900 hover:bg-neutral-100 transition-colors"
      >
        Pogledaj kurseve
        <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>
      <a
        href="/kviz"
        class="inline-flex items-center gap-3 border border-white/60 px-8 py-4 text-[13px] font-medium text-white hover:bg-white/10 transition-colors"
      >
        Pokreni mini kviz
      </a>
    </div>
  </div>
</section>
