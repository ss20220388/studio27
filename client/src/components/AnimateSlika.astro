---
const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
const imageUrl = `${API_URL}/api/uploaded-images/towebp/15.webp`; 
---

<section class="bg-white  text-black">
  <!-- MOBILNI POGLED (do md ekrana): Stabilna responsive slika -->
  <div class="block md:hidden relative w-full h-[50vh] min-h-[350px] overflow-hidden bg-zinc-100">
    <img 
      src={imageUrl} 
      alt="Preview visual"
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/5 via-transparent to-black/10 pointer-events-none"></div>
  </div>

  <!-- DESKTOP POGLED (md i veći ekrani): Originalni veliku Parallax ram -->
  <div 
    class="hidden md:block relative w-full h-[85vh] min-h-[750px] overflow-hidden bg-fixed bg-center bg-cover bg-no-repeat"
    style={`background-image: url('${imageUrl}');`}
  >
    <div class="absolute inset-0 bg-gradient-to-b from-black/5 via-transparent to-black/10 pointer-events-none"></div>
  </div>
</section>