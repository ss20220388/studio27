---
import { useState } from "react";
import LoginSectionForm from "../react-components/LoginSectionForm.tsx";
import DropDownMenu from "../react-components/DropDownMenu.tsx";
import KontakModal from "../react-components/KontakModal.tsx";
import { Image } from "astro:assets";

const CLIENT_URL = import.meta.env.PUBLIC_CLIENT_URL || "http://studio27.rs";
const PUBLIC_APP_URL =
  import.meta.env.PUBLIC_APP_URL || "http://app.studio27.rs";
const PUBLIC_ADMIN_URL =
  import.meta.env.PUBLIC_ADMIN_URL || "http://admin.studio27.rs";
const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
---

<section
  class="bg-black text-gray-400 work-sans leading-normal text-base tracking-normal"
>
  <nav id="header" class="w-full fixed top-0 z-50 bg-black shadow py-3">
    <div
      class="w-screen relative min-w-20  container mx-auto flex flex-wrap items-center justify-between mt-0 pb-1"
    >
      <!-- First Row: Logo & Kontakt -->
      <div class="flex md:gap-8 items-center justify-between w-full md:w-auto px-4 md:px-0 md:ml-12">
        <a
          class="flex items-center tracking-wide no-underline hover:no-underline font-bold text-white text-l mr-8"
          href={`${CLIENT_URL}/#home`}
        >
          STUDIO27
          <Image
            src="/src/assets/studio27.jpg"
            width={100}
            height={100}
            alt="Profile"
            class="md:w-[2rem] sm:w-[1.5rem] w-[1rem] object-center ml-2"
          />
        </a>

        <!-- Kontakt Button (Visible only on mobile inside the first row) -->
        <div class=" inline-block font-bold text-white bg-red-900 hover:bg-red-800 transition-colors duration-200 py-1 px-3 shadow-md text-sm rounded">
          <KontakModal textButtona="Kontakt" client:load />
        </div>
      </div>

      <!-- Second Row (Mobile Only): Hamburger & DropDown -->
      <div class="flex items-center justify-between w-full px-4 mt-2 md:hidden">
        <button
          id="mobile-menu-btn"
          class="flex items-center px-3 py-2 border rounded text-gray-200 border-gray-400 hover:text-white hover:border-white"
        >
          <svg class="fill-current h-6 w-6" viewBox="0 0 20 20">
            <title>Menu</title>
            <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
          </svg>
        </button>

        <div class="inline-block font-bold text-white transition-colors duration-200 shadow-md">
          <DropDownMenu
            client:load
            publicAppUrl={PUBLIC_APP_URL}
            publicAdminUrl={PUBLIC_ADMIN_URL}
            publicApiUrl={PUBLIC_API_URL}
          />
        </div>
      </div>

      <ul
        id="main-nav"
        class="flex-col md:flex-row py-2 px-4 items-center justify-center text-base absolute md:static left-0 top-full w-full md:w-auto bg-black backdrop-blur-md md:bg-transparent border-b border-neutral-800 md:border-none z-40 hidden md:flex shadow-xl md:shadow-none"
      >
        <li>
          <a
            class="block w-full text-center md:text-left md:w-auto md:inline-block no-underline font-medium text-gray-300 hover:text-white hover:bg-neutral-900/80 md:hover:bg-transparent rounded-lg text-l py-3 px-4 transition-all duration-300"
            href={`${CLIENT_URL}/#home`}>Početna</a
          >
        </li>
        <li>
          <a
            class="block w-full text-center md:text-left md:w-auto md:inline-block no-underline font-medium text-gray-300 hover:text-white hover:bg-neutral-900/80 md:hover:bg-transparent rounded-lg text-l py-3 px-4 transition-all duration-300"
            href={`${CLIENT_URL}/#kursevi`}>Program kursa</a
          >
        </li>
        <li>
          <a
            class="block w-full text-center md:text-left md:w-auto md:inline-block no-underline font-medium text-gray-300 hover:text-white hover:bg-neutral-900/80 md:hover:bg-transparent rounded-lg text-l py-3 px-4 transition-all duration-300"
            href={`${CLIENT_URL}/#prednosti`}>Prednosti obuke</a
          >
        </li>
        <li>
          <a
            class="block w-full text-center md:text-left md:w-auto md:inline-block no-underline font-medium text-gray-300 hover:text-white hover:bg-neutral-900/80 md:hover:bg-transparent rounded-lg text-l py-3 px-4 transition-all duration-300"
            href={`${CLIENT_URL}/#struktura`}>Struktura učenja</a
          >
        </li>
        <li>
          <a
            class="block w-full text-center md:text-left md:w-auto md:inline-block no-underline font-medium text-gray-300 hover:text-white hover:bg-neutral-900/80 md:hover:bg-transparent rounded-lg text-l py-3 px-4 transition-all duration-300"
            href="/radovi">Radovi studenata</a
          >
        </li>
        <li>
          <a
            class="block w-full text-center md:text-left md:w-auto md:inline-block no-underline font-medium text-gray-300 hover:text-white hover:bg-neutral-900/80 md:hover:bg-transparent rounded-lg text-l py-3 px-4 transition-all duration-300"
            href={`${CLIENT_URL}/#onama`}>O nama</a
          >
        </li>

        
        <li class="hidden lg:inline md:ml-28 md:pl-6 mt-2 md:mt-0 ">
          <div class="inline-block font-bold text-white transition-colors duration-200 py-2 px-7 text-lg rounded shadow-md ">
            <DropDownMenu client:load publicAppUrl={PUBLIC_APP_URL} publicAdminUrl={PUBLIC_ADMIN_URL} publicApiUrl={PUBLIC_API_URL} />
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <LoginSectionForm publicApiUrl={PUBLIC_API_URL} client:load />

  <script>
    if (typeof window !== "undefined") {
      const btn = document.getElementById("mobile-menu-btn");
      const nav = document.getElementById("main-nav");

      if (btn && nav) {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          nav.classList.toggle("hidden");
        });

        nav.addEventListener("click", () => {
          if (window.innerWidth < 768) {
            nav.classList.add("hidden");
          }
        });

        document.addEventListener("click", (e) => {
          try {
            const target = e.target as Node;
            if (window.innerWidth < 768 && !nav.contains(target) && !btn.contains(target)) {
              nav.classList.add("hidden");
            }
          } catch (err) {}
        });
      }
    }
  </script>
</section>




