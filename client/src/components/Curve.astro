---

---

<section
    id="struktura"
    class="relative min-h-screen
                bg-gradient-to-b
                from-black
                via-zinc-950
                to-black
                flex items-center justify-center
                px-6 pb-28 overflow-hidden"
>
    <!-- Soft white center glow -->
    <div
        class="absolute w-[750px] h-[750px] bg-white/5 blur-3xl rounded-full
              top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 lc-glow"
    >
    </div>

    <div class="relative z-10 max-w-6xl w-full text-center">
        <!-- TITLE -->
        <h2
            class="lc-title text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white font-extrabold leading-tight mb-8"
        >
            STRUKTURA UČENJA
        </h2>

        <h3
            class="lc-title text-4xl mb-16 sm:text-5xl md:text-6xl lg:text-xl text-white font-medium leading-tight mb-8"
        >
            (nasnimljene lekcije + video tutorijali)
        </h3>

        <div class="relative">
            <!-- Thin center line -->
            <div
                class="lc-line absolute top-10 left-0 w-full h-px
                  bg-gradient-to-r
                  from-transparent via-white/20 to-transparent"
            >
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-20 relative">
                <!-- STEP 1 -->
                <div
                    class="lc-step flex flex-col items-center group"
                    style="--step-i:0"
                >
                    <div
                        class="lc-circle w-20 h-20 bg-zinc-900 border border-white/10 rounded-full
                      flex items-center justify-center mb-6
                      transition-all duration-300
                      group-hover:border-white/40"
                    >
                        <svg
                            class="w-6 h-6 text-white/80"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            viewBox="0 0 24 24"
                        >
                            <path d="M12 8v8m-4-4h8"></path>
                        </svg>
                    </div>

                    <p class="text-white/40 text-xs tracking-widest mb-2">
                        01.
                    </p>
                    <h3 class="text-white font-medium tracking-wide">
                        Kupovina lekcija
                    </h3>
                </div>

                <!-- STEP 2 -->
                <div
                    class="lc-step flex flex-col items-center group"
                    style="--step-i:1"
                >
                    <div
                        class="lc-circle w-20 h-20 bg-zinc-900 border border-white/10 rounded-full
                      flex items-center justify-center mb-6
                      transition-all duration-300
                      group-hover:border-white/40"
                    >
                        <svg
                            class="w-6 h-6 text-white/80"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            viewBox="0 0 24 24"
                        >
                            <rect x="4" y="6" width="16" height="12"></rect>
                        </svg>
                    </div>

                    <p class="text-white/40 text-xs tracking-widest mb-2">
                        02.
                    </p>
                    <h3 class="text-white font-medium tracking-wide">
                        Pristup putem e-maila
                    </h3>
                </div>

                <!-- STEP 3 -->
                <div
                    class="lc-step flex flex-col items-center group"
                    style="--step-i:2"
                >
                    <div
                        class="lc-circle w-20 h-20 bg-zinc-900 border border-white/10 rounded-full
                        flex items-center justify-center mb-6
                        transition-all duration-300
                        group-hover:border-white/40"
                    >
                        <svg
                            class="w-6 h-6 text-white/80"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            viewBox="0 0 24 24"
                        >
                            <polygon points="9 5 19 12 9 19 9 5"></polygon>
                        </svg>
                    </div>

                    <p class="text-white/40 text-xs tracking-widest mb-2">
                        03.
                    </p>
                    <h3 class="text-white font-medium tracking-wide">
                        Praćenje video tutorijala
                    </h3>

                    
                </div>

                <!-- STEP 4 -->
                <div
                    class="lc-step flex flex-col items-center group"
                    style="--step-i:3"
                >
                    <div
                        class="lc-circle w-20 h-20 bg-zinc-900 border border-white/10 rounded-full
                        flex items-center justify-center mb-6
                        transition-all duration-300
                        group-hover:border-white/40"
                    >
                        <svg
                            class="w-6 h-6 text-white/80"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M21 15a4 4 0 01-4 4H7l-4 4V5a4 4 0 014-4h10a4 4 0 014 4z"
                            ></path>
                        </svg>
                    </div>

                    <p class="text-white/40 text-xs tracking-widest mb-2">
                        04.
                    </p>
                    <h3 class="text-white font-medium tracking-wide">
                        Feedback & Pitanja
                    </h3>
                </div>
               
            </div>
        </div>
    </div>
</section>

<style>
    /* Title fade up */
    .lc-title {
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 0.9s ease-out,
            transform 0.9s ease-out;
    }
    .lc-title.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Background glow pulse */
    .lc-glow {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.6);
        transition:
            opacity 1.2s ease-out,
            transform 1.2s ease-out;
    }
    .lc-glow.is-visible {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
        animation: glowPulse 4s ease-in-out 1.5s infinite;
    }
    @keyframes glowPulse {
        0%,
        100% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.08);
            opacity: 0.7;
        }
    }

    /* Horizontal line draw */
    .lc-line {
        transform: scaleX(0);
        transition: transform 1s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s;
    }
    .lc-line.is-visible {
        transform: scaleX(1);
    }

    /* Steps stagger in */
    .lc-step {
        opacity: 0;
        transform: translateY(50px);
        transition:
            opacity 0.7s ease-out,
            transform 0.7s ease-out;
        transition-delay: calc(0.4s + var(--step-i) * 0.2s);
    }
    .lc-step.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Circle border draw effect on visible */
    .lc-step.is-visible .lc-circle {
        animation: circleAppear 0.6s ease-out forwards;
        animation-delay: calc(0.6s + var(--step-i) * 0.2s);
    }
    @keyframes circleAppear {
        0% {
            transform: scale(0.5);
            border-color: transparent;
        }
        60% {
            transform: scale(1.15);
            border-color: rgba(255, 255, 255, 0.3);
        }
        100% {
            transform: scale(1);
            border-color: rgba(255, 255, 255, 0.1);
        }
    }
</style>

<script>
    const lcObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                }
            });
        },
        { threshold: 0.15 },
    );

    document
        .querySelectorAll(".lc-title, .lc-glow, .lc-line, .lc-step")
        .forEach((el) => {
            lcObserver.observe(el);
        });
</script>
