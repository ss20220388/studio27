---
// Paketi kursa iz baze (admin -> Kursevi -> Izmeni -> Paketi kursa), po skici klijentkinje:
// broj i naziv, podnaslov, cena, kratak opis, istaknut red (crveno), stavke sa kvačicama
// (**tekst** je podebljan) i dugme. "Kupi kurs" dodaje kurs u korpu sa izabranim paketom.
import Ikona from "../novo/Ikona.astro";
import { APP_URL, lepNaziv, type KursIzBaze, type PaketKursa } from "../../data/sajt";

interface Props {
  kurs: KursIzBaze;
  paketi: PaketKursa[];
  kupljen?: boolean;
  imaProgram?: boolean;
}
const { kurs, paketi, kupljen = false, imaProgram = false } = Astro.props;

const naslov = lepNaziv(kurs.naziv) || "Kurs";
const stavke = (opis?: string) => (opis || "").split("\n").map((s) => s.trim()).filter(Boolean);
// "**Modelovanje** od nule" -> [{tekst: "Modelovanje", jako: true}, {tekst: " od nule", jako: false}]
const delovi = (tekst: string) =>
  tekst.split("**").map((t, i) => ({ tekst: t, jako: i % 2 === 1 })).filter((d) => d.tekst);
---

<section id="paketi" class="bg-[#f7f6f3] border-t border-neutral-100 scroll-mt-20" aria-labelledby="paketi-naslov">
  <div class="max-w-[1300px] mx-auto px-5 md:px-10 py-16 md:py-24">
    <div class="pojava max-w-[640px]">
      <p class="text-[11px] font-medium uppercase tracking-[0.24em] text-neutral-500">Paketi i cene</p>
      <h2 id="paketi-naslov" class="mt-4 font-serif text-[34px] md:text-[46px] leading-[1.05] tracking-[-0.02em]">
        Izaberi paket koji ti odgovara
      </h2>
    </div>

    <ul class={`mt-10 md:mt-12 grid gap-4 md:gap-5 items-stretch ${paketi.length >= 3 ? "lg:grid-cols-3" : "md:grid-cols-2"}`}>
      {
        paketi.map((p, i) => {
          const zaKorpu = JSON.stringify({
            id: kurs.id,
            paketId: p.paketId,
            title: `${naslov} — ${p.naziv}`,
            subtitle: p.naziv,
            price: p.cena,
            image: kurs.slikaUrl || "",
          });
          return (
            <li class="pojava flex flex-col bg-white border border-neutral-200 p-6 md:p-8" style={`--kasnjenje:${i * 0.08}s`}>
              <h3 class="text-[17px] md:text-[18px] font-semibold uppercase tracking-[0.02em] text-neutral-900">
                {String(i + 1).padStart(2, "0")} — {p.naziv}
              </h3>
              {p.podnaslov && <p class="mt-1.5 text-[13.5px] text-neutral-500">{p.podnaslov}</p>}

              <p class="mt-6 font-serif text-[46px] md:text-[54px] leading-none tracking-[-0.02em] text-neutral-900">
                {p.cena} <span class="text-[30px]">€</span>
              </p>

              {(p.uvod || p.istaknuto) && (
                <div class="mt-5 pb-5 border-b border-neutral-200">
                  {p.uvod && <p class="text-[14px] text-neutral-700">{p.uvod}</p>}
                  {p.istaknuto && (
                    <p class="mt-1.5 text-[12.5px] font-semibold uppercase tracking-[0.08em] text-[#b3261e]">{p.istaknuto}</p>
                  )}
                </div>
              )}

              {stavke(p.opis).length > 0 && (
                <ul class="mt-5 space-y-2.5 text-[14px] leading-snug text-neutral-700">
                  {stavke(p.opis).map((s) => (
                    <li class="flex gap-3">
                      <Ikona ime="kvacica" class="w-4 h-4 mt-0.5 shrink-0 text-neutral-900" debljina={2} />
                      <span>
                        {delovi(s).map((d) => (d.jako ? <strong class="font-semibold text-neutral-900">{d.tekst}</strong> : d.tekst))}
                      </span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-auto pt-8 space-y-2">
                {kupljen ? (
                  <a
                    href={APP_URL}
                    class="flex w-full items-center justify-center gap-3 bg-neutral-900 px-6 py-4 text-[13px] font-semibold uppercase tracking-[0.08em] text-white hover:bg-black transition-colors"
                  >
                    Pristupi kursu u aplikaciji
                  </a>
                ) : (
                  <button
                    type="button"
                    data-kupi-kurs={zaKorpu}
                    class="cursor-pointer flex w-full items-center justify-center gap-3 bg-neutral-900 px-6 py-4 text-[13px] font-semibold uppercase tracking-[0.08em] text-white hover:bg-black transition-colors"
                  >
                    {p.dugme || "Kupi kurs"}
                  </button>
                )}
                {imaProgram && (
                  <a
                    href="#program"
                    class="flex w-full items-center justify-center border border-neutral-300 px-6 py-3 text-[11.5px] font-semibold uppercase tracking-[0.1em] text-neutral-700 hover:border-neutral-900 hover:text-neutral-900 transition-colors"
                  >
                    Pogledaj kompletan program kursa
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
