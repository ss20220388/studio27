---
// Paketi kursa iz baze (admin -> Kursevi -> Izmeni -> Paketi kursa): naziv, cena i stavke.
// "Izaberi paket" dodaje kurs u korpu sa izabranim paketom i njegovom cenom.
import Ikona from "../novo/Ikona.astro";
import { APP_URL, lepNaziv, type KursIzBaze, type PaketKursa } from "../../data/sajt";

interface Props {
  kurs: KursIzBaze;
  paketi: PaketKursa[];
  kupljen?: boolean;
}
const { kurs, paketi, kupljen = false } = Astro.props;

const naslov = lepNaziv(kurs.naziv) || "Kurs";
const stavke = (opis?: string) => (opis || "").split("\n").map((s) => s.trim()).filter(Boolean);
// srednji (ili jedini drugi) paket je istaknut kao preporuka
const istaknut = paketi.length >= 3 ? 1 : -1;
---

<section id="paketi" class="bg-[#f7f6f3] border-t border-neutral-100 scroll-mt-20" aria-labelledby="paketi-naslov">
  <div class="max-w-[1300px] mx-auto px-5 md:px-10 py-16 md:py-24">
    <div class="pojava max-w-[640px]">
      <p class="text-[11px] font-medium uppercase tracking-[0.24em] text-neutral-500">Paketi i cene</p>
      <h2 id="paketi-naslov" class="mt-4 font-serif text-[34px] md:text-[46px] leading-[1.05] tracking-[-0.02em]">
        Izaberi paket koji ti odgovara
      </h2>
    </div>

    <ul class={`mt-10 md:mt-12 grid gap-4 md:gap-5 ${paketi.length >= 3 ? "lg:grid-cols-3" : "md:grid-cols-2"}`}>
      {
        paketi.map((p, i) => {
          const zaKorpu = JSON.stringify({
            id: kurs.id,
            paketId: p.paketId,
            title: `${naslov} — ${p.naziv}`,
            subtitle: p.naziv,
            price: p.cena,
            image: kurs.slikaUrl || "",
          });
          const tamna = i === istaknut;
          return (
            <li
              class={`pojava flex flex-col p-7 md:p-8 ${tamna ? "bg-neutral-900 text-white" : "bg-white text-neutral-900 border border-neutral-200"}`}
              style={`--kasnjenje:${i * 0.08}s`}
            >
              <p class={`text-[11px] font-medium uppercase tracking-[0.2em] ${tamna ? "text-white/60" : "text-neutral-500"}`}>
                {String(i + 1).padStart(2, "0")} — {p.naziv}
              </p>
              <p class="mt-5 font-serif text-[44px] md:text-[52px] leading-none tracking-[-0.02em]">
                {p.cena} <span class="text-[28px]">€</span>
              </p>
              {
                stavke(p.opis).length > 0 && (
                  <ul class={`mt-7 space-y-3 text-[14px] leading-snug ${tamna ? "text-white/85" : "text-neutral-700"}`}>
                    {stavke(p.opis).map((s) => (
                      <li class="flex gap-3">
                        <Ikona ime="kvacica" class={`w-4 h-4 mt-0.5 shrink-0 ${tamna ? "text-white" : "text-neutral-900"}`} debljina={2} />
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                )
              }
              <div class="mt-auto pt-8">
                {
                  kupljen ? (
                    <a
                      href={APP_URL}
                      class={`inline-flex w-full items-center justify-center gap-3 px-6 py-4 text-[13px] font-medium transition-colors ${tamna ? "bg-white text-neutral-900 hover:bg-neutral-200" : "bg-neutral-900 text-white hover:bg-black"}`}
                    >
                      Pristupi kursu u aplikaciji
                    </a>
                  ) : (
                    <button
                      type="button"
                      data-kupi-kurs={zaKorpu}
                      class={`cursor-pointer inline-flex w-full items-center justify-center gap-3 px-6 py-4 text-[13px] font-medium transition-colors ${tamna ? "bg-white text-neutral-900 hover:bg-neutral-200" : "bg-neutral-900 text-white hover:bg-black"}`}
                    >
                      Izaberi paket
                      <Ikona ime="strelica" class="w-4 h-4" />
                    </button>
                  )
                }
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
