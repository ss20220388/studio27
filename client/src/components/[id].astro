---
import Layout from "../layouts/Layout.astro";
import KursPlayer from "../react-components/KursPlayer.jsx";

const { id } = Astro.params;

// uzimamo kurs po id-u
const res = await fetch(`http://api.studio27.rs/api/kursevi/${id}`);
const kurs = await res.json();

// uzimamo lekcije
const lekcijeRes = await fetch(`http://api.studio27.rs/api/lekcije/${id}`);
const lekcije = await lekcijeRes.json();

const token = Astro.cookies.get("refreshToken")?.value || null;
---

<Layout title={kurs.naziv}>

<section class="max-w-7xl mx-auto py-20 px-6">

  <h1 class="text-4xl font-bold mb-6">
    {kurs.naziv}
  </h1>

  <p class="text-gray-600 mb-10">
    {kurs.opis}
  </p>

  <KursPlayer
    client:load
    lekcije={lekcije}
    token={token}
  />

</section>

</Layout>