---
interface Kurs {
    kursId: number;
    naziv: string;
    opis: string;
    cena: number;
    trajanje: number;
    slikaUrl: string;
}

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

const { kurs } = Astro.props as { kurs: Kurs };



---

<section
    class="shadow-md bg-white rounded-xl p-6 hover:shadow-xl transition duration-300 cursor-pointer w-full"
    onclick={`window.location.href = '/kurs/${kurs.kursId}'`}
>
    <img
        src={`${API_URL}/api/uploaded-images${kurs.slikaUrl}`}
        alt={kurs.naziv}
        class="w-full h-40 object-cover rounded-lg mb-4"
    />

    <h2 class="text-xl font-bold text-gray-800 mb-2">
        {kurs.naziv}
    </h2>

    <p class="text-gray-600 mb-3">
        {kurs.opis}
    </p>

    <p class="font-semibold text-indigo-600">
        {kurs.cena} RSD
    </p>

    <p class="text-sm text-gray-500">
        {kurs.trajanje} časova
    </p>
</section>
