---
import { Image } from "astro:assets";

---

<header id="home" class="relative min-h-screen w-full overflow-hidden bg-black text-white">

    <!-- Background -->
    <div class="absolute inset-0 z-0 w-screen h-screen overflow-hidden">
        <Image
            src={"http://api.studio27.rs/api/uploaded-images/uploads/naslovna2.jpg"}
            alt="Interior Background"
            width={50}
            height={20}
            class="hero-bg bg-fixed object-cover w-screen h-screen opacity-0"
        />
        <div class="absolute inset-0 bg-black/70"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col justify-center min-h-screen px-6 sm:px-10 md:px-20 lg:px-32 py-20">

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20">

            <!-- Left -->
            <div class="text-center md:text-left md:pl-16 lg:pl-56">
                <h1 class="hero-title text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight mb-8">
                    3D ŠKOLA <br /> KURSEVA
                </h1>

                <ul class="space-y-2 text-base sm:text-lg md:text-xl opacity-90">
                    <li class="hero-list-item" style="--i:0">• Od nule do prvog klijenta</li>
                    <li class="hero-list-item" style="--i:1">• HERO (Level up)</li>
                    <li class="hero-list-item" style="--i:2">• Kurs eksterijera</li>
                    <li class="hero-list-item" style="--i:3">• Animacija</li>
                </ul>
            </div>

            <!-- Right -->
            <div class="text-center md:text-left md:mt-10">
                <ul class="space-y-2 text-base sm:text-lg md:text-xl opacity-90">
                    <li class="hero-list-item-right" style="--i:0">- Snimljeni materijal (prati svojim tempom)</li>
                    <li class="hero-list-item-right" style="--i:1">- Feedback u chatu</li>
                    <li class="hero-list-item-right" style="--i:2">- Kompletan propratni materijal</li>
                    <li class="hero-list-item-right" style="--i:3">- Praktični projekti</li>
                    <li class="hero-list-item-right" style="--i:4">- Gotove scene</li>
                    <li class="hero-list-item-right" style="--i:5">- Doživotni pristup</li>
                    <li class="hero-list-item-right" style="--i:6">- Sertifikat</li>
                </ul>
            </div>

        </div>

        <!-- Bottom -->
        <div class="hero-bottom mt-16 flex flex-col md:flex-row items-center md:pl-16 lg:pl-56 justify-between gap-8">

            <h2 class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-semibold text-center md:text-left">
                3Ds Max | Corona render | Photoshop
            </h2>

            <button onclick="window.location.href='#kursevi'" class="hero-cta bg-red-900 hover:bg-red-800 transition-all duration-300 px-8 py-3 sm:px-10 sm:py-4 text-base sm:text-lg font-bold shadow-lg w-full md:w-auto">
                Pogledaj kurseve
            </button>

        </div>

    </div>

</header>

<style>
  /* Background image fade & zoom */
  .hero-bg {
    animation: heroBgIn 1.8s ease-out 0.2s forwards;
    transform: scale(1.1);
  }
  @keyframes heroBgIn {
    to { opacity: 0.8; transform: scale(1); }
  }

  /* Title clip reveal */
  .hero-title {
    opacity: 0;
    transform: translateY(50px);
    animation: heroTitleIn 1s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.5s forwards;
  }
  @keyframes heroTitleIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Left list items stagger */
  .hero-list-item {
    opacity: 0;
    transform: translateX(-30px);
    animation: heroListLeft 0.6s ease-out forwards;
    animation-delay: calc(0.8s + var(--i) * 0.12s);
  }
  @keyframes heroListLeft {
    to { opacity: 0.9; transform: translateX(0); }
  }

  /* Right list items stagger */
  .hero-list-item-right {
    opacity: 0;
    transform: translateX(30px);
    animation: heroListRight 0.6s ease-out forwards;
    animation-delay: calc(1s + var(--i) * 0.1s);
  }
  @keyframes heroListRight {
    to { opacity: 0.9; transform: translateX(0); }
  }

  /* Bottom section */
  .hero-bottom {
    opacity: 0;
    transform: translateY(30px);
    animation: heroBottomIn 0.8s ease-out 1.6s forwards;
  }
  @keyframes heroBottomIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* CTA button pulse glow */
  .hero-cta {
    animation: ctaPulse 2.5s ease-in-out 2.5s infinite;
  }
  @keyframes ctaPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(127, 29, 29, 0.4); }
    50% { box-shadow: 0 0 25px 5px rgba(127, 29, 29, 0.2); }
  }
</style>