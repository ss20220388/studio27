---
const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

// Slike izvučene iz baze
const slike = [
  "/towebp/milicaindjic (1).webp",
  "/towebp/milapantelic (4).webp",
  "/towebp/marijav1.webp",
  "/towebp/kesnijakrivokapic4.webp",
  "/towebp/katarinabjegovic2.webp",
  "/towebp/joka4.webp",
  "/towebp/janajakovljevic (2).webp"
];
---

<section class="relative w-full h-screen overflow-hidden bg-zinc-950 flex items-center justify-center">
  <!-- Slike sa Ken Burns i Fade animacijom -->
  {slike.map((slika, idx) => (
    <div 
      class="absolute inset-0 w-full h-full opacity-0 slika-slide"
      style={`animation-delay: ${idx * 6}s; z-index: 1;`}
    >
      <!-- Kontrastni tamni overlay za bolju čitljivost teksta -->
      <div class="absolute inset-0 bg-black/75 z-10"></div>
      
      <img 
        src={`${API_URL}/api/uploaded-images${slika}`} 
        alt="Premium render studenta" 
        class="w-full h-full object-cover scale-110 slika-zoom"
        loading={idx === 0 ? "eager" : "lazy"}
        fetchpriority={idx === 0 ? "high" : "auto"}
        decoding="async"
      />
    </div>
  ))}

  <!-- Okvir oko ivica ekrana -->
  <div class="absolute inset-0 z-20 pointer-events-none border border-white/20 m-4 rounded-2xl hidden md:block"></div>

  <!-- Centralni tekst preko slike -->
  <div class="relative z-30 text-center px-4 max-w-5xl mx-auto flex flex-col items-center">
    <!-- Ekskluzivna Značkica sa neprovidnom podlogom radi garancije kontrasta -->
    <span class="px-6 py-2 rounded-full bg-zinc-950 text-white border border-zinc-700 text-xs md:text-sm font-semibold tracking-[0.2em] uppercase mb-8 shadow-2xl inline-block">
      Ekskluzivna Galerija
    </span>
    
    <h2 class="text-5xl md:text-7xl lg:text-8xl font-black text-white mb-6 tracking-tighter drop-shadow-lg" style="font-family: 'Montserrat', sans-serif;">
      Impresivni Detalji
    </h2>
    
    <p class="text-lg md:text-2xl text-zinc-100 font-light max-w-3xl mx-auto mb-12 leading-relaxed drop-shadow-md">
      Pogledajte najbolje 3D radove naših polaznika na celom ekranu. Sva moć i fotorealističnost tehnike leži u ovim neverovatnim detaljima.
    </p>
    
    <!-- Moderno animirano dugme sa sertifikovanim WCAG kontrastom -->
    <a 
      href="/radovi" 
      class="group relative px-8 py-4 bg-[#bc3b24] hover:bg-[#9e301c] text-white font-extrabold rounded-lg transition-all duration-300 overflow-hidden shadow-2xl hover:-translate-y-1"
    >
      <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmerBtn_1.5s_infinite]"></div>
      <span class="relative flex items-center gap-3 tracking-wider text-sm sm:text-base">
        OTKRIJ SVE RADOVE
        <svg class="w-6 h-6 group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  /* 7 slika * 6 sekundi po slici = 42 sekunde ukupnog trajanja ciklusa */
  .slika-slide {
    animation: fadeSlide 42s infinite;
  }
  
  /* Ken Burns spori zoom in efekat ka vizualnoj dubini */
  .slika-zoom {
    animation: zoomSlide 42s linear infinite;
    transform-origin: center center;
  }

  @keyframes fadeSlide {
    0% { opacity: 0; }
    4% { opacity: 1; z-index: 2; }    /* Na 1.68s je skroz vidljivo */
    14% { opacity: 1; z-index: 2; }   /* Do 5.88s ostaje potpuno vidljivo */
    18% { opacity: 0; z-index: 1; }   /* Do 7.56s bledi */
    100% { opacity: 0; z-index: 1; }
  }

  @keyframes zoomSlide {
    0% { transform: scale(1.05); }
    100% { transform: scale(1.3); }
  }

  @keyframes shimmerBtn {
    100% { transform: translateX(100%); }
  }
</style>