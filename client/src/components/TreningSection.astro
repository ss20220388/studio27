<style>
  /* Title animations */
  .trn-title {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .trn-title.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .trn-title-2 {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease-out 0.15s, transform 0.8s ease-out 0.15s;
  }
  .trn-title-2.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Benefit rows slide in from left */
  .trn-benefit {
    opacity: 0;
    transform: translateX(-40px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
    transition-delay: calc(var(--ben-i) * 0.15s);
  }
  .trn-benefit.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Circle icon scale + border draw */
  .trn-benefit.is-visible .trn-icon {
    animation: iconPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(var(--ben-i) * 0.15s + 0.2s);
  }
  @keyframes iconPop {
    0% { transform: scale(0.3) rotate(-90deg); opacity: 0; }
    60% { transform: scale(1.1) rotate(5deg); opacity: 1; }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
  }
</style>

<script>
  const trnObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.trn-title, .trn-title-2, .trn-benefit').forEach(el => {
    trnObserver.observe(el);
  });
</script>