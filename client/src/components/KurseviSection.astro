---
type Kurs = {
  kursId: number;
  naziv: string;
  opis: string;
  slikaUrl: string;
  glavniKurs: string;
  komentarDole: string;
  komentarSredina: string;
  komentarGore: string;
};
type ResponseData = {
  kursevi: Kurs[];
};

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

const res = await fetch(`${API_URL}/api/kursevi`);
const data: ResponseData = await res.json();
console.log(data);


const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch(`${API_URL}/api/auth/me`, {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();
console.log(userData);
const kursevi_1 = data?.kursevi?.slice(0, 4);
const kursevi_2 = data?.kursevi?.slice(4, 6);
---

<section id="kursevi" class="bg-black py-28 px-6 sm:px-10 md:px-16">

  <h2 class="anim-fade-up text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white text-center font-extrabold leading-tight mb-16">
    NAŠI KURSEVI
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto">

    {kursevi_1.map((kurs, i) => (
      <div class="kurs-card relative h-[420px] sm:h-[450px] md:h-[500px] overflow-hidden shadow-xl group" style={`--card-i:${i}`}>

        <!-- Image -->
        <div
          class="absolute inset-0 bg-cover bg-center transform group-hover:scale-110 transition duration-500"
          style={`background-image: url('${API_URL}/api/uploaded-images${kurs.slikaUrl}');`}
        ></div>

        <!-- Overlay -->
        <div class="absolute inset-0 bg-black/70 group-hover:bg-black/60 transition duration-500"></div>

        <!-- Content -->
        <div class="relative z-10 h-full flex flex-col justify-between p-6 text-white">

           <!-- Top -->
        <!-- Gornji tekst -->
    <div class="space-y-10">
      <h2 class="text-xl font-extrabold leading-snug">
        {kurs.naziv}
      </h2>
        <p class="text-base font-bold space-y-3">
        {kurs.glavniKurs}
      </p>

      <p class="text-sm opacity-90 space-y-2 font-bold">
        {kurs.komentarGore}
      </p>

        <p class="text-base space-y-10 font-bold">
        {kurs.komentarSredina}
      </p>

     
    </div>

          <!-- Button -->
         <!-- Donji deo -->
    <div class="space-y-3">
      <p class="text-xs font-extrabold  text-xl tracking-wide">
        {kurs.komentarDole}
      </p>

      <div class="flex w-full justify-end" > 
        <a href={`/kurs/${kurs.kursId}`} class="bg-red-900 hover:bg-red-800 px-4 py-2 text-sm  font-semibold">
        Detaljnije
      </a>
      </div>
    </div>

        </div>

      </div>
    ))}

  </div>


   <div class="flex flex-col md:flex-row flex-wrap justify-center items-center mt-3 gap-8 max-w-7xl mx-auto">

    {kursevi_2.map((kurs, i) => (
      <div class="kurs-card relative md:max-w-[300px] h-[420px] sm:h-[450px] md:h-[500px] overflow-hidden shadow-xl group" style={`--card-i:${i + 4}`}>

        <!-- Image -->
        <div
          class="absolute inset-0 bg-cover bg-center transform group-hover:scale-110 transition duration-500"
          style={`background-image: url('${API_URL}/api/uploaded-images${kurs.slikaUrl}');`}
        ></div>

        <!-- Overlay -->
        <div class="absolute inset-0 bg-black/70 group-hover:bg-black/60 transition duration-500"></div>

        <!-- Content -->
        <div class="relative z-10 h-full flex flex-col justify-between p-6 text-white">

        <!-- Top -->
        <!-- Gornji tekst -->
    <div class="space-y-10">
      <h2 class="text-xl font-extrabold leading-snug">
        {kurs.naziv}
      </h2>
        <p class="text-base font-bold space-y-3">
        {kurs.glavniKurs}
      </p>

      <p class="text-sm opacity-90 space-y-2 font-bold">
        {kurs.komentarGore}
      </p>

        <p class="text-base space-y-10 font-bold">
        {kurs.komentarSredina}
      </p>

     
    </div>

          <!-- Button -->
         <!-- Donji deo -->
    <div class="space-y-3">
      <p class="text-xs font-extrabold  text-xl tracking-wide">
        {kurs.komentarDole}
      </p>

      <div class="flex w-full justify-end" > 
        <a href={`/kurs/${kurs.kursId}`} class="bg-red-900 hover:bg-red-800 px-4 py-2 text-sm  font-semibold">
        Detaljnije
      </a>
      </div>
    </div>

        </div>

      </div>
    ))}

  </div>
 <div class="max-w-7xl mx-auto mt-24 text-white">

  <div class="grid md:grid-cols-2 gap-16">

    <!-- LEVA STRANA -->
    <div class="space-y-8">

      <div class="faq-item" style="--faq-i:0">
        <h3 class="font-bold text-lg mb-3">
          Koja oprema i programi su mi potrebni?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Za praćenje kursa potreban je računar sa minimum Intel i7 / Ryzen 7 procesorom i 16GB RAM memorije (preporučeno 32GB za brži rad).
          Radi se u programima 3ds Max i Corona Renderer.
        </p>
      </div>

      <div class="faq-item" style="--faq-i:1">
        <h3 class="font-bold text-lg mb-3">
          Da li je kurs za početnike?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Da. Kurs je prilagođen i početnicima i onima koji već imaju osnovno znanje.
          Sve se objašnjava korak po korak – od interfejsa do finalnog rendera.
        </p>
      </div>

      <div class="faq-item" style="--faq-i:2">
        <h3 class="font-bold text-lg mb-3">
          Kako izgleda format kursa?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Kurs je online i sastoji se od snimljenih lekcija koje možeš gledati svojim tempom.
          Uz video lekcije dobijaš i dodatne materijale, fajlove za vežbu i konkretne projekte.
        </p>
      </div>

      <div class="faq-item" style="--faq-i:3">
        <h3 class="font-bold text-lg mb-3">
          Da li imam vremensko ograničenje za završetak kursa?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Ne. Kurs prolaziš svojim tempom, bez pritiska i rokova.
        </p>
      </div>

    </div>

    <!-- DESNA STRANA -->
    <div class="space-y-8">

      <div class="faq-item" style="--faq-i:4">
        <h3 class="font-bold text-lg mb-3">
          Da li dobijam sertifikat?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Da. Nakon uspešno završenog projekta dobijaš sertifikat o završenom kursu.
        </p>
      </div>

      <div class="faq-item" style="--faq-i:5">
        <h3 class="font-bold text-lg mb-3">
          Da li postoji feedback?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Da. Imaš mogućnost dobijanja povratnih informacija na svoje radove,
          kao i podršku bez obzira na vreme kupovine.
        </p>
      </div>

      <div class="faq-item" style="--faq-i:6">
        <h3 class="font-bold text-lg mb-3">
          Da li dobijam pristup svim lekcijama odmah?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Da. Nakon uplate dobijaš kompletan pristup svim modulima.
        </p>
      </div>

      <div class="faq-item" style="--faq-i:7">
        <h3 class="font-bold text-lg mb-3">
          Da li dobijam fajlove i resurse?
        </h3>
        <p class="text-gray-300 leading-relaxed">
          Da. Uz lekcije dobijaš radne fajlove, modele, materijale i dodatne resurse potrebne za vežbu.
        </p>
      </div>

    </div>

  </div>

</div>
</section>

<style>
  /* Course cards - slide up with stagger */
  .kurs-card {
    opacity: 0;
    transform: translateY(60px) scale(0.96);
    transition: opacity 0.7s cubic-bezier(0.25,0.46,0.45,0.94),
                transform 0.7s cubic-bezier(0.25,0.46,0.45,0.94);
    transition-delay: calc(var(--card-i) * 0.12s);
  }
  .kurs-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* FAQ items - slide in from left */
  .faq-item {
    opacity: 0;
    transform: translateX(-25px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    transition-delay: calc(var(--faq-i) * 0.08s);
  }
  .faq-item.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Generic fade up */
  .anim-fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .anim-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.kurs-card, .faq-item, #kursevi .anim-fade-up').forEach(el => {
    observer.observe(el);
  });
</script>