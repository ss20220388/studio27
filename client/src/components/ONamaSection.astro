---
// Sekcija o autorki (Doroteja Dokić) u stilu novog dizajna
import Doroteja from "../assets/Doroteja.webp";
import Ikona from "./novo/Ikona.astro";
import { whatsappLink } from "../data/sajt";

const naucices = [
  "3ds Max od samog početka",
  "Corona Renderer",
  "Modelovanje enterijera i eksterijera",
  "Profesionalni workflow",
  "Optimizaciju rada",
];
const program = [
  "Pristup svim snimljenim lekcijama",
  "Detaljno objašnjene vežbe",
  "Podršku i konsultacije",
  "Neograničen pristup kursu",
];
---

<section id="onama" class="bg-white py-24 md:py-32 scroll-mt-4">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 grid lg:grid-cols-[0.9fr_1.1fr] gap-14 lg:gap-24 items-center">
    <div class="pojava relative">
      <div class="absolute -left-4 -bottom-4 md:-left-6 md:-bottom-6 w-2/3 h-2/3 bg-bez" aria-hidden="true"></div>
      <img
        src={Doroteja.src}
        alt="Doroteja Dokić, osnivač Studio 27"
        loading="lazy"
        class="relative w-full aspect-[4/5] object-cover object-top"
      />
    </div>

    <div>
      <div class="pojava">
        <p class="text-[11px] font-medium uppercase tracking-[0.26em] text-neutral-500">Upoznaj autorku</p>
        <h2 class="mt-4 font-serif text-[44px] md:text-[60px] leading-[1.0] tracking-[-0.02em]">Doroteja Dokić</h2>
        <p class="mt-3 text-[13px] uppercase tracking-[0.2em] text-neutral-500">Osnivač Studio 27 · dizajner enterijera</p>
      </div>

      <div class="pojava mt-8 space-y-5 text-[16px] leading-[1.75] text-neutral-700 max-w-[640px]" style="--kasnjenje:0.1s">
        <p>
          Moje ime je <strong class="font-semibold text-neutral-900">Doroteja Dokić</strong> i osnivač sam biroa
          <strong class="font-semibold text-neutral-900">Studio 27</strong> – specijalizovanog za arhitektonsku
          vizualizaciju i edukaciju budućih 3D umetnika.
        </p>
        <p>
          Diplomirani sam dizajner enterijera, a kroz godine rada sarađivala sam na brojnim projektima vizualizacije za
          klijente iz regiona i inostranstva. Iskustvo stečeno u profesionalnom radu pretočila sam u edukativni program
          koji polaznicima pruža praktično znanje i veštine primenljive odmah nakon završetka kursa.
        </p>
      </div>

      <div class="pojava mt-10 grid sm:grid-cols-2 gap-8 border-t border-neutral-200 pt-8" style="--kasnjenje:0.15s">
        <div>
          <h3 class="font-serif text-[22px]">Tokom obuke naučićeš</h3>
          <ul class="mt-4 space-y-2.5 text-[14px] text-neutral-700">
            {
              naucices.map((s) => (
                <li class="flex items-center gap-3">
                  <Ikona ime="kvacica" class="w-4 h-4 shrink-0" debljina={2} />
                  {s}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-serif text-[22px]">Program uključuje</h3>
          <ul class="mt-4 space-y-2.5 text-[14px] text-neutral-700">
            {
              program.map((s) => (
                <li class="flex items-center gap-3">
                  <Ikona ime="kvacica" class="w-4 h-4 shrink-0" debljina={2} />
                  {s}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <blockquote class="pojava mt-10 border-l border-neutral-900 pl-6 font-serif text-[21px] md:text-[24px] leading-[1.45] text-neutral-800" style="--kasnjenje:0.2s">
        Verujem da kvalitetna edukacija nije samo učenje softvera, već razumevanje prostora, svetla, materijala i
        procesa rada koji stoji iza vrhunske vizualizacije.
      </blockquote>

      <div class="pojava mt-10 flex flex-wrap gap-3" style="--kasnjenje:0.25s">
        <button
          type="button"
          data-otvori-kontakt
          class="group inline-flex items-center gap-3 bg-neutral-900 px-8 py-4 text-[13px] font-medium text-white hover:bg-black transition-colors cursor-pointer"
        >
          Kontaktiraj nas
          <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </button>
        <a
          href={whatsappLink("Zdravo, imam pitanje u vezi kurseva Studio 27.")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 border border-neutral-900 px-8 py-4 text-[13px] font-medium hover:bg-neutral-900 hover:text-white transition-colors"
        >
          Piši nam na WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
