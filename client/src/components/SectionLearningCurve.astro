---
---

<section id="struktura" class="bg-white px-6 py-24 text-zinc-900 font-sans sm:px-8 lg:px-12 lg:py-32 border-t border-zinc-100">
  <div class="mx-auto max-w-7xl">
    
    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 md:mb-28 pb-8 border-b border-zinc-200">
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-[0.3em] text-[#550000] block mb-3">
          // Model učenja
        </span>
        <h2 class="text-4xl sm:text-5xl lg:text-7xl font-black tracking-tight text-zinc-900 uppercase leading-none">
          Kako izgleda <br class="hidden sm:block" />
          <span class="text-zinc-500">proces rada</span>
        </h2>
      </div>
      <p class="mt-6 md:mt-0 text-zinc-600 text-sm sm:text-base font-normal max-w-md leading-relaxed">
        Izaberite model koji se uklapa u vaš raspored — od potpuno samostalnog rada do direktnog rada sa mentorom.
      </p>
    </div>

    <!-- ASIMETRIČNI TIMELINE / REDIZAJN -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 relative">
      
      <!-- Srednja vertikalna linija za desktop -->
      <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-[1px] bg-zinc-200 -translate-x-1/2"></div>

      <!-- KOLONA 1: Samostalno -->
      <div class="space-y-12">
        <div class="flex items-center justify-between pb-4 border-b-2 border-zinc-900">
          <div class="flex items-center gap-3">
            <span class="text-xs font-mono font-bold text-white bg-zinc-900 px-2.5 py-1 rounded">01</span>
            <h3 class="text-2xl font-black tracking-wider uppercase text-zinc-900">Samostalno učenje</h3>
          </div>
          <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest font-semibold">Video format</span>
        </div>

        <div class="space-y-10 pl-2">
          {[ 
            { num: "01", title: "Instant pristup platformi", text: "Nakon prijave, kompletan video sadržaj sa lekcijama i resursima dostupan je odmah na vašem nalogu." },
            { num: "02", title: "Preuzimanje radnih materijala", text: "Kompletne scene, 3D modeli, teksture i podešavanja osvetljenja spremni su za rad i vežbu." },
            { num: "03", title: "Učenje po sopstvenom tempu", text: "Lekcije u visokoj rezoluciji gledate kada god želite, uz mogućnost neograničenog ponavljanja." },
            { num: "04", title: "Podrška i privatni chat", text: "Tokom prolaska kroz materijal, na raspolaganju vam je privatna komunikacija za pitanja i smernice." },
          ].map((step) => (
            <div class="relative pl-8 group">
              <!-- Tačka na liniji -->
              <span class="absolute left-0 top-1.5 w-2 h-2 rounded-full bg-zinc-400 group-hover:bg-[#550000] transition-colors"></span>
              
              <div class="flex items-baseline gap-3 mb-1">
                <span class="text-xs font-mono font-bold text-[#550000]">{step.num}.</span>
                <h4 class="text-lg font-bold text-zinc-900 tracking-tight">{step.title}</h4>
              </div>
              <p class="text-sm text-zinc-600 leading-relaxed font-normal">{step.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- KOLONA 2: Rad sa predavačem -->
      <div class="space-y-12">
        <div class="flex items-center justify-between pb-4 border-b-2 border-[#550000]">
          <div class="flex items-center gap-3">
            <span class="text-xs font-mono font-bold text-white bg-[#550000] px-2.5 py-1 rounded">02</span>
            <h3 class="text-2xl font-black tracking-wider uppercase text-zinc-900">Mentorski rad</h3>
          </div>
          <span class="text-xs font-mono text-[#550000] uppercase tracking-widest font-semibold">Uživo sesije</span>
        </div>

        <div class="space-y-10 pl-2">
          {[ 
            { num: "01", title: "Rezervacija mesta u grupi", text: "Odaberite dostupan termin. Rad se odvija u malim grupama radi maksimalne posvećenosti svakom polazniku." },
            { num: "02", title: "Interaktivna Zoom predavanja", text: "Časovi se održavaju uživo. Direktno postavljate pitanja i prolazite kroz rad u realnom vremenu." },
            { num: "03", title: "Arhiva svih snimaka", text: "Svaki održani čas se automatski snima i stoji vam na raspolaganju za naknadno obnavljanje gradiva." },
            { num: "04", title: "Korekcije i analiza rendera", text: "Detaljna analiza vaših radova — od kadra i osvetljenja do finih podešavanja materijala i postprodukcije." },
          ].map((step) => (
            <div class="relative pl-8 group">
              <!-- Tačka na liniji -->
              <span class="absolute left-0 top-1.5 w-2 h-2 rounded-full bg-zinc-400 group-hover:bg-[#550000] transition-colors"></span>
              
              <div class="flex items-baseline gap-3 mb-1">
                <span class="text-xs font-mono font-bold text-[#550000]">{step.num}.</span>
                <h4 class="text-lg font-bold text-zinc-900 tracking-tight">{step.title}</h4>
              </div>
              <p class="text-sm text-zinc-600 leading-relaxed font-normal">{step.text}</p>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- DONJI DETALJ -->
    <div class="mt-20 pt-8 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500 font-medium">
      <span>27archviz // ARCHITECTURAL VISUALIZATION</span>
      <span>KURS 3DS MAX + CORONA RENDER</span>
    </div>

  </div>
</section>