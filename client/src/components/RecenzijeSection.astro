---

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

type Student = {
  ime: string;
  prezime: string;
};

type Rad = {
  idRad: number;
  idStudent: number;
  idKurs: number;
  slikaId: number;
  naziv: string;
  ime: string;
  prezime: string;
  url: string;
};

type Recenzija = {
  id: number;
  opis: string;
  ocena: number;
  datum: string;
  student: Student | null;
  kurs: {
    id: number;
    naziv: string;
    opis: string;
    slikaUrl: string;
  } | null;
  
};


let radovi: Rad[] = [];

try {
  const resRadovi = await fetch(`${API_URL}/api/radovi`);
  if (resRadovi.ok) {
    radovi = await resRadovi.json();
  }
} catch (e) {
  console.error("Greška pri učitavanju radova:", e);
}


let recenzije: Recenzija[] = [];

try {
  const resRec = await fetch(`${API_URL}/api/recenzije`);
  if (resRec.ok) {
    recenzije = await resRec.json();
  }
} catch (e) {
  console.error("Greška pri učitavanju recenzija:", e);
}

const radoviPrikaz = radovi.slice(0, 25);
const recenzijePrikaz = recenzije.slice(0, 6);


---

<section id="recenzije" class="bg-black">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="mb-32">
      <h3 class="rec-title text-3xl font-bold text-white/80 text-center mb-16">
        Pogledajte radove naših studenata
      </h3>
    </div>
  </div>

  <!-- Radovi - puna sirina -->
  <div class="w-full">
    <div class="p-0">
    {radoviPrikaz.length === 0 ? (
      <p class="text-center text-gray-500 text-lg">Nema dostupnih radova</p>
    ) : (
      <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-0">
        {radoviPrikaz.map((rad, idx) => {
          // Raznovrsne veličine za masonry efekat - veće slike
          const heights = ['h-[28rem]', 'h-96', 'h-[26rem]', 'h-[30rem]', 'h-80', 'h-72'];
          const height = heights[idx % heights.length];
          return (
          <a href="/radovi"
            class="group cursor-pointer overflow-hidden m-0 p-0 rad-item-animate block"
            style={`animation-delay: ${idx * 0.1}s`}
          >
            <img 
              src={`${API_URL}/api/uploaded-images${rad.url}`} 
              class={`w-full ${height} object-cover hover:scale-105 transition-transform duration-300 block`}
              loading="lazy"
            />
           
          </a>
          );
        })}
      </div>
    )}
</div>
  </div>

  <!-- Recenzije - normalna sirina -->
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="rec-subtitle text-center mb-20">
       <h4 class="rec-title text-3xl font-bold text-white/80 text-center mb-16">
        Pogledajte recenzije naših studenata
      </h4>

      <p class="text-gray-400 text-lg max-w-2xl mx-auto mt-4">
        Pročitajte iskustva polaznika koji su završili naše kurseve
      </p>
    </div>

    {
      recenzije.length === 0 ? (
        <p class="text-center text-gray-500 text-lg">
          Još uvek nema recenzija.
        </p>
      ) : (
        <div class="md:columns-2 lg:columns-3 gap-8 space-y-8">
          {recenzijePrikaz.map((recenzija, i) => {
            
           
            return (
              <div
                class="rec-card aspect-auto p-8 border border-gray-700 bg-white/10 text-white shadow-2xl shadow-gray-900/20 break-inside-avoid hover:border-gray-600 transition-all duration-800 block"
                style={`--rec-i:${i}`}
              >
                <div class="flex gap-4 mb-6">
                  
                  <div>
                    
                    {recenzija.kurs && (
                      <p class="kurs-naziv text-sm text-white uppercase">
                        {recenzija.kurs.naziv}
                      </p>
                    )}
                  </div>
                </div>

                <div class="flex gap-1 mb-4">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <svg
                      class={`w-4 h-4 ${star <= recenzija.ocena ? "text-yellow-400" : "text-gray-400"}`}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <p class="text-gray-200 leading-relaxed">
                  {recenzija.opis || "Bez komentara"}
                </p>
              </div>
            );
          })}
        </div>
      )
    }
  </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap');

  /* Section titles */
  .rec-title, .rec-subtitle {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .rec-title.is-visible, .rec-subtitle.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Student work cards - scale up reveal */
  .rad-card {
    opacity: 0;
    transform: scale(0.88);
    transition: opacity 0.7s ease-out, transform 0.7s cubic-bezier(0.25,0.46,0.45,0.94);
    transition-delay: calc(var(--rad-i) * 0.15s);
  }
  .rad-card.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  /* Rad items - staggered fade and scale animation */
  .rad-item-animate {
    animation: radItemFadeScale 0.6s ease-out forwards;
    animation-play-state: paused;
  }
  .rad-item-animate.is-visible {
    animation-play-state: running;
  }

  @keyframes radItemFadeScale {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Review cards - fade up stagger */
  .rec-card {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    transition-delay: calc(var(--rec-i) * 0.08s);
  }
  .rec-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Star rating shimmer on visible */
  .rec-card.is-visible .text-yellow-400 {
    animation: starPop 0.4s ease-out backwards;
  }
  .rec-card.is-visible svg:nth-child(1) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.08s + 0.1s); }
  .rec-card.is-visible svg:nth-child(2) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.08s + 0.15s); }
  .rec-card.is-visible svg:nth-child(3) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.08s + 0.2s); }
  .rec-card.is-visible svg:nth-child(4) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.08s + 0.25s); }
  .rec-card.is-visible svg:nth-child(5) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.08s + 0.3s); }

  @keyframes starPop {
    0% { transform: scale(0); opacity: 0; }
    70% { transform: scale(1.3); }
    100% { transform: scale(1); opacity: 1; }
  }

  /* Kurs naziv - Montserrat font */
  .kurs-naziv {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
</style>

<script>
  const recObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

  document.querySelectorAll('.rec-title, .rec-subtitle, .rad-card, .rec-card, .rad-item-animate').forEach(el => {
    recObserver.observe(el);
  });
</script>
