---

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

type Student = {
  ime: string;
  prezime: string;
};

type Rad = {
  idRad: number;
  idStudent: number;
  idKurs: number;
  slikaId: number;
  naziv: string;
  ime: string;
  prezime: string;
  url: string;
};

type Recenzija = {
  id: number;
  opis: string;
  ocena: number;
  datum: string;
  student: Student | null;
  kurs: {
    id: number;
    naziv: string;
    opis: string;
    slikaUrl: string;
  } | null;
  
};


let radovi: Rad[] = [];

try {
  const resRadovi = await fetch(`${API_URL}/api/radovi`);
  if (resRadovi.ok) {
    radovi = await resRadovi.json();
  }
} catch (e) {
  console.error("Greška pri učitavanju radova:", e);
}


let recenzije: Recenzija[] = [];

try {
  const resRec = await fetch(`${API_URL}/api/recenzije`);
  if (resRec.ok) {
    recenzije = await resRec.json();
  }
} catch (e) {
  console.error("Greška pri učitavanju recenzija:", e);
}

const radoviPrikaz = radovi.slice(0, 30);
const recenzijePrikaz = recenzije.slice(0, 6);


---

<section id="recenzije" class="bg-black relative overflow-hidden">
  <!-- Premium animated background -->
  <div class="absolute inset-0 opacity-50">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-red-900/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-red-800/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 right-0 w-80 h-80 bg-red-700/5 rounded-full blur-2xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>

 

  <!-- Radovi - puna sirina -->
  <div class="w-full relative z-10">
    <div class="p-0">
    {radoviPrikaz.length === 0 ? (
      <p class="text-center text-gray-500 text-lg">Nema dostupnih radova</p>
    ) : (
      <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-0">
        {radoviPrikaz.map((rad, idx) => {
          // Raznovrsne veličine za masonry efekat - veće slike
          const heights = ['h-[28rem]', 'h-96', 'h-[26rem]', 'h-[30rem]', 'h-80', 'h-72'];
          const height = heights[idx % heights.length];
          return (
          <a href="/radovi"
            class="group cursor-pointer overflow-hidden m-0 p-0 rad-item-animate block relative"
            style={`animation-delay: ${idx * 0.1}s`}
          >
            <!-- Overlay glow on hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-white/0 via-transparent to-white/0 group-hover:from-white/20 group-hover:to-white/30 transition-all duration-500 pointer-events-none z-10"></div>
            
            <img 
              src={`${API_URL}/api/uploaded-images${rad.url}`} 
              class={`w-full ${height} object-cover group-hover:scale-110 transition-transform duration-500 block`}
              loading="lazy"
            />
           
          </a>
          );
        })}
      </div>
    )}
</div>
  </div>

  <!-- Recenzije - normalna sirina -->
  <div class="max-w-7xl mx-auto px-4 py-24 relative z-10">
    <div class="rec-subtitle text-center mb-24">
       <h4 class="rec-title text-3xl md:text-4xl font-bold text-white/80 text-center mb-6">
        Recenzije naših studenata
      </h4>

      <p class="text-gray-400 text-lg max-w-2xl mx-auto mt-4">
        Pročitajte iskustva polaznika koji su završili naše kurseve
      </p>

      <!-- Animated line separator -->
      <div class="flex justify-center mt-8">
        <div class="h-1 w-20 bg-gradient-to-r from-transparent via-red-600 to-transparent animate-pulse"></div>
      </div>
    </div>

    {
      recenzije.length === 0 ? (
        <p class="text-center text-gray-500 text-lg">
          Još uvek nema recenzija.
        </p>
      ) : (
        <div class="md:columns-2 lg:columns-3 gap-8 space-y-8">
          {recenzijePrikaz.map((recenzija, i) => {
            
           
            return (
              <div
                class="rec-card aspect-auto p-8 border border-gray-700 bg-gradient-to-br from-gray-900/40 to-gray-950/20 text-white shadow-2xl shadow-red-900/10 break-inside-avoid hover:border-red-700/50 transition-all duration-500 block relative group overflow-hidden"
                style={`--rec-i:${i}`}
              >
                <!-- Animated background shine effect -->
                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-r from-transparent via-red-500/10 to-transparent -skew-x-12" style="animation: shimmer 3s infinite;"></div>

                <!-- Glowing border on hover -->
                <div class="absolute inset-0 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-500 border border-red-600/30 shadow-lg shadow-red-600/20" style="animation: glow 2s ease-in-out infinite;"></div>

                <div class="relative z-10">
                  <div class="flex gap-4 mb-6">
                    <div>
                      {recenzija.kurs && (
                        <p class="kurs-naziv text-xs text-red-500/80 uppercase mt-2 group-hover:text-red-400 transition-colors duration-300">
                          {recenzija.kurs.naziv}
                        </p>
                      )}
                    </div>
                  </div>

                  <div class="flex gap-1 mb-6">
                    {[1, 2, 3, 4, 5].map((star) => (
                      <svg
                        class={`w-5 h-5 transition-transform duration-300 group-hover:scale-110 ${star <= recenzija.ocena ? "text-yellow-400 drop-shadow-lg drop-shadow-yellow-400/50" : "text-gray-600"}`}
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>

                  <p class="text-gray-300 leading-relaxed text-sm group-hover:text-gray-100 transition-colors duration-300">
                    "{recenzija.opis || "Bez komentara"}"
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap');

  /* Premium background animation */
  @keyframes gradientShift {
    0%, 100% { filter: blur(40px); opacity: 0.5; }
    50% { filter: blur(60px); opacity: 0.7; }
  }

  /* Shimmer effect */
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* Glow effect on cards */
  @keyframes glow {
    0%, 100% { box-shadow: 0 0 10px rgba(220, 38, 38, 0.3), inset 0 0 10px rgba(220, 38, 38, 0.1); }
    50% { box-shadow: 0 0 20px rgba(220, 38, 38, 0.5), inset 0 0 20px rgba(220, 38, 38, 0.2); }
  }

  /* Section titles */
  .rec-title, .rec-subtitle {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .rec-title.is-visible, .rec-subtitle.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Rad items - PREMIUM staggered fade and scale animation */
  .rad-item-animate {
    animation: radItemFadeScale 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-play-state: paused;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
  }

  /* Premium shimmer effect */
  .rad-item-animate::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    opacity: 0;
    z-index: 10;
    pointer-events: none;
  }

  .rad-item-animate:hover::before {
    animation: shimmerShine 0.6s ease-in-out;
  }

  @keyframes shimmerShine {
    0% {
      left: -100%;
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  /* Glow border effect */
  .rad-item-animate::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.1));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .rad-item-animate:hover::after {
    opacity: 1;
  }

  .rad-item-animate.is-visible {
    animation-play-state: running;
  }

  .rad-item-animate:hover img {
    animation: imageGlow 0.5s ease-in-out;
    filter: brightness(1.15) saturate(1.2);
  }

  @keyframes imageGlow {
    0% {
      transform: scale(1);
      filter: brightness(1) saturate(1);
    }
    50% {
      transform: scale(1.02);
      filter: brightness(1.2) saturate(1.3) drop-shadow(0 0 15px rgba(255, 255, 255, 0.5));
    }
    100% {
      transform: scale(1.05);
      filter: brightness(1.15) saturate(1.2) drop-shadow(0 0 20px rgba(255, 255, 255, 0.4));
    }
  }

  @keyframes radItemFadeScale {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(15px);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
  }

  /* Review cards - fade up stagger with blur */
  .rec-card {
    opacity: 0;
    transform: translateY(30px) scale(0.98);
    transition: opacity 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), backdrop-filter 0.4s ease-out;
    transition-delay: calc(var(--rec-i) * 0.05s);
    backdrop-filter: blur(10px);
  }
  .rec-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .rec-card:hover {
    backdrop-filter: blur(20px);
    box-shadow: 0 15px 30px -5px rgba(220, 38, 38, 0.2);
  }

  /* Star rating animation */
  .rec-card .flex.gap-1 svg {
    transition: transform 0.3s ease-out, filter 0.3s ease-out;
  }
  .rec-card:hover .flex.gap-1 .text-yellow-400 {
    animation: starBounce 0.5s ease-out infinite;
    filter: drop-shadow(0 0 4px rgba(250, 204, 21, 0.6));
  }

  @keyframes starBounce {
    0%, 100% { transform: scale(1) translateY(0); }
    50% { transform: scale(1.15) translateY(-3px); }
  }

  /* Kurs naziv - Montserrat font */
  .kurs-naziv {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  /* Blur backgrounds */
  @supports (backdrop-filter: blur(10px)) {
    .rec-card {
      background: rgba(15, 15, 15, 0.4);
      backdrop-filter: blur(10px);
    }
    .rec-card:hover {
      background: rgba(15, 15, 15, 0.6);
      backdrop-filter: blur(20px);
    }
  }

  /* Smooth line animation */
  .h-1.w-20 {
    animation: lineExpand 2s ease-in-out infinite;
  }

  @keyframes lineExpand {
    0%, 100% { width: 5rem; opacity: 0.5; }
    50% { width: 8rem; opacity: 1; }
  }
</style>

<script>
  const recObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

  // Observe all animated elements
  document.querySelectorAll('.rec-title, .rec-subtitle, .rad-item-animate, .rec-card').forEach(el => {
    recObserver.observe(el);
  });

  // 3D Parallax effect na recenzijama
  document.querySelectorAll('.rec-card').forEach((card) => {
    const htmlCard = card as HTMLElement;
    
    htmlCard.addEventListener('mousemove', (e) => {
      const rect = htmlCard.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      
      // Dinamična ali oštra rotacija samo za karticu preko koje je miš
      const rotateX = (y - 0.5) * -12; 
      const rotateY = (x - 0.5) * 12;
      
      // Ukidamo CSS transition dok miš pomera jer on stvara taj "lag" ("mlitavost")
      htmlCard.style.transition = 'none';
      htmlCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-5px) scale3d(1.02, 1.02, 1.02)`;
    });

    htmlCard.addEventListener('mouseleave', () => {
      // Vraćamo smooth transition samo za povratak u početno stanje
      htmlCard.style.transition = 'transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), backdrop-filter 0.4s ease-out';
      htmlCard.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0) scale3d(1, 1, 1)';
    });
  });
</script>
