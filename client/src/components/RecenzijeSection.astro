---
const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

type Student = {
  ime: string;
  prezime: string;
};

type Rad = {
  idRad: number;
  idStudent: number;
  idKurs: number;
  slikaId: number;
  naziv: string;
  ime: string;
  prezime: string;
  url: string;
};

type Recenzija = {
  id: number;
  opis: string;
  ocena: number;
  datum: string;
  student: Student | null;
  kurs: {
    id: number;
    naziv: string;
    opis: string;
    slikaUrl: string;
  } | null;
  
};


let radovi: Rad[] = [];

try {
  const resRadovi = await fetch(`${API_URL}/api/radovi`);
  if (resRadovi.ok) {
    radovi = await resRadovi.json();
  }
} catch (e) {
  console.error("Greška pri učitavanju radova:", e);
}


let recenzije: Recenzija[] = [];

try {
  const resRec = await fetch(`${API_URL}/api/recenzije`);
  if (resRec.ok) {
    recenzije = await resRec.json();
  }
} catch (e) {
  console.error("Greška pri učitavanju recenzija:", e);
}

const radoviPrikaz = radovi.slice(0, 15);
const recenzijePrikaz = recenzije.slice(0, 6);


---

<section id="recenzije" class="py-16 px-4 bg-black">
  <div class="max-w-7xl mx-auto">
    <div class="mb-32">
      <h3 class="rec-title text-3xl font-bold text-white text-center mb-16">
        Pogledajte radove naših studenata
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12">
        {
          radoviPrikaz.map((rad, i) => (
            <article class="rad-card relative isolate flex flex-col justify-end overflow-hidden rounded-2xl h-[450px] group" style={`--rad-i:${i}`}>
              <img
                src={`${API_URL}/api/uploaded-images${rad.url}`}
                alt={rad.naziv}
                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black via-black/70 to-transparent" />
              <div class="absolute inset-0 flex flex-col items-center justify-center text-white text-center space-y-2">
                <h3 class="text-lg sm:text-xl md:text-2xl font-bold">
                  {rad.naziv}
                </h3>
             
      
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- ========================= -->
    <!-- RECENZIJE -->
    <!-- ========================= -->

    <div class="rec-subtitle text-center mb-20">\
       <h4 class="rec-title text-3xl font-bold text-white text-center mb-16">
        Pogledajte recenzije naših studenata
      </h4>

      <p class="text-gray-400 text-lg max-w-2xl mx-auto mt-4">
        Pročitajte iskustva polaznika koji su završili naše kurseve
      </p>
    </div>

    {
      recenzije.length === 0 ? (
        <p class="text-center text-gray-500 text-lg">
          Još uvek nema recenzija.
        </p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 space-y-6">
          {recenzijePrikaz.map((recenzija, i) => {
            const ime = recenzija.student
              ? `${recenzija.student.ime} ${recenzija.student.prezime}`
              : "Anonimni korisnik";

            const inicijali = recenzija.student
              ? `${recenzija.student.ime?.charAt(0) || ""}${recenzija.student.prezime?.charAt(0) || ""}`
              : "?";

            return (
              <div class="rec-card flex flex-col p-6 bg-gray-800 border border-gray-800 rounded-2xl shadow-lg break-inside-avoid hover:border-gray-700 transition-all duration-300" style={`--rec-i:${i}`}>
                <div class="flex gap-1 mb-4">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <svg
                      class={`w-5 h-5 ${star <= recenzija.ocena ? "text-yellow-400" : "text-gray-600"}`}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <p class="text-gray-300 leading-relaxed mb-6 flex-1">
                  {recenzija.opis || "Bez komentara"}
                </p>

                <div class="flex items-center gap-4 pt-4 border-t border-gray-800 mt-auto">
                  <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center text-black font-semibold text-sm">
                    {inicijali}
                  </div>
                  <div>
                    <h6 class="text-gray-200 font-medium text-sm">{ime}</h6>
                    {recenzija.kurs && (
                      <p class="text-gray-400 text-xs">
                        {recenzija.kurs.naziv}
                      </p>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Section titles */
  .rec-title, .rec-subtitle {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .rec-title.is-visible, .rec-subtitle.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Student work cards - scale up reveal */
  .rad-card {
    opacity: 0;
    transform: scale(0.88);
    transition: opacity 0.7s ease-out, transform 0.7s cubic-bezier(0.25,0.46,0.45,0.94);
    transition-delay: calc(var(--rad-i) * 0.15s);
  }
  .rad-card.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  /* Review cards - fade up stagger */
  .rec-card {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    transition-delay: calc(var(--rec-i) * 0.07s);
    height: 230px;
  }
  .rec-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Star rating shimmer on visible */
  .rec-card.is-visible .text-yellow-400 {
    animation: starPop 0.4s ease-out backwards;
  }
  .rec-card.is-visible .flex.gap-1 > :nth-child(1) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.07s + 0.1s); }
  .rec-card.is-visible .flex.gap-1 > :nth-child(2) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.07s + 0.15s); }
  .rec-card.is-visible .flex.gap-1 > :nth-child(3) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.07s + 0.2s); }
  .rec-card.is-visible .flex.gap-1 > :nth-child(4) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.07s + 0.25s); }
  .rec-card.is-visible .flex.gap-1 > :nth-child(5) .text-yellow-400 { animation-delay: calc(var(--rec-i) * 0.07s + 0.3s); }

  @keyframes starPop {
    0% { transform: scale(0); opacity: 0; }
    70% { transform: scale(1.3); }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  const recObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

  document.querySelectorAll('.rec-title, .rec-subtitle, .rad-card, .rec-card').forEach(el => {
    recObserver.observe(el);
  });
</script>
