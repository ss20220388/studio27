---
const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

type Student = { ime: string; prezime: string; };

type Rad = {
  idRad: number; idStudent: number; idKurs: number; slikaId: number;
  naziv: string; ime: string; prezime: string; url: string;
};

type Recenzija = {
  id: number; opis: string; ocena: number; datum: string;
  student: Student | null;
  kurs: { id: number; naziv: string; opis: string; slikaUrl: string; } | null;
};

let radovi: Rad[] = [];
try {
  const res = await fetch(`${API_URL}/api/radovi-sa-rasporedom`);
  if (res.ok) radovi = await res.json();
} catch (e) { console.error("Greška radovi:", e); }

let recenzije: Recenzija[] = [];
try {
  const res = await fetch(`${API_URL}/api/recenzije`);
  if (res.ok) recenzije = await res.json();
} catch (e) { console.error("Greška recenzije:", e); }

// Uzimamo sve radove u grupama po 5 (npr. 15, 20, 25...)
const count = Math.floor(radovi.length / 5) * 5;
let radoviPrikaz = radovi.slice(0, count);

const countrec = Math.floor(recenzije.length / 3) * 3;
recenzije = recenzije.slice(0, countrec);
---

<!-- CRNO ZAGLAVLJE SA NASLOVOM -->
<section class="bg-[#18181b] pt-20 pb-12 text-center border-b border-zinc-800">
  <div class="max-w-4xl mx-auto px-6 space-y-3">
    <p class="text-xs md:text-sm font-semibold tracking-[0.2em] text-zinc-400 uppercase">
      Galerija & Iskustva
    </p>
    <h2 class="text-4xl md:text-6xl font-black text-white tracking-tight">
      RADOVI NAŠIH STUDENATA
    </h2>
  </div>
</section>

<main id="recenzije" class="bg-white text-black font-sans pb-24">
  
  <!-- GRID RADOVA (5 KOLONA, VERTIKALNE SLIKE BEZ GAP-A) -->
  <div class="w-full mb-24">
    {radoviPrikaz.length === 0 ? (
      <p class="py-12 text-center text-lg text-zinc-500">Nema dostupnih radova</p>
    ) : (
      <!-- Postavljamo grid: 1 kolona mob, 2 sm, 3 md, 5 lg. Bez razmaka (gap-0) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-0 w-full">
        {radoviPrikaz.map((rad) => (
          <a
            aria-label={`Pogledajte rad: ${rad.naziv}`}
            href="/radovi"
           
            class="group relative block aspect-[2/3] w-full cursor-pointer overflow-hidden bg-zinc-100"
          >
            <img
              src={`${API_URL}/api/uploaded-images${rad.url}`}
              
              class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              alt={rad.naziv || "Rad studenta"}
            />
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- SEKCIJA SA UTISCIMA (GRID) -->
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- NASLOV RECENZIJA -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <h3 class="text-3xl md:text-5xl font-black text-black tracking-tight">
        UTISCI POLAZNIKA
      </h3>
      <p class="text-zinc-600 text-sm md:text-base">
        Iskustva studenata koji su završili naše kurseve.
      </p>
    </div>

    {recenzije.length === 0 ? (
      <p class="text-zinc-500 text-center text-lg py-8">Još uvek nema recenzija.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recenzije.map((recenzija) => {
          const kursNaziv = recenzija.kurs?.naziv || "KURS 3DS MAX + CORONA RENDER";

          return (
            <div class="flex flex-col justify-between bg-zinc-50/50 border border-zinc-200/80 rounded-2xl p-8 transition-all duration-300 hover:border-zinc-400 hover:shadow-lg hover:-translate-y-0.5">
              
              <div class="space-y-5">
                <!-- ZVEZDICE (5/5) -->
                <div class="flex items-center gap-1.5 text-amber-500">
                  {Array.from({ length: recenzija.ocena || 5 }).map((_) => (
                    <svg class="w-5 h-5 fill-current drop-shadow-sm" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <!-- TEKST RECENZIJE -->
                <p class="text-zinc-700 text-sm md:text-base leading-relaxed font-normal italic">
                  {recenzija.opis || "Odličan kurs, sve preporuke!"}
                </p>
              </div>

              <!-- DNO KARTICE -->
              <div class="pt-6 mt-8 border-t border-zinc-200/60 flex items-center">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-zinc-200 text-zinc-900 shadow-sm">
                  <span class="w-2 h-2 rounded-full bg-black"></span>
                  <span class="text-xs font-bold tracking-wider uppercase">
                    {kursNaziv}
                  </span>
                </div>
              </div>

            </div>
          );
        })}
      </div>
    )}

  </div>
</main>