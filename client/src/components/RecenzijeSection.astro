---
const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

type Student = { ime: string; prezime: string; };

type Rad = {
  idRad: number; idStudent: number; idKurs: number; slikaId: number;
  naziv: string; ime: string; prezime: string; url: string;
};

type Recenzija = {
  id: number; opis: string; ocena: number; datum: string;
  student: Student | null;
  kurs: { id: number; naziv: string; opis: string; slikaUrl: string; } | null;
};

let radovi: Rad[] = [];
try {
  const res = await fetch(`${API_URL}/api/radovi`);
  if (res.ok) radovi = await res.json();
} catch (e) { console.error("Greška radovi:", e); }

let recenzije: Recenzija[] = [];
try {
  const res = await fetch(`${API_URL}/api/recenzije`);
  if (res.ok) recenzije = await res.json();
} catch (e) { console.error("Greška recenzije:", e); }

const count = Math.floor(radovi.length / 4) * 4;
const radoviPrikaz = radovi.slice(0, count);
---

<main id="recenzije" class="bg-white py-16 text-black font-sans">
  
  <!-- GRID RADOVA -->
  <div class="w-full mb-20">
    {radoviPrikaz.length === 0 ? (
      <p class="py-12 text-center text-lg text-zinc-500">Nema dostupnih radova</p>
    ) : (
      <div class="grid grid-cols-1 gap-0 sm:grid-cols-2 md:grid-cols-4">
        {radoviPrikaz.map((rad) => (
          <a
            aria-label={`Pogledajte rad: ${rad.naziv} od studenta ${rad.ime} ${rad.prezime}`}
            href="/radovi"
            class="group relative block aspect-square w-full cursor-pointer overflow-hidden"
          >
            <img
              src={`${API_URL}/api/uploaded-images/${rad.url}`}
              class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              alt={`Rad studenta ${rad.ime} ${rad.prezime}`}
            />
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- SLIDER RECENZIJA -->
  <div class="max-w-6xl mx-auto px-6 relative">
    
    <!-- NASLOV -->
    <h2 class="text-5xl md:text-6xl font-black text-black tracking-tight mb-16">
      Student Reviews
    </h2>

    {recenzije.length === 0 ? (
      <p class="text-zinc-500 text-lg py-8">Još uvek nema recenzija.</p>
    ) : (
      <div class="relative min-h-[220px]">
        <!-- NAVIGACIJA - STRELICE -->
        <button
          id="prev-btn"
          type="button"
          aria-label="Prethodna recenzija"
          class="absolute -left-12 top-1/2 -translate-y-1/2 text-black hover:opacity-60 transition-opacity p-2 hidden md:block cursor-pointer"
        >
          <svg class="w-8 h-8 stroke-[1.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          id="next-btn"
          type="button"
          aria-label="Sledeća recenzija"
          class="absolute -right-6 md:-right-12 top-1/2 -translate-y-1/2 text-black hover:opacity-60 transition-opacity p-2 cursor-pointer"
        >
          <svg class="w-8 h-8 stroke-[1.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- SLAJDOVI -->
        <div id="reviews-container" class="relative">
          {recenzije.map((recenzija, index) => {
            const studentIme = recenzija.student 
              ? `${recenzija.student.ime} ${recenzija.student.prezime}`.trim()
              : "Student";
            
            const kursNaziv = recenzija.kurs?.naziv || "Polaznik kursa";

            return (
              <div
                class={`review-slide transition-opacity duration-300 ${index === 0 ? "block opacity-100" : "hidden opacity-0"}`}
                data-index={index}
              >
                <div class="flex flex-col md:flex-row items-start gap-8 pr-8 md:pr-12">
                  
                  <!-- AVATAR -->
                  <div class="w-24 h-24 md:w-28 md:h-28 rounded-full overflow-hidden flex-shrink-0 bg-zinc-100 border border-zinc-200">
                    <img
                      src={`${API_URL}/api/uploaded-images/towebp/vanjak11.webp`}
                      alt={studentIme}
                      class="w-full h-full object-cover"
                    />
                  </div>

                  <!-- TEKST RECENZIJE -->
                  <div class="flex-1 space-y-6 pt-1">
                    <p class="text-zinc-700 text-sm md:text-base leading-relaxed max-w-3xl font-normal">
                      {recenzija.opis || "Nema teksta recenzije."}
                    </p>

                    <div>
                      <p class="font-bold text-black text-base md:text-lg tracking-wide">
                        {studentIme}
                      </p>
                      <p class="text-zinc-600 text-xs md:text-sm font-medium">
                        {kursNaziv}
                      </p>
                    </div>
                  </div>

                </div>
              </div>
            );
          })}
        </div>

        <!-- TAČKICE (PAGINATION DOTS) WITH WCAG ACCESSIBILITY -->
        <div class="flex justify-center items-center gap-3 mt-12">
          {recenzije.map((_, idx) => (
            <button
              type="button"
              class={`dot-btn relative w-3 h-3 rounded-full transition-all cursor-pointer p-1.5 border border-transparent ${idx === 0 ? "bg-black scale-110" : "bg-zinc-600 hover:bg-zinc-900"}`}
              data-dot-index={idx}
              aria-label={`Prikaži recenziju ${idx + 1}`}
            />
          ))}
        </div>

      </div>
    )}

  </div>
</main>

<script>
  let currentIndex = 0;
  const slides = document.querySelectorAll('.review-slide');
  const dots = document.querySelectorAll('.dot-btn');
  const totalSlides = slides.length;

  function showSlide(index: number) {
    if (totalSlides === 0) return;
    
    // Normalizacija indeksa
    if (index >= totalSlides) currentIndex = 0;
    else if (index < 0) currentIndex = totalSlides - 1;
    else currentIndex = index;

    slides.forEach((slide, i) => {
      if (i === currentIndex) {
        slide.classList.remove('hidden');
        setTimeout(() => slide.classList.add('opacity-100'), 10);
      } else {
        slide.classList.remove('opacity-100');
        slide.classList.add('hidden');
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentIndex) {
        dot.classList.remove('bg-zinc-600', 'hover:bg-zinc-900');
        dot.classList.add('bg-black', 'scale-110');
      } else {
        dot.classList.remove('bg-black', 'scale-110');
        dot.classList.add('bg-zinc-600', 'hover:bg-zinc-900');
      }
    });
  }

  document.getElementById('next-btn')?.addEventListener('click', () => {
    showSlide(currentIndex + 1);
  });

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    showSlide(currentIndex - 1);
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.getAttribute('data-dot-index') || '0', 10);
      showSlide(idx);
    });
  });
</script>