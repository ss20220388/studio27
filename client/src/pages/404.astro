---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Stranica nije pronađena" description="Stranica koju tražite ne postoji.">
  <main class="min-h-[70vh] flex flex-col items-center justify-center px-4 text-center">
    <h1 class="text-9xl font-bold text-gray-800 mb-4">404</h1>
    <h2 class="text-3xl font-semibold text-gray-700 mb-6">Stranica nije pronađena</h2>
    <p class="text-lg text-gray-600 mb-8 max-w-md">
      Izgleda da stranica koju tražite ne postoji, premeštena je ili je privremeno nedostupna.
    </p>
    <a 
      href="/" 
      class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors duration-300"
    >
      Vrati se na početnu
    </a>
  </main>
</Layout>
