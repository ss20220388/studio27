---
const orderId = Astro.url.searchParams.get("orderId");
const reason = Astro.url.searchParams.get("reason");
import "../../styles/global.css";
---

<!doctype html>
<html lang="sr">
<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <meta
        name="robots"
        content="noindex, nofollow"
    />

    <title>Neuspešno plaćanje | Studio 27</title>
</head>

<body class="min-h-screen bg-slate-50 text-slate-900">

    <main class="flex min-h-screen items-center justify-center px-4 py-12">

        <div class="w-full max-w-lg">

            <!-- CARD -->
            <div
                class="rounded-3xl bg-white p-8 text-center shadow-xl shadow-slate-200/60 sm:p-10"
            >

                <!-- FAILURE ICON -->
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-rose-100">
                    <svg
                        class="h-10 w-10 text-rose-600"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </div>

                <!-- TITLE -->
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    Plaćanje nije uspelo
                </h1>

                <!-- DESCRIPTION -->
                <p class="mt-4 text-base leading-7 text-slate-600">
                    Nažalost, došla je do greške prilikom obrade vaše transakcije. Vaša kartica nije zadužena ili je transakcija otkazana.
                </p>

                <!-- ORDER ID -->
                {orderId && (
                    <div class="mt-7 rounded-2xl bg-slate-50 px-5 py-4">
                        <p class="text-sm text-slate-500">
                            Broj pokušane porudžbine
                        </p>

                        <p class="mt-1 break-all font-mono text-base font-semibold text-slate-900">
                            {orderId}
                        </p>
                    </div>
                )}

                <!-- INFO BOX -->
                <div class="mt-6 rounded-2xl border border-rose-100 bg-rose-50/50 px-5 py-4 text-left">
                    <div class="flex gap-3">
                        <svg
                            class="mt-0.5 h-5 w-5 shrink-0 text-rose-600"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>

                        <p class="text-sm leading-6 text-rose-900">
                            Proverite stanje na računu, ispravnost unetih podataka sa kartice ili pokušajte sa drugom karticom. Ako se problem nastavi, kontaktirajte vašu banku.
                        </p>
                    </div>
                </div>

                <!-- BUTTONS -->
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">

                    <a
                        href="/"
                        class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 transition hover:bg-slate-50"
                    >
                        Početna strana
                    </a>

                </div>

            </div>

            <!-- FOOTER -->
            <p class="mt-6 text-center text-sm text-slate-400">
                Studio 27
            </p>

        </div>

    </main>

</body>
</html>