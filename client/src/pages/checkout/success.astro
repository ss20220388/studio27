---
const orderId = Astro.url.searchParams.get("orderId");
import "../../styles/global.css";
---

<!doctype html>
<html lang="sr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Uspešno plaćanje | Studio 27</title>
</head>

<body class="min-h-screen bg-slate-50 text-slate-900">

    <main class="flex min-h-screen items-center justify-center px-4 py-12">

        <div class="w-full max-w-lg">

            <!-- CARD -->
            <div class="rounded-3xl bg-white p-8 text-center shadow-xl shadow-slate-200/60 sm:p-10">

                <!-- SUCCESS ICON -->
                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-emerald-100">
                    <svg
                        class="h-10 w-10 text-emerald-600"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                </div>

                <!-- TITLE -->
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    Plaćanje je uspešno!
                </h1>

                <!-- DESCRIPTION -->
                <p class="mt-4 text-base leading-7 text-slate-600">
                    Hvala vam na kupovini. Vaša uplata je uspešno prosleđena i vaša porudžbina je obrađena.
                </p>

                <!-- ORDER ID -->
                {orderId && (
                    <div class="mt-7 rounded-2xl bg-slate-50 px-5 py-4">
                        <p class="text-sm text-slate-500">
                            Broj porudžbine
                        </p>

                        <p class="mt-1 break-all font-mono text-base font-semibold text-slate-900">
                            {orderId}
                        </p>
                    </div>
                )}

                <!-- INFO -->
                <div class="mt-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 text-left">
                    <div class="flex gap-3">
                        <svg
                            class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 16v-4" />
                            <path d="M12 8h.01" />
                        </svg>

                        <p class="text-sm leading-6 text-emerald-800">
                            Nakon potvrde uplate, vaši kursevi će biti dostupni na vašem nalogu.
                        </p>
                    </div>
                </div>

                <!-- BUTTONS -->
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a
                        href="/"
                        class="inline-flex flex-1 items-center justify-center rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-slate-800"
                    >
                        Početna strana
                    </a>
                </div>

            </div>

            <!-- FOOTER -->
            <p class="mt-6 text-center text-sm text-slate-400">
                Studio 27
            </p>

        </div>

    </main>

</body>
</html>