---
import { intersection } from "astro:schema";
import Layout from "../layouts/Layout.astro";
import KursPlayer from "../react-components/KursPlayer.jsx";
import KursComponent from "../components/KursComponents.astro"

interface Kurs {
    id: number;
    naziv: string;
    opis: string;
    cena: number;
    trajanje: number;
    slikaUrl: string;
    glavniKurs: string;
    komentarDole: string;
    komentarSredina: string;
    komentarGore: string;
    
}
interface ResponseData {
    kursevi: Kurs[];
}

const data: Response = await fetch("http://localhost:8080/api/kursevi"); // SSR: server-side fetch

const kurseviRes: ResponseData = await data.json();
const kursevi = kurseviRes.kursevi;

const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch("http://api.studio27.rs/api/auth/me", {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();
---

<Layout title="Kursevi">
    <main class="p-8">
        <h1 class="text-3xl font-bold mb-8">Svi kursevi</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {kursevi?.map((kurs) => (
                <KursComponent client:idle  kurs={kurs} userId={userData.userId} accessToken={token} />
            ))}
        </div>
    </main>
</Layout>
