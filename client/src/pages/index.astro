---
import TreningSection from "../components/TreningSection.astro";
import Layout from "../layouts/Layout.astro";
import SectionLearningCurve from "../components/SectionLearningCurve.astro";
import KurseviSection from "../components/KurseviSection.astro";
import ONamaSection from "../components/ONamaSection.astro";
import RecenzijeSection from "../components/RecenzijeSection.astro";
import VelikeSlikeSection from "../components/VelikeSlikeSection.astro";
import Curve from "../components/Curve.astro";
import Hero from "../components/Hero.astro";
import AnimateSlika from "../components/AnimateSlika.astro";
---

<Layout
    title="Pocetna| 27 archviz"
    description="Želiš fotorealistične rendere? Upiši online kurs za 3ds Max i Corona Render. Nauči 3D modelovanje, osvetljenje i archviz od nule uz podršku mentora."
    canonicalURL="https://27archviz.com"
    breadcrumbs={[
        { name: "Kursevi", url: "https://27archviz.com/kurs" },
        { name: "3ds Max kurs", url: "https://27archviz.com/3ds-max-kurs" },
    ]}
    course={{
        name: "Kurs Arhitektonske Vizuelizacije – 3ds Max & Corona Render",
        description:
            "Sveobuhvatna profesionalna obuka za archviz. Obuhvata napredno 3D modelovanje u 3ds Max-u, kreiranje materijala i fotorealistično renderovanje u Corona Renderu, kao i finalnu postprodukciju u Photoshopu.",
        url: "https://27archviz.com/3ds-max-kurs",
        provider: "Studio 27",
        educationalLevel: "Beginner to Advanced",
        courseMode: "online",
    }}
    faq={[
        {
            question: "Šta se sve uči na kursu arhitektonske vizuelizacije?",
            answer: "Proces je kompletan: od uvoza AutoCAD crteža, preko preciznog 3D modelovanja u 3ds Max-u, postavljanja Corona svetala i materijala, pa sve do finalnog doterivanja rendera u Photoshopu.",
        },
        {
            question: "Da li dobijam podršku tokom trajanja obuke?",
            answer: "Da, iako je kurs online i predavanja su snimljena unapred kako biste učili svojim tempom, obezbeđena je direktna mentorska podrška za sve nedoumice i pregled vaših radova.",
        },
        {
            question: "Kome je namenjen ovaj 3D kurs?",
            answer: "Namenjen je arhitektama, dizajnerima enterijera, studentima i svima koji žele da savladaju profesionalni archviz i podignu svoje rendere na fotorealističan nivo.",
        },
    ]}
>
    <h1 class="sr-only">
        Kurs Arhitektonske Vizuelizacije – 3ds Max & Corona Render
    </h1>

    <KurseviSection />
    <AnimateSlika />

    <SectionLearningCurve />
    <VelikeSlikeSection />
    <RecenzijeSection />
    <ONamaSection />
</Layout>
