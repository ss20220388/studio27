---
import Layout from "../layouts/Layout.astro";
import ONamaSection from "../components/ONamaSection.astro";
import Zaglavlje from "../components/novo/Zaglavlje.astro";
import Hero from "../components/pocetna/Hero.astro";
import Kursevi from "../components/pocetna/Kursevi.astro";
import KvizPoziv from "../components/pocetna/KvizPoziv.astro";
import ZastoStudio from "../components/pocetna/ZastoStudio.astro";
import RadoviIUtisci from "../components/pocetna/RadoviIUtisci.astro";
import Pitanja from "../components/pocetna/Pitanja.astro";
import ZavrsniPoziv from "../components/pocetna/ZavrsniPoziv.astro";

import { CLIENT_URL, imaCenu, lepNaziv, slikaIzBaze, ucitajKurseve, ucitajSporedneSlike } from "../data/sajt";

const SITE_URL = CLIENT_URL;

// Svi kursevi i sve njihove slike dolaze iz baze (glavna slika + ostale slike kursa)
const kursevi = await ucitajKurseve();
const sporedne = await Promise.all(kursevi.map((k) => ucitajSporedneSlike(k.id)));

// Slajdovi: za svaki kurs prva od ostalih slika (veće su), a ako ih nema, glavna slika
const slajdovi = kursevi.map((k, i) => ({
  id: k.id,
  naziv: lepNaziv(k.naziv),
  oznaka: k.glavniKurs || "",
  slika: sporedne[i][0] || slikaIzBaze(k.slikaUrl),
}));

// Ostale slike svih kurseva, naizmenično po kursu, za sekcije bez posebnog kursa
const sveSporedne: string[] = [];
for (let r = 0; r < Math.max(0, ...sporedne.map((s) => s.length)); r++) {
  sporedne.forEach((s) => s[r + 1] && sveSporedne.push(s[r + 1]));
}
const seoSlika = slajdovi[0]?.slika || `${SITE_URL}/images/og-main.webp`;

const pitanja = [
  {
    question: "Da li mi je potrebno prethodno iskustvo?",
    answer:
      "Nije. Kursevi 3ds Max + Corona i dizajna enterijera kreću od samih osnova i vode te korak po korak do profesionalnog nivoa. Za kurs eksterijera je poželjno poznavanje osnova 3ds Max-a.",
  },
  {
    question: "Kakvi formati kurseva postoje?",
    answer:
      "Nudimo nasnimljene video kurseve sa neograničenim pristupom, vežbama i fajlovima za samostalno učenje, kao i nastavu uživo — individualno (1 na 1) ili u manjim grupama.",
  },
  {
    question: "Koliko dugo imam pristup kursu?",
    answer: "Pristup nasnimljenim kursevima je neograničen. Lekcije možeš gledati kad god ti odgovara i vraćati im se koliko god puta želiš.",
  },
  {
    question: "Da li dobijam podršku i feedback?",
    answer:
      "Da. Svi polaznici imaju podršku u privatnom chatu, feedback na svoje radove i odgovore na pitanja tokom i nakon kursa.",
  },
  {
    question: "Kako se plaća kurs i kada dobijam pristup?",
    answer:
      "Kurs možeš platiti karticom online ili uplatnicom. Nakon uspešne uplate kurs se pojavljuje u tvojoj web aplikaciji, gde odmah počinješ sa učenjem.",
  },
  {
    question: "Da li dobijam sertifikat?",
    answer: "Da, nakon uspešno završenog kursa i urađenog završnog zadatka dobijaš sertifikat Studio 27.",
  },
];

// Kursevi za Google (Course schema) – iz baze; cena samo ako je upisana u admin aplikaciji
const kurseviZaSeo = kursevi.map((k) => ({
  naziv: `${lepNaziv(k.naziv)}${k.glavniKurs ? ` – ${k.glavniKurs}` : ""}`,
  opis: (k.opis || k.komentarSredina || "").replace(/s+/g, " ").slice(0, 300).trim(),
  url: `${SITE_URL}/kurs/${k.id}`,
  cena: imaCenu(k) ? k.cena : null,
  uzivo: !!k.komentarGore?.toUpperCase().includes("UŽIVO"),
}));

const orgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `${SITE_URL}/#organization`,
      name: "Studio 27 – 27 archviz",
      alternateName: ["Studio 27", "27archviz"],
      url: SITE_URL,
      logo: `${SITE_URL}/favicon.svg`,
      image: seoSlika,
      description:
        "Škola arhitektonske vizualizacije i dizajna enterijera. Online i uživo kursevi 3ds Max, Corona Renderer, AutoCAD i Photoshop.",
      email: "studio27.vizz@gmail.com",
      telephone: "+381665934314",
      founder: { "@type": "Person", name: "Doroteja Dokić", jobTitle: "Dizajner enterijera i 3D vizualizator" },
      address: {
        "@type": "PostalAddress",
        streetAddress: "Aleksinačkih rudara 39E",
        postalCode: "11070",
        addressLocality: "Novi Beograd",
        addressCountry: "RS",
      },
      sameAs: ["https://www.instagram.com/studio27.visualization/"],
    },
    {
      "@type": "ItemList",
      name: "Kursevi Studio 27",
      itemListElement: kurseviZaSeo.map((k, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Course",
          name: k.naziv,
          description: k.opis,
          url: k.url,
          inLanguage: "sr",
          provider: { "@id": `${SITE_URL}/#organization` },
          ...(k.cena
            ? { offers: { "@type": "Offer", price: k.cena, priceCurrency: "EUR", category: "Paid", availability: "https://schema.org/InStock", url: k.url } }
            : {}),
          hasCourseInstance: { "@type": "CourseInstance", courseMode: k.uzivo ? "blended" : "online" },
        },
      })),
    },
  ],
};
---

<Layout
  title="Kursevi 3ds Max, Corona Render i dizajna enterijera | Studio 27"
  description="Studio 27 – škola arhitektonske vizualizacije. Online i uživo kursevi 3ds Max + Corona, vizualizacije eksterijera i dizajna enterijera (AutoCAD + Photoshop), uz podršku predavača."
  canonicalURL={`${SITE_URL}/`}
  image={seoSlika}
  imageAlt="Studio 27 – kursevi arhitektonske vizualizacije"
  keywords="kurs 3ds max, corona render kurs, kurs vizualizacije enterijera, kurs vizualizacije eksterijera, kurs dizajna enterijera, autocad kurs, arhitektonska vizualizacija, 3d vizualizacija kurs Srbija"
  faq={pitanja}
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <Zaglavlje slot="zaglavlje" preko />

  <main class="bg-white text-neutral-900">
    <Hero slajdovi={slajdovi} />
    <Kursevi kursevi={kursevi} />
    <KvizPoziv />
    <ZastoStudio slike={sveSporedne.slice(0, 2)} />
    <RadoviIUtisci />
    <ONamaSection />
    <Pitanja pitanja={pitanja} />
    <ZavrsniPoziv slika={sveSporedne[2] || sveSporedne[0]} />
  </main>
</Layout>
