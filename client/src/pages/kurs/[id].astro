    <!-- Uvećan prikaz slika -->
    <div id="s27-lightbox" class="fixed inset-0 z-[2000] hidden items-center justify-center bg-black/95 p-4 md:p-10" role="dialog" aria-modal="true" aria-label="Uvećana slika">
      <button type="button" data-lb-zatvori class="absolute top-5 right-5 w-12 h-12 flex items-center justify-center text-white/80 hover:text-white text-3xl cursor-pointer" aria-label="Zatvori">&times;</button>
      <button type="button" data-lb-nazad class="absolute left-3 md:left-8 top-1/2 -translate-y-1/2 w-12 h-12 border border-white/30 flex items-center justify-center text-white hover:bg-white hover:text-neutral-900 transition-colors cursor-pointer" aria-label="Prethodna slika">
        <Ikona ime="strelicaLevo" class="w-5 h-5" />
      </button>
      <img id="s27-lb-slika" alt="" class="max-h-[85vh] max-w-full object-contain" />
      <button type="button" data-lb-napred class="absolute right-3 md:right-8 top-1/2 -translate-y-1/2 w-12 h-12 border border-white/30 flex items-center justify-center text-white hover:bg-white hover:text-neutral-900 transition-colors cursor-pointer" aria-label="Sledeća slika">
        <Ikona ime="strelica" class="w-5 h-5" />
      </button>
    </div>
  </main>
</Layout>

<script>
  // Galerija: uvećan prikaz sa strelicama i tastaturom
  const slike = [...document.querySelectorAll<HTMLButtonElement>("[data-galerija-slika]")].map(
    (d) => d.querySelector("img")?.getAttribute("src") || "",
  );
  const lb = document.getElementById("s27-lightbox");
  const lbSlika = document.getElementById("s27-lb-slika") as HTMLImageElement | null;
  let trenutna = 0;
  const prikazi = (i: number) => {
    if (!lbSlika || slike.length === 0) return;
    trenutna = (i + slike.length) % slike.length;
    lbSlika.src = slike[trenutna];
  };
  const zatvori = () => {
    lb?.classList.add("hidden");
    lb?.classList.remove("flex");
    document.body.style.overflow = "";
  };
  document.querySelectorAll<HTMLButtonElement>("[data-galerija-slika]").forEach((d, i) =>
    d.addEventListener("click", () => {
      prikazi(i);
      lb?.classList.remove("hidden");
      lb?.classList.add("flex");
      document.body.style.overflow = "hidden";
    }),
  );
  lb?.querySelector("[data-lb-zatvori]")?.addEventListener("click", zatvori);
  lb?.querySelector("[data-lb-nazad]")?.addEventListener("click", () => prikazi(trenutna - 1));
  lb?.querySelector("[data-lb-napred]")?.addEventListener("click", () => prikazi(trenutna + 1));
  lb?.addEventListener("click", (e) => e.target === lb && zatvori());
  document.addEventListener("keydown", (e) => {
    if (!lb || lb.classList.contains("hidden")) return;
    if (e.key === "Escape") zatvori();
    if (e.key === "ArrowLeft") prikazi(trenutna - 1);
    if (e.key === "ArrowRight") prikazi(trenutna + 1);
  });
</script>
