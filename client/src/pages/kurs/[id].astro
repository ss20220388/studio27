---
// Stranica kursa po predlogu dizajna ("Nauči dizajn enterijera od početka").
// Raspored je isti za sve kurseve, a sav sadržaj se čita iz baze:
// naziv, glavniKurs, komentarGore (oznake), komentarSredina (uvod), opis, sadržaj (program),
// lekcije, cena, glavna i ostale slike, recenzije polaznika.
import Layout from "../../layouts/Layout.astro";
import Ikona from "../../components/novo/Ikona.astro";
import KupiDugme from "../../components/novo/KupiDugme.astro";
import {
  API_URL,
  CLIENT_URL,
  TELEFON,
  TELEFON_PRIKAZ,
  imaCenu,
  lepNaziv,
  parsirajSadrzaj,
  slikaIzBaze,
  ucitajKurseve,
  ucitajRadove,
  ucitajSporedneSlike,
  whatsappLink,
  type KursIzBaze,
  type RadPolaznika,
} from "../../data/sajt";

const { id } = Astro.params;
const refreshToken = Astro.cookies.get("refreshToken")?.value;

// Da li ulogovani korisnik već poseduje ovaj kurs (tada dugme vodi u web aplikaciju)
let kupljen = false;
if (refreshToken) {
  try {
    const authRes = await fetch(`${API_URL}/api/auth/me`, {
      headers: { Authorization: `Bearer ${refreshToken}` },
    });
    if (authRes.ok) {
      const korisnik = await authRes.json();
      if (korisnik?.userId) {
        const mojiRes = await fetch(`${API_URL}/api/moj-kursevi/${korisnik.userId}`, {
          headers: { Authorization: `Bearer ${refreshToken}` },
        });
        if (mojiRes.ok) {
          const moji = await mojiRes.json();
          const lista = Array.isArray(moji) ? moji : moji.kursevi || [];
          kupljen = lista.some((k: any) => String(k.id || k.kursId) === String(id));
        }
      }
    }
  } catch (e) {
    console.error("Greška pri proveri kupljenih kurseva:", e);
  }
}

type Recenzija = {
  opis: string;
  ocena: number;
  student: { ime?: string; prezime?: string } | null;
  kurs: { id?: number; naziv?: string } | null;
};

let kurs: KursIzBaze | null = null;
let sporedne: string[] = [];
let sveRecenzije: Recenzija[] = [];
let radovi: RadPolaznika[] = [];
try {
  const [kursRes, slike, recRes, sviRadovi] = await Promise.all([
    fetch(`${API_URL}/api/kursevi/${id}`),
    ucitajSporedneSlike(Number(id)),
    fetch(`${API_URL}/api/recenzije`).catch(() => null),
    ucitajRadove(),
  ]);
  if (kursRes.ok) kurs = await kursRes.json();
  sporedne = slike;
  if (recRes?.ok) sveRecenzije = await recRes.json();
  radovi = sviRadovi.filter((r) => String(r.idKurs) === String(id));
} catch (e) {
  console.error("Greška pri dohvatanju podataka o kursu:", e);
}

if (!kurs) {
  return Astro.redirect("/404");
}

// ---------- Podaci za prikaz ----------
const naslov = lepNaziv(kurs.naziv) || "Kurs";
const glavna = slikaIzBaze(kurs.slikaUrl);
const sveSlike = [glavna, ...sporedne].filter(Boolean);
const saCenom = imaCenu(kurs);
const pasusi = (tekst?: string) => (tekst || "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const uvod = pasusi(kurs.komentarSredina);
const opis = pasusi(kurs.opis);
const program = parsirajSadrzaj(kurs.sadrzaj);
const lekcije = kurs.lekcije || [];
const brojVidea = lekcije.reduce((zbir, l) => zbir + (l.videoUrls?.length || 0), 0);
const naUzivo = !!kurs.komentarGore?.toUpperCase().includes("UŽIVO");
const porukaZaWhatsApp = `Zdravo, imam pitanje u vezi kursa "${naslov}".`;
const recenica = (s: string) => lepNaziv(s.trim());

// Oznake iz baze ("ONLINE | UŽIVO | 1 NA 1 SA PREDAVAČEM | ILI U MANJIM GRUPAMA");
// deo koji počinje sa "ILI" se spaja sa prethodnim
const oznake = (kurs.komentarGore || "")
  .split("|")
  .map((s) => s.trim())
  .filter(Boolean)
  .reduce<string[]>((lista, o) => {
    if (/^ili\s/i.test(o) && lista.length) lista[lista.length - 1] += " " + o;
    else lista.push(o);
    return lista;
  }, []);

// Ikonica po ključnoj reči (ista linijska familija kao u predlogu)
function ikonaZa(tekst: string, i = 0) {
  const t = tekst.toLowerCase();
  const pravila: [RegExp, string][] = [
    [/greš/, "upozorenje"],
    [/autocad|photoshop|3ds|corona|softver|interfejs|program/, "laptop"],
    [/video|snim/, "monitorPlay"],
    [/pristup|neograni/, "beskonacno"],
    [/feedback|chat|konsult|pitanj|podršk/, "chat"],
    [/1 na 1|grup|predava|uživo/, "ljudi"],
    [/online/, "monitorPlay"],
    [/početn|nule|od 0/, "kapa"],
    [/boj/, "paleta"],
    [/stil|nameštaj|kuhinj/, "fotelja"],
    [/materijal|tekstur|bibliotek/, "slojevi"],
    [/rasvet|osvetlj|svetl/, "sijalica"],
    [/proces|podešav|engin|render/, "zupcanik"],
    [/razmišlj|brend|instagram|freelanc|prospekt/, "grafikon"],
    [/kadr|aksonometr/, "kamera"],
    [/vegetac|eksterijer|pejza/, "drvo"],
    [/noć|vod/, "sunce"],
    [/bonus|fajl|scen|model/, "folder"],
    [/prostor|modelov|deo/, "kocka"],
    [/projek|zadat|vežb/, "slika"],
  ];
  const nadjeno = pravila.find(([re]) => re.test(t));
  const rezerva = ["kocka", "paleta", "fotelja", "slojevi", "sijalica", "zupcanik", "grafikon", "kamera"];
  return nadjeno ? nadjeno[1] : rezerva[i % rezerva.length];
}

// Traka ispod naslovne slike: glavni softver + oznake iz baze (najviše 4)
const traka = [kurs.glavniKurs, ...oznake]
  .filter((s): s is string => !!s && !!s.trim())
  .slice(0, 4)
  .map((s, i) => ({ tekst: recenica(s), ikona: ikonaZa(s, i) }));

// "Šta ćeš naučiti?" – kartice iz polja "sadrzaj".
// Ako sadržaj ima samo jednu celinu sa spiskom, svaka stavka postaje kartica.
type Kartica = { naslov: string; opis?: string; stavke: string[] };
const kartice: Kartica[] =
  program.length === 1 && program[0].stavke.length >= 3
    ? program[0].stavke.map((s) => ({ naslov: s, stavke: [] }))
    : program.map((s) => {
        const jednaRecenica = s.stavke.length === 1 && s.stavke[0].length > 60;
        return {
          naslov: recenica(s.naslov),
          opis: jednaRecenica ? s.stavke[0] : undefined,
          stavke: jednaRecenica ? [] : s.stavke,
        };
      });
const naslovKartica = program.length === 1 && program[0].stavke.length >= 3 ? recenica(program[0].naslov) : "Šta ćeš naučiti?";

// "Kako izgleda učenje?" – zavisi od načina održavanja kursa (uživo / video)
const koraci = naUzivo
  ? [
      { naslov: "Lekcije i vežbe", tekst: "Propratni zadaci posle svake lekcije i vežba." },
      { naslov: "Rad uz podršku", tekst: "Uživo online rad, pitanja, feedback i individualne konsultacije." },
      { naslov: "Finalni projekat", tekst: "Rad na konkretnom projektu kao završni zadatak." },
    ]
  : [
      {
        naslov: "Video lekcije i vežbe",
        tekst: lekcije.length > 0 ? `${lekcije.length} lekcija sa vežbama i propratnim fajlovima.` : "Uz svaki snimak vežba i propratni fajlovi.",
      },
      { naslov: "Rad uz podršku", tekst: "Feedback na tvoj rad i odgovori na pitanja u privatnom chatu." },
      { naslov: "Tvoj rezultat", tekst: "Gotovi renderi koje možeš da pokažeš u portfoliju." },
    ];

// Spisak "sve što ti je potrebno" u završnoj kartici
const spisak = [
  ...oznake.map(recenica),
  kurs.glavniKurs ? recenica(kurs.glavniKurs) : "",
  lekcije.length > 0 ? `${lekcije.length} lekcija${brojVidea > 0 ? ` · ${brojVidea} video snimaka` : ""}` : "",
  program.length > 1 ? `${program.length} celina programa` : "",
  naUzivo ? "Direktan kontakt sa predavačem" : "Neograničen pristup snimcima",
  "Podrška tokom celog kursa",
].filter((s, i, niz) => s && niz.indexOf(s) === i);

// Utisci polaznika: prvo za ovaj kurs, pa ostali (iz baze)
const recenzije = sveRecenzije
  .filter((r) => r.opis && r.opis.trim())
  .sort((a, b) => Number(String(b.kurs?.id) === String(id)) - Number(String(a.kurs?.id) === String(id)))
  .slice(0, 5);

// "Kurs vizualizacije eksterijera" -> "kurs vizualizacije eksterijera"; "Od nule do..." -> "kurs Od nule do..."
const nazivUTekstu = /^kurs\b/i.test(naslov) ? naslov.charAt(0).toLowerCase() + naslov.slice(1) : `kurs „${naslov}“`;

const pitanja = [
  {
    question: `Za koga je namenjen ${nazivUTekstu}?`,
    answer: uvod[0] || "Kurs je namenjen svima koji žele da savladaju vizualizaciju, od početnika do naprednih korisnika.",
  },
  {
    question: "Kako se kurs održava?",
    answer: naUzivo
      ? "Nastava se održava uživo online, individualno ili u manjim grupama, uz direktnu komunikaciju sa predavačem."
      : "Nakon uplate kurs se pojavljuje u tvojoj web aplikaciji. Pristup video materijalima je neograničen i možeš ih gledati svojim tempom.",
  },
  {
    question: "Koji softveri se izučavaju na kursu?",
    answer: kurs.glavniKurs
      ? `Na kursu se radi u programima ${recenica(kurs.glavniKurs)}.`
      : "Na kursu se rade vodeći alati za 3D renderovanje i arhitektonsku vizualizaciju.",
  },
  {
    question: "Da li dobijam podršku tokom kursa?",
    answer: naUzivo
      ? "Da. Tokom celog kursa postavljaš pitanja u realnom vremenu i dobijaš detaljan feedback na svoj rad."
      : "Da. Uz snimke imaš podršku u privatnom chatu i feedback na svoje radove.",
  },
  {
    question: "Kako mogu da platim kurs?",
    answer: saCenom
      ? "Kurs možeš platiti karticom online ili uplatnicom. Nakon uspešne uplate kurs se odmah pojavljuje u tvojoj web aplikaciji."
      : `Za cenu i uslove prijave javi nam se na ${TELEFON_PRIKAZ}, putem WhatsApp-a ili kontakt forme.`,
  },
];

// ---------- SEO (kanonski URL sa adrese iz .env fajla) ----------
const canonicalUrl = `${CLIENT_URL}/kurs/${id}`;
const cistTekst = (t?: string) => (t || "").replace(/<[^>]*>?/gm, "").replace(/\s+/g, " ").trim();
const prvaRecenica = (t?: string) => {
  const c = cistTekst(t);
  return (c.match(/^.*?[.!?](?=\s|$)/)?.[0] || c).trim();
};
// skraćuje na celu reč (Google prikazuje ~155–160 znakova)
const skrati = (t: string, max: number) => (t.length <= max ? t : t.slice(0, t.lastIndexOf(" ", max - 1)).replace(/[,;:–-]$/, "") + "…");
const glavniLepo = kurs.glavniKurs ? recenica(kurs.glavniKurs) : "";

const opisZaSeo = skrati(
  [
    `${naslov}${glavniLepo ? ` (${glavniLepo})` : ""} – ${naUzivo ? "online kurs uživo sa predavačem" : "video kurs uz podršku predavača"}.`,
    prvaRecenica(uvod[0] || opis[0]),
    saCenom ? `Cena ${kurs.cena} €.` : "Prijavi se – Studio 27.",
  ]
    .filter(Boolean)
    .join(" "),
  158,
);

// Naslov stranice: uvek sadrži reč "kurs" i program; ako je predugačak, skraćuje se
const nazivSaKursom = /kurs/i.test(naslov) ? naslov : `${naslov} – kurs`;
const seoNaslovPun = `${nazivSaKursom}${glavniLepo ? ` – ${glavniLepo}` : ""} | Studio 27`;
const glavniKratko = glavniLepo.replace(/\s+render(er)?\b/i, "");
const seoNaslov =
  [
    seoNaslovPun,
    glavniLepo && `${naslov} – kurs ${glavniLepo} | Studio 27`,
    glavniKratko && `${naslov} – kurs ${glavniKratko} | Studio 27`,
    `${nazivSaKursom} | Studio 27`,
  ].find((t) => t && t.length <= 70 && (/kurs/i.test(t))) || `${nazivSaKursom} | Studio 27`;
const kljucneReci = [
  naslov,
  kurs.glavniKurs,
  glavniLepo ? `${glavniLepo} kurs` : "",
  naUzivo ? "online kurs uživo" : "video kurs",
  "kurs arhitektonske vizualizacije",
  "Studio 27",
]
  .filter(Boolean)
  .join(", ");

// Detaljni podaci o kursu za Google (Course + ponuda + program + ocene polaznika ovog kursa)
const recenzijeOvogKursa = sveRecenzije.filter((r) => r.opis?.trim() && String(r.kurs?.id) === String(id));
const prosecnaOcena = recenzijeOvogKursa.length
  ? recenzijeOvogKursa.reduce((z, r) => z + (r.ocena || 5), 0) / recenzijeOvogKursa.length
  : 0;
const bezIskustva = /od nule|od početka|od 0|prethodno iskustvo|nemaš nikakvo/i.test(`${kurs.komentarSredina} ${kurs.opis}`);
const kursSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Course",
  "@id": `${canonicalUrl}#kurs`,
  name: naslov,
  description: skrati(cistTekst([kurs.komentarSredina, kurs.opis].filter(Boolean).join(" ")), 500) || opisZaSeo,
  url: canonicalUrl,
  image: sveSlike,
  inLanguage: "sr",
  educationalLevel: bezIskustva ? "Početni" : "Srednji",
  ...(bezIskustva ? { coursePrerequisites: "Nije potrebno prethodno iskustvo." } : {}),
  ...(kurs.glavniKurs ? { about: glavniLepo } : {}),
  teaches: kartice
    .flatMap((k) => (/^\d+\.?\s*deo$/i.test(k.naslov) ? k.stavke : [k.naslov]))
    .filter((t, i, niz) => t && niz.indexOf(t) === i)
    .slice(0, 15),
  syllabusSections: program.slice(0, 15).map((sekcija) => ({
    "@type": "Syllabus",
    name: recenica(sekcija.naslov),
    ...(sekcija.stavke.length ? { description: sekcija.stavke.join(", ") } : {}),
  })),
  provider: {
    "@type": "Organization",
    name: "Studio 27 – 27 archviz",
    url: CLIENT_URL,
    logo: `${CLIENT_URL}/icon-512.png`,
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "Online",
    courseWorkload: "PT20H",
    instructor: { "@type": "Person", name: "Doroteja Dokić" },
  },
  ...(saCenom
    ? {
        offers: {
          "@type": "Offer",
          price: kurs.cena,
          priceCurrency: "EUR",
          category: "Paid",
          availability: "https://schema.org/InStock",
          url: canonicalUrl,
        },
      }
    : {}),
  ...(recenzijeOvogKursa.length
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: Math.round(prosecnaOcena * 10) / 10,
          ratingCount: recenzijeOvogKursa.length,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
};

// Ostali kursevi iz baze (bez ovog), sa svojim glavnim slikama i cenama
const ostaliKursevi = (await ucitajKurseve()).filter((k) => String(k.id) !== String(id));

// Slike po sekcijama (samo slike ovog kursa iz baze)
const slikaUvod = sporedne[0] || glavna;
const slikaKraj = sporedne.length > 1 ? sporedne[sporedne.length - 1] : glavna;

const eyebrow = "text-[11px] font-medium uppercase tracking-[0.24em] text-neutral-500";
const naslovSekcije = "font-serif text-[34px] md:text-[46px] leading-[1.05] tracking-[-0.02em]";
const dugmeCrno =
  "group inline-flex items-center justify-center gap-3 bg-neutral-900 px-7 py-4 text-[13px] font-medium text-white hover:bg-black transition-colors";
const dugmeOkvir =
  "inline-flex items-center justify-center gap-3 border border-neutral-900 bg-white/80 px-7 py-4 text-[13px] font-medium hover:bg-neutral-900 hover:text-white transition-colors";
---

<Layout
  title={seoNaslov}
  description={opisZaSeo}
  keywords={kljucneReci}
  image={sveSlike[0] || undefined}
  imageAlt={`${naslov} – Studio 27`}
  canonicalURL={canonicalUrl}
  breadcrumbs={[
    { name: "Kursevi", url: `${CLIENT_URL}/#edukacije` },
    { name: naslov, url: canonicalUrl },
  ]}
  schema={[kursSchema]}
  faq={pitanja}
>
  <main class="bg-white text-neutral-900">
    <!-- 1. NASLOVNI EKRAN: glavna slika kursa iz baze sa belim prelivom -->
    <section class="relative overflow-hidden bg-white">
      {
        glavna && (
          <img
            src={glavna}
            alt={`${naslov}${glavniLepo ? ` – ${glavniLepo}` : ""}, render iz kursa`}
            class="s27-zum absolute inset-y-0 right-0 h-full w-full lg:w-[62%] object-cover"
            fetchpriority="high"
          />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-r from-white via-white/92 lg:via-white/85 lg:via-[40%] to-white/0 lg:to-[70%]"></div>
      <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-white to-transparent"></div>

      <div class="relative max-w-[1300px] mx-auto px-5 md:px-10 pt-8 pb-16 md:pb-24 min-h-[560px] lg:min-h-[640px] flex flex-col">
        <nav class="s27-ulaz text-[12px] text-neutral-500" aria-label="Putanja">
          <a href="/" class="hover:text-neutral-900">Početna</a>
          <span class="mx-2">/</span>
          <a href="/#edukacije" class="hover:text-neutral-900">Kursevi</a>
          <span class="mx-2">/</span>
          <span class="text-neutral-800">{naslov}</span>
        </nav>

        <div class="max-w-[560px] my-auto pt-12">
          {
            oznake.length > 0 && (
              <p class="s27-ulaz text-[10.5px] font-medium uppercase tracking-[0.18em] text-neutral-600" style="--kasnjenje:0.1s">
                {oznake.join("  |  ")}
              </p>
            )
          }
          <h1 class="s27-ulaz mt-5 font-serif text-[44px] md:text-[62px] leading-[1.02] tracking-[-0.025em]" style="--kasnjenje:0.2s">
            {naslov}
          </h1>
          {
            kurs.glavniKurs && (
              <p class="s27-ulaz mt-3 text-[13px] font-medium uppercase tracking-[0.22em] text-neutral-600" style="--kasnjenje:0.25s">
                {kurs.glavniKurs}
              </p>
            )
          }
          <div class="s27-ulaz mt-6 space-y-3 text-[15px] md:text-[16px] leading-relaxed text-neutral-700" style="--kasnjenje:0.3s">
            {uvod.map((p) => <p>{p}</p>)}
          </div>

          <div class="s27-ulaz mt-8 flex flex-wrap items-center gap-3" style="--kasnjenje:0.4s">
            <a href="#program" class={dugmeCrno}>
              Pogledaj program kursa
              <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </a>
            <KupiDugme kurs={kurs} kupljen={kupljen} class={dugmeOkvir} />
          </div>
          <p class="s27-ulaz mt-5 text-[14px] text-neutral-600" style="--kasnjenje:0.45s">
            {
              saCenom ? (
                <>
                  Cena kursa: <strong class="font-serif text-[22px] font-normal text-neutral-900">{kurs.cena} €</strong>
                </>
              ) : (
                <>
                  Za više informacija javite se na{" "}
                  <a href={`tel:${TELEFON}`} class="font-medium text-neutral-900 underline underline-offset-4">
                    {TELEFON_PRIKAZ}
                  </a>{" "}
                  ili postavite pitanje.
                </>
              )
            }
          </p>
        </div>
      </div>
    </section>

    <!-- 2. TRAKA: softver i oznake kursa -->
    {
      traka.length > 0 && (
        <section class="border-y border-neutral-200 bg-white">
          <ul class="max-w-[1300px] mx-auto px-5 md:px-10 grid grid-cols-2 lg:grid-cols-4">
            {traka.map((t, i) => (
              <li
                class:list={[
                  "flex items-center justify-center gap-3 px-3 py-6 text-[14px] text-neutral-800",
                  i > 0 && "lg:border-l lg:border-neutral-200",
                  i % 2 === 1 && "border-l border-neutral-200",
                  i > 1 && "border-t border-neutral-200 lg:border-t-0",
                ]}
              >
                <Ikona ime={t.ikona} class="w-6 h-6 shrink-0 text-neutral-700" />
                <span class="max-w-[13rem] leading-snug text-balance">{t.tekst}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 3. O KURSU: slika iz baze levo, opis desno -->
    {
      opis.length > 0 && (
        <section id="o-kursu" class="bg-white scroll-mt-20">
          <div class="max-w-[1300px] mx-auto grid lg:grid-cols-2 items-center">
            {slikaUvod && (
              <div class="pojava relative h-[320px] md:h-[440px] lg:h-full lg:min-h-[480px] overflow-hidden">
                <img src={slikaUvod} alt={`${naslov} – primer rendera iz kursa`} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
              </div>
            )}
            <div class="pojava px-5 md:px-10 lg:px-16 py-14 md:py-20" style="--kasnjenje:0.1s">
              <p class={eyebrow}>O kursu</p>
              <h2 class:list={[naslovSekcije, "mt-4"]}>Od prve ideje do gotovog projekta.</h2>
