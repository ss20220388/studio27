---
import Layout from "../../layouts/Layout.astro";
import BigTextSection from "../../react-components/BigTextSection.jsx";
import KursInfo from "../../react-components/KursInfo.jsx";
import BuyButton from "../../react-components/BuyButton.jsx";
import KursHero from "../../react-components/KursHero.jsx";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

const { id } = Astro.params;
let kurs = null;
try {
  const kursRes = await fetch(`${API_URL}/api/kursevi/${id}`);
  kurs = await kursRes.json();
} catch (error) {
  console.error("Error fetching kurs data:", error);
}

const token = Astro.cookies.get("refreshToken")?.value || null;
let user = {}
try{
  const userRes = await fetch(`${API_URL}/api/auth/me`, {
    headers: {
      "Authorization": `Bearer ${token}`
    }
  });
  user = await userRes.json();
} catch (error) {
  console.error("Error fetching user data:", error);
}

---

<Layout title={kurs.naziv}>
  <KursHero kurs={kurs} client:load />

  <BigTextSection
    glavniTekst={kurs.glavniKurs}
    naslov={kurs.naziv}
    opis={kurs.opis}
    client:load
  />

  <KursInfo kurs={kurs} client:load />

  <!-- CTA Section -->
  <section class="py-32 bg-black flex flex-col items-center gap-6">
    <p class="text-white/50 text-sm uppercase tracking-widest">Spremni?</p>
    <BuyButton price={kurs.cena} userPocetni={user} client:load />
  </section>
</Layout>
