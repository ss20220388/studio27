---
import Layout from "../../layouts/Layout.astro";
import BigTextSection from "../../react-components/BigTextSection.jsx";
import KursInfo from "../../react-components/KursInfo.jsx";
import KursHero from "../../react-components/KursHero.jsx";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
const { id } = Astro.params;
type KursSlika = {
  url?: string;
  slikaUrl?: string;
  putanja?: string;
};
let kurs = null;
let kursSlike = [];
try {
  const kursRes = await fetch(`${API_URL}/api/kursevi/${id}`);
  kurs = await kursRes.json();
} catch (error) {
  console.error("Error fetching kurs data:", error);
}

---

<Layout 
  title={`${kurs.naziv} - Studio 27`}
  description={kurs.opis}
  image={kurs.slikaUrl}
  canonicalURL="https://studio27.rs/3ds-max-kurs"
  breadcrumbs={[
    { name: "Kursevi", url: "https://studio27.rs/kursevi" },
    { name: "3ds Max kurs", url: "https://studio27.rs/3ds-max-kurs" }
  ]}
  course={{
    name: "3ds Max kurs",
    description: "Online kurs 3ds Max, Corona Render i arhitektonske vizualizacije za početnike i napredne.",
    url: "https://studio27.rs/3ds-max-kurs"
  }}
  faq={[
    {
      question: "Da li je kurs namenjen početnicima?",
      answer: "Da, kurs je prilagođen početnicima i objašnjen korak po korak."
    },
    {
      question: "Da li se kurs prati online?",
      answer: "Da, kurs možete pratiti online svojim tempom."
    },
    {
      question: "Šta ću naučiti na kursu?",
      answer: "Naučićete 3ds Max, Corona Render, osnove arhitektonske vizualizacije i obradu finalnih rendera."
    }
  ]} 
>
  <KursHero kurs={kurs} client:load />

  <BigTextSection
    glavniTekst={kurs.glavniKurs}
    naslov={kurs.naziv}
    opis={kurs.opis}
    client:load
  />

  <KursInfo kurs={kurs}client:load />

  <!-- CTA Section -->
</Layout>
