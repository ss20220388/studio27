---
import Layout from "../../layouts/Layout.astro";
import KursPlayer from "../../react-components/KursPlayer.jsx";

const { id } = Astro.params;
const kursRes = await fetch(`http://api.studio27.rs/api/kursevi/${id}`);

const kurs = await kursRes.json();
console.log(kurs);

const token = Astro.cookies.get("refreshToken")?.value || null;
---

<Layout title={kurs.naziv}>

<section class="max-w-7xl mx-auto py-20 px-6">

  <h1 class="text-4xl font-bold mb-6">
    {kurs.naziv}
    {id}
  </h1>

  <img 
    src={`http://api.studio27.rs/api/uploaded-images${kurs.slikaUrl}`}
    alt={kurs.naziv}
    class="w-full max-w-xl rounded-xl shadow-lg mb-10 object-cover"
  />

  <p class="text-gray-600 mb-10">
    {kurs.opis}
  </p>

</section>

</Layout>