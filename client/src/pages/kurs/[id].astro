---
import Layout from "../../layouts/Layout.astro";
import KursInfo from "../../react-components/KursInfo.jsx";
import KursHero from "../../react-components/KursHero.jsx";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
const APP_URL = import.meta.env.PUBLIC_APP_URL || "http://studio27.rs";

const { id } = Astro.params;

const accessToken = Astro.cookies.get("refreshToken")?.value;
const refreshToken = Astro.cookies.get("refreshToken")?.value;

let isLoggedIn = false;
let hasPurchasedCourse = false;
let userData = null;

// Provera autentifikacije i provera da li korisnik poseduje OVAJ kurs
if (accessToken || refreshToken) {
  try {
    const authRes = await fetch(`${API_URL}/api/auth/me`, {
      headers: {
        Authorization: `Bearer ${accessToken || refreshToken}`,
      },
      credentials: "include",
    });

    if (authRes.ok) {
      userData = await authRes.json();
      isLoggedIn = true;

      // Provera kupljenih kurseva za ulogovanog korisnika
      if (userData?.userId) {
        const mojiKurseviRes = await fetch(`${API_URL}/api/moj-kursevi/${userData.userId}`, {
          headers: {
            Authorization: `Bearer ${accessToken || refreshToken}`,
          },
        });

        if (mojiKurseviRes.ok) {
          const mojiKursevi = await mojiKurseviRes.json();
          // Provera da li se id trenutnog kursa nalazi u kupljenim kursevima
          const listaKurseva = Array.isArray(mojiKursevi) ? mojiKursevi : mojiKursevi.kursevi || [];
          hasPurchasedCourse = listaKurseva.some((k: any) => String(k.id || k.kursId) === String(id));
        }
      }
    }
  } catch (e) {
    console.error("Greška pri proveri autentifikacije/kurseva:", e);
  }
}

type KursSlika = { url?: string; slikaUrl?: string; putanja?: string };

let kurs: any = null;
let kursSlike: KursSlika[] = [];

// Paralelno dohvatanje podataka o kursu i slikama
try {
  const [kursRes, slikeRes] = await Promise.all([
    fetch(`${API_URL}/api/kursevi/${id}`),
    fetch(`${API_URL}/api/kursslika/${id}`)
  ]);

  if (kursRes.ok) kurs = await kursRes.json();
  if (slikeRes.ok) {
    const data = await slikeRes.json();
    kursSlike = data.kursSlika || [];
  }
} catch (e) {
  console.error("Greška pri dohvatanju podataka o kursu:", e);
}

if (!kurs) {
  return Astro.redirect('/404');
}

// SEO Priprema
const rawDescription = kurs.opis || kurs.komentarDole || "Naučite arhitektonsku vizualizaciju od nule uz naše stručne kurseve.";
const seoDescription = rawDescription.replace(/<[^>]*>?/gm, '').replace(/\s+/g, ' ').slice(0, 155).trim() + "...";
const seoTitle = `${kurs.naziv}${kurs.glavniKurs ? ` - ${kurs.glavniKurs}` : ''} | 27 archviz`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();

const firstGalleryImage = kursSlike && kursSlike.length > 0 
  ? (kursSlike[0]?.url || kursSlike[0]?.slikaUrl || kursSlike[0]?.putanja)
  : null;

const rawImageUrl = firstGalleryImage || kurs.slikaUrl || kurs.slika;

let seoImage: string | undefined = undefined;
if (rawImageUrl) {
  if (rawImageUrl.startsWith('http://') || rawImageUrl.startsWith('https://')) {
    seoImage = rawImageUrl;
  } else {
    const cleanPath = rawImageUrl.startsWith('/') ? rawImageUrl : `/${rawImageUrl}`;
    seoImage = `${API_URL}/api/uploaded-images${cleanPath}`;
  }
}
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
  canonicalURL={canonicalUrl}
  breadcrumbs={[
    { name: "Početna", url: `${APP_URL}` },
    { name: "Kursevi", url: `${APP_URL}#kursevi` },
    { name: kurs.naziv, url: canonicalUrl }
  ]}
  course={{
    name: kurs.naziv,
    description: seoDescription,
    url: canonicalUrl,
    image: seoImage
  }}
  faq={[
    {
      question: `Za koga je namenjen kurs ${kurs.naziv}?`,
      answer: kurs.komentarGore || "Kurs je namenjen svima koji žele da savladaju vizuelizacije, od početnika do naprednih korisnika."
    },
    {
      question: "Kako se pristupa lekcijama i koliko traje pristup?",
      answer: "Pristup video materijalima je neograničen i možete ih gledati uvek i svojim tempom."
    },
    {
      question: "Koji softveri se izučavaju na kursu?",
      answer: kurs.glavniKurs || "Na kursu se rade vodeći alati za 3D renderovanje i arhitektonsku vizualizaciju."
    }
  ]} 
>
  <div class="bg-black text-white min-h-screen">
    <KursHero 
      kurs={kurs} 
      kursSlike={kursSlike} 
      client:load 
    />
    <KursInfo 
      kurs={kurs} 
      accessToken={accessToken} 
      isLoggedIn={isLoggedIn}
      hasPurchasedCourse={hasPurchasedCourse}
      client:visible 
    />
  </div>
</Layout>