---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

let radovi: any[] = [];
try {
  const res = await fetch(`${API_URL}/api/radovi`);
  if (res.ok) radovi = await res.json();
} catch (e) {
  console.error("Greška:", e);
}

const radoviByStudent: Record<string, any[]> = radovi.reduce((acc: any, rad: any) => {
  const name = `${rad.ime} ${rad.prezime}`;
  if (!acc[name]) acc[name] = [];
  acc[name].push(rad);
  return acc;
}, {});

const studentGroups = Object.entries(radoviByStudent) as [string, any[]][];
---

<Layout 
  title="Radovi Studenata | 3D Arhitektonska Vizuelizacija | 27 archviz"
  description="Pogledajte galeriju radova i fotorealističnih rendera naših studenata nakon završene obuke za 3ds Max i Corona Render."
  canonicalURL="https://27archviz.com/radovi"
  breadcrumbs={[{ name: "Radovi", url: "https://27archviz.com/radovi" }]}
>
  <section class="relative min-h-screen overflow-hidden bg-white">
    <!-- Animated background -->
    <div class="animated-bg-container pointer-events-none fixed inset-0 z-0 overflow-hidden">
      {radovi.length > 0 && (
        <div class="flex h-screen flex-col opacity-[0.035]">
          {[0, 3, 6, 9, 12].map((delay) => (
            <div class="animated-images-line flex-1" style={`animation-delay: -${delay}s;`}>
              {Array(5).fill(0).map(() => radovi.map((rad: any) => (
                <div class="inline-block h-[20vh] shrink-0">
                  <img
                    src={`${API_URL}/api/uploaded-images${rad.url}`}
                    alt="rad"
                    class="h-[20vh] w-[20vh] object-cover"
                    loading="lazy"
                  />
                </div>
              )))}
              {Array(5).fill(0).map(() => radovi.map((rad: any) => (
                <div class="inline-block h-[20vh] shrink-0">
                  <img
                    src={`${API_URL}/api/uploaded-images${rad.url}`}
                    alt="rad"
                    class="h-[20vh] w-[20vh] object-cover"
                    loading="lazy"
                  />
                </div>
              )))}
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 py-16">
      {studentGroups.length === 0 ? (
        <p class="py-20 text-center text-lg text-gray-400">Nema dostupnih radova</p>
      ) : (
        <div class="space-y-24">
          {studentGroups.map(([studentName, works], index) => {
            const firstWork = works[0];
            const isEven = index % 2 === 0;
            return (
              <div class="student-work-section">
                {/* Header grid */}
                <div class={`grid grid-cols-1 items-start gap-12 border-b border-gray-200 pb-12 mb-16 md:grid-cols-3 ${!isEven ? 'md:grid-flow-col-dense' : ''}`}>
                  {/* Text */}
                  <div class={`md:col-span-1 ${!isEven ? 'md:col-start-3' : ''}`}>
                    <h1 class="student-name mb-6 text-5xl font-bold tracking-tight text-gray-900 md:text-6xl">
                      {studentName}
                    </h1>
                    <div class="mb-8 mt-6 space-y-4 border-b border-gray-100 pb-8">
                      <p class="text-base font-light leading-relaxed text-gray-500">
                        Projekat razvijen kroz 27 archviz program – dokaz posvećenosti i napretka.
                      </p>
                      <p class="text-base font-light leading-relaxed text-gray-500">
                        Kreiran tokom kursa kao rezultat kontinuiranog rada i usavršavanja.
                      </p>
                      <p class="text-base font-light leading-relaxed text-gray-500">
                        Vizija pretvorena u projekat kroz 27 archviz iskustvo.
                      </p>
                    </div>

                    {firstWork?.idKurs && (
                      <p class="mb-4 text-xl font-semibold uppercase tracking-wider text-orange-500">
                        {firstWork?.naziv || "Rad"}
                      </p>
                    )}

                    {firstWork?.kurs && (
                      <div class="mt-8 flex flex-col gap-1">
                        <span class="text-[10px] font-semibold uppercase tracking-[0.3em] text-orange-400">Kurs</span>
                        <span class="text-2xl font-bold text-gray-900">
                          {firstWork.kurs.naziv}
                        </span>
                      </div>
                    )}
                  </div>

                  {/* Featured image */}
                  {firstWork && (
                    <div class={`md:col-span-2 ${!isEven ? 'md:col-start-1 md:row-start-1' : ''}`}>
                      <div class="overflow-hidden rounded-3xl shadow-xl shadow-orange-500/5">
                        <Image
                          src={`${API_URL}/api/uploaded-images${firstWork.url}`}
                          class="h-[28rem] w-full object-cover transition-transform duration-500 hover:scale-105"
                          loading="lazy"
                          alt="featured work"
                          width={900}
                          height={600}
                        />
                      </div>
                    </div>
                  )}
                </div>

                {/* Gallery */}
                <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
                  {works.map((work: any, idx: number) => {
                    if (idx === 0) return null;
                    return (
                      <div
                        class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-gray-50 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-orange-200 hover:shadow-lg hover:shadow-orange-500/10"
                        style={`animation-delay: ${idx * 0.08}s`}
                      >
                        <Image
                          src={`${API_URL}/api/uploaded-images${work.url}`}
                          class="aspect-square w-full object-cover transition-all duration-500 group-hover:scale-110"
                          loading="lazy"
                          alt="radovi"
                          width={400}
                          height={400}
                        />
                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .student-name,
  .student-work-section {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .student-name.is-visible,
  .student-work-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .animated-bg-container {
    filter: brightness(1);
  }

  .animated-images-line {
    display: flex;
    gap: 0;
    width: max-content;
    animation: scroll 150s linear infinite;
    will-change: transform;
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('is-visible');
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });

  document.querySelectorAll('.student-name, .student-work-section').forEach(el => {
    observer.observe(el);
  });
</script>