---
import Layout from "../layouts/Layout.astro";
import Ikona from "../components/novo/Ikona.astro";
import { API_URL, CLIENT_URL } from "../data/sajt";

const SITE_URL = CLIENT_URL;

let radovi: any[] = [];
try {
  const res = await fetch(`${API_URL}/api/radovi`);
  if (res.ok) radovi = await res.json();
} catch (e) {
  console.error("Greška pri dohvatanju radova:", e);
}

// Grupisanje radova po studentu
const radoviByStudent: Record<string, { displayName: string; redosledOsoba: number | null; works: any[] }> = {};

for (const rad of radovi) {
  const ime = rad.ime && rad.ime !== "null" ? String(rad.ime).trim() : "";
  const prezime = rad.prezime && rad.prezime !== "null" ? String(rad.prezime).trim() : "";

  if (!ime && !prezime) continue;

  const displayName = `${ime} ${prezime}`.replace(/\s+/g, " ").trim();
  const groupKey = displayName.toLowerCase();

  let rawRedosled = rad.redosledOsoba;
  let parsedRedosled: number | null = null;
  if (rawRedosled !== null && rawRedosled !== undefined && rawRedosled !== "null" && rawRedosled !== "") {
    const num = Number(rawRedosled);
    if (!isNaN(num)) parsedRedosled = num;
  }

  if (!radoviByStudent[groupKey]) {
    radoviByStudent[groupKey] = {
      displayName,
      redosledOsoba: parsedRedosled,
      works: []
    };
  } else if (radoviByStudent[groupKey].redosledOsoba === null && parsedRedosled !== null) {
    radoviByStudent[groupKey].redosledOsoba = parsedRedosled;
  }

  // Sanitizacija URL slike
  let cleanUrl = rad.url || "";
  if (cleanUrl && !cleanUrl.startsWith("http")) {
    cleanUrl = cleanUrl.startsWith("/") ? cleanUrl : `/${cleanUrl}`;
    cleanUrl = `${API_URL}/api/uploaded-images${cleanUrl}`;
  }

  radoviByStudent[groupKey].works.push({ ...rad, fullUrl: cleanUrl });
}

// Sortiranje studenata
const studentGroups = Object.values(radoviByStudent).sort((a, b) => {
  if (a.redosledOsoba !== null && b.redosledOsoba !== null) {
    return a.redosledOsoba - b.redosledOsoba;
  }
  if (a.redosledOsoba !== null) return -1;
  if (b.redosledOsoba !== null) return 1;
  return a.displayName.localeCompare(b.displayName);
});

// Sortiranje slika unutar grupe
studentGroups.forEach(group => {
  group.works.sort((a, b) => {
    const rA = a.raspored !== null && a.raspored !== undefined && a.raspored !== "null" ? Number(a.raspored) : null;
    const rB = b.raspored !== null && b.raspored !== undefined && b.raspored !== "null" ? Number(b.raspored) : null;

    if (rA !== null && !isNaN(rA) && rB !== null && !isNaN(rB)) return rA - rB;
    if (rA !== null && !isNaN(rA)) return -1;
    if (rB !== null && !isNaN(rB)) return 1;
    return 0;
  });
});

const ukupnoRadova = studentGroups.reduce((zbir, g) => zbir + g.works.length, 0);

// SEO Slike za Open Graph & Schema.org ImageGallery
const allImages = studentGroups.flatMap(g => g.works.map(w => w.fullUrl));
const primarySeoImage = allImages[0] || `${SITE_URL}/images/default-seo-image.png`;

// Generisanje Schema.org ImageGallery
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Radovi studenata – Studio 27",
  "description": "Fotorealistični 3D renderi i vizualizacije enterijera polaznika Studio 27, nastali tokom kurseva 3ds Max + Corona Renderer.",
  "url": `${SITE_URL}/radovi`,
  "image": allImages.slice(0, 10),
  "hasPart": studentGroups.flatMap(group => 
    group.works.map(work => ({
      "@type": "VisualArtwork",
      "name": `3D Render - ${group.displayName}`,
      "artist": {
        "@type": "Person",
        "name": group.displayName
      },
      "image": work.fullUrl,
      "description": `Arhitektonska vizuelizacija polaznika ${group.displayName}`
    }))
  )
};
---

<Layout
  title="Radovi studenata – 3D vizualizacije polaznika | Studio 27"
  description={`Galerija od ${ukupnoRadova} fotorealističnih rendera i 3D vizualizacija enterijera koje su polaznici Studio 27 izradili tokom kurseva 3ds Max + Corona Renderer.`}
  canonicalURL={`${SITE_URL}/radovi`}
  image={primarySeoImage}
  imageAlt="Render enterijera – rad polaznika Studio 27"
  keywords="radovi studenata, 3ds max renderi, corona render primeri, vizualizacija enterijera portfolio, 3d vizualizacija polaznici, studio 27"
  breadcrumbs={[{ name: "Radovi studenata", url: `${SITE_URL}/radovi` }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />

  <main class="bg-white text-neutral-900">
    <!-- UVOD -->
    <section class="border-b border-neutral-200">
      <div class="max-w-[1400px] mx-auto px-5 md:px-10 pt-16 md:pt-24 pb-14 md:pb-20 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-end">
        <div>
          <p class="s27-ulaz text-[11px] font-medium uppercase tracking-[0.26em] text-neutral-500">Galerija · Studio 27</p>
          <h1 class="s27-ulaz mt-5 font-serif text-[46px] md:text-[76px] leading-[0.98] tracking-[-0.025em]" style="--kasnjenje:0.15s">
            Radovi naših<br />polaznika.
          </h1>
        </div>
        <div class="s27-ulaz" style="--kasnjenje:0.3s">
          <p class="text-[16px] leading-relaxed text-neutral-600 max-w-[440px]">
            Fotorealistični renderi nastali tokom i nakon kurseva — od prvog modela do slike koja ide u portfolio.
          </p>
          <dl class="mt-8 flex gap-12">
            <div>
              <dt class="font-serif text-[40px] leading-none">{studentGroups.length}</dt>
              <dd class="mt-2 text-[11px] uppercase tracking-[0.18em] text-neutral-500">polaznika</dd>
            </div>
            <div>
              <dt class="font-serif text-[40px] leading-none">{ukupnoRadova}</dt>
              <dd class="mt-2 text-[11px] uppercase tracking-[0.18em] text-neutral-500">rendera</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    {studentGroups.length === 0 ? (
      <p class="max-w-[1400px] mx-auto px-5 md:px-10 py-24 text-neutral-500">Trenutno nema dostupnih radova.</p>
    ) : (
      <div class="max-w-[1400px] mx-auto px-5 md:px-10">
        {studentGroups.map(({ displayName, works }, gIndex) => (
          <section class="pojava grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-14 py-14 md:py-20 border-b border-neutral-200 last:border-b-0">
            <header class="lg:sticky lg:top-28 self-start">
              <p class="font-serif text-[15px] text-neutral-400">{String(gIndex + 1).padStart(2, "0")}</p>
              <h2 class="mt-2 font-serif text-[32px] md:text-[38px] leading-[1.05] tracking-[-0.015em]">{displayName}</h2>
              <p class="mt-3 text-[11px] uppercase tracking-[0.18em] text-neutral-500">
                {works.length} {works.length === 1 ? "render" : "rendera"} · 3ds Max + Corona
              </p>
            </header>
            <div class="columns-2 md:columns-3 gap-3 md:gap-4">
              {works.map((work: any, wIndex: number) => (
                <button
                  type="button"
                  class="s27-rad group relative mb-3 md:mb-4 block w-full overflow-hidden bg-neutral-100 break-inside-avoid cursor-zoom-in"
                  data-src={work.fullUrl}
                  data-autor={displayName}
                  aria-label={`Uvećaj render – ${displayName}`}
                >
                  <img
                    src={work.fullUrl}
                    alt={`3D vizualizacija enterijera – rad polaznika ${displayName}`}
                    class="w-full h-auto transition-transform duration-[1200ms] ease-out group-hover:scale-[1.04]"
                    loading={gIndex === 0 && wIndex < 3 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <span class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-500"></span>
                  <span class="absolute right-3 bottom-3 w-10 h-10 rounded-full bg-white/90 flex items-center justify-center opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500">
                    <Ikona ime="plus" class="w-4 h-4" debljina={2} />
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}

    <!-- POZIV -->
    <section class="bg-[#151515] text-white">
      <div class="max-w-[1400px] mx-auto px-5 md:px-10 py-20 md:py-28 flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div class="pojava">
          <p class="text-[11px] font-medium uppercase tracking-[0.26em] text-white/50">Tvoj rad može biti sledeći</p>
          <h2 class="mt-4 font-serif text-[38px] md:text-[56px] leading-[1.03] tracking-[-0.02em]">Napravi render za svoj portfolio.</h2>
        </div>
        <div class="pojava flex flex-wrap gap-3" style="--kasnjenje:0.1s">
          <a href="/#edukacije" class="group inline-flex items-center gap-3 bg-white px-8 py-4 text-[13px] font-medium text-neutral-900 hover:bg-neutral-100 transition-colors">
            Pogledaj kurseve <Ikona ime="strelica" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
          <a href="/kviz" class="inline-flex items-center gap-3 border border-white/50 px-8 py-4 text-[13px] font-medium hover:bg-white/10 transition-colors">
            Koji kurs je za mene?
          </a>
        </div>
      </div>
    </section>

    <!-- LIGHTBOX -->
    <div id="s27-lightbox" class="fixed inset-0 z-[2000] hidden items-center justify-center bg-black/95 p-4 md:p-10" role="dialog" aria-modal="true" aria-label="Uvećan render">
      <button type="button" data-lb-zatvori class="absolute top-5 right-5 w-12 h-12 flex items-center justify-center text-white/80 hover:text-white text-3xl cursor-pointer" aria-label="Zatvori">&times;</button>
      <button type="button" data-lb-nazad class="absolute left-3 md:left-8 top-1/2 -translate-y-1/2 w-12 h-12 border border-white/30 flex items-center justify-center text-white hover:bg-white hover:text-neutral-900 transition-colors cursor-pointer" aria-label="Prethodni render">
        <Ikona ime="strelicaLevo" class="w-5 h-5" />
      </button>
      <figure class="flex flex-col items-center max-w-[1200px]">
        <img id="s27-lb-slika" alt="" class="max-h-[82vh] max-w-full object-contain" />
        <figcaption class="mt-5 flex items-center gap-4 text-white/80">
          <span id="s27-lb-autor" class="font-serif text-[20px] text-white"></span>
          <span id="s27-lb-broj" class="text-[12px] uppercase tracking-[0.18em]"></span>
        </figcaption>
      </figure>
      <button type="button" data-lb-napred class="absolute right-3 md:right-8 top-1/2 -translate-y-1/2 w-12 h-12 border border-white/30 flex items-center justify-center text-white hover:bg-white hover:text-neutral-900 transition-colors cursor-pointer" aria-label="Sledeći render">
        <Ikona ime="strelica" class="w-5 h-5" />
      </button>
    </div>
  </main>
</Layout>

<script>
  // Lightbox sa strelicama i tastaturom (← → Esc)
  const radovi = [...document.querySelectorAll<HTMLElement>(".s27-rad")];
  const lb = document.getElementById("s27-lightbox");
  const slika = document.getElementById("s27-lb-slika") as HTMLImageElement | null;
  const autor = document.getElementById("s27-lb-autor");
  const broj = document.getElementById("s27-lb-broj");
  let trenutni = 0;

  const prikazi = (i: number) => {
    if (!lb || !slika || radovi.length === 0) return;
    trenutni = (i + radovi.length) % radovi.length;
    const rad = radovi[trenutni];
    slika.src = rad.dataset.src || "";
    slika.alt = `Render – ${rad.dataset.autor || ""}`;
    if (autor) autor.textContent = rad.dataset.autor || "";
    if (broj) broj.textContent = `${trenutni + 1} / ${radovi.length}`;
  };
  const otvori = (i: number) => {
    prikazi(i);
    lb?.classList.remove("hidden");
    lb?.classList.add("flex");
    document.body.style.overflow = "hidden";
  };
  const zatvori = () => {
    lb?.classList.add("hidden");
    lb?.classList.remove("flex");
    document.body.style.overflow = "";
  };

  radovi.forEach((r, i) => r.addEventListener("click", () => otvori(i)));
  lb?.querySelector("[data-lb-zatvori]")?.addEventListener("click", zatvori);
  lb?.querySelector("[data-lb-nazad]")?.addEventListener("click", () => prikazi(trenutni - 1));
  lb?.querySelector("[data-lb-napred]")?.addEventListener("click", () => prikazi(trenutni + 1));
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) zatvori();
  });
  document.addEventListener("keydown", (e) => {
    if (!lb || lb.classList.contains("hidden")) return;
    if (e.key === "Escape") zatvori();
    if (e.key === "ArrowLeft") prikazi(trenutni - 1);
    if (e.key === "ArrowRight") prikazi(trenutni + 1);
  });
</script>
