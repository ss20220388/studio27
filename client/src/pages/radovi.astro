---
import Layout from "../layouts/Layout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";

let radovi: any[] = [];
try {
  const res = await fetch(`${API_URL}/api/radovi`);
  if (res.ok) radovi = await res.json();
} catch (e) {
  console.error("Greška pri dohvatanju radova:", e);
}

// Grupisanje radova po imenu i prezimenu
const radoviByStudent: Record<string, { displayName: string; redosledOsoba: number | null; works: any[] }> = {};

for (const rad of radovi) {
  
  const ime = rad.ime && rad.ime !== "null" ? String(rad.ime).trim() : "";
  const prezime = rad.prezime && rad.prezime !== "null" ? String(rad.prezime).trim() : "";

  // Ako nemamo ni ime ni prezime, preskačemo rad potpuno
  if (!ime && !prezime) continue;

  const displayName = `${ime} ${prezime}`.replace(/\s+/g, " ").trim();
  const groupKey = displayName.toLowerCase();

  let rawRedosled = rad.redosledOsoba;
  console.log(`Processing student: ${displayName}, raw redosled: ${rawRedosled}`);
  let parsedRedosled: number | null = null;
  if (rawRedosled !== null && rawRedosled !== undefined && rawRedosled !== "null" && rawRedosled !== "") {
    const num = Number(rawRedosled);
    if (!isNaN(num)) parsedRedosled = num;
  }

  if (!radoviByStudent[groupKey]) {
    radoviByStudent[groupKey] = {
      displayName,
      redosledOsoba: parsedRedosled,
      works: []
    };
  } else if (radoviByStudent[groupKey].redosledOsoba === null && parsedRedosled !== null) {
    radoviByStudent[groupKey].redosledOsoba = parsedRedosled;
  }

  radoviByStudent[groupKey].works.push(rad);
}

// 1. Sortiranje studenata: Prvo po redosledOsoba (1, 2, 3...), pa onda oni bez redosleda
const studentGroups = Object.values(radoviByStudent).sort((a, b) => {
  if (a.redosledOsoba !== null && b.redosledOsoba !== null) {
    return a.redosledOsoba - b.redosledOsoba;
  }
  if (a.redosledOsoba !== null) return -1;
  if (b.redosledOsoba !== null) return 1;
  return a.displayName.localeCompare(b.displayName); // Alfabetski ako oba nemaju redosled
});

// 2. Sortiranje pojedinačnih slika/radova unutar svakog studenta po polju `raspored`
studentGroups.forEach(group => {
  group.works.sort((a, b) => {
    const rA = a.raspored !== null && a.raspored !== undefined && a.raspored !== "null" ? Number(a.raspored) : null;
    const rB = b.raspored !== null && b.raspored !== undefined && b.raspored !== "null" ? Number(b.raspored) : null;

    if (rA !== null && !isNaN(rA) && rB !== null && !isNaN(rB)) return rA - rB;
    if (rA !== null && !isNaN(rA)) return -1;
    if (rB !== null && !isNaN(rB)) return 1;
    return 0;
  });
});
---

<Layout 
  title="Radovi Studenata | 3D Arhitektonska Vizuelizacija | 27 archviz"
  description="Pogledajte galeriju radova i fotorealističnih rendera naših studenata nakon završene obuke."
  canonicalURL="https://27archviz.com/radovi"
  breadcrumbs={[{ name: "Radovi", url: "https://27archviz.com/radovi" }]}
>
  <main class="min-h-screen bg-white text-black py-16 md:py-24 font-sans">
    <h1 class="sr-only">Galerija Radova Studenata | 27 archviz</h1>

    {studentGroups.length === 0 ? (
      <div class="max-w-7xl mx-auto px-6 text-center py-20 text-zinc-400">
        Nema dostupnih radova
      </div>
    ) : (
      <div class="max-w-[1600px] mx-auto px-6 space-y-24 md:space-y-32">
        {studentGroups.map(({ displayName, works }) => {
          const firstWork = works[0];
          const kursNaziv = firstWork?.kurs?.naziv || firstWork?.naziv || "3DS MAX + CORONA RENDER";

          return (
            <section class="student-block space-y-8">
              
              <!-- ZAGLAVLJE STUDENT SEKCIJE (IME + KURS) -->
              <div class="max-w-4xl space-y-2">
                <h2 class="text-4xl md:text-6xl font-black text-black tracking-tight">
                  {displayName}
                </h2>
                <p class="text-base md:text-lg font-medium text-zinc-500">
                  Kurs: <span class="text-orange-500 font-semibold">{kursNaziv}</span>
                </p>
              </div>

              <!-- RED SA RADOVIMA (SLIKAMA) -->
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4">
                {works.map((work: any) => (
                  <div class="group hover:scale-105 ease-linear duration-300 relative aspect-square overflow-hidden bg-zinc-100 rounded-lg cursor-pointer border border-transparent transition-all">
                    <img
                      src={`${API_URL}/api/uploaded-images${work.url}`}
                      alt={`Rad studenta ${displayName}`}
                      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>

            </section>
          );
        })}
      </div>
    )}
  </main>
</Layout>

<style>
  .student-block {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .student-block.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.05 });

  document.querySelectorAll('.student-block').forEach(el => {
    observer.observe(el);
  });
</script>