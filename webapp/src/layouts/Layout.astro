---
import "../styles/global.css";
const { title } = Astro.props;
import Sidebar from "../components/Sidebar2.astro";
import { type AstroCookies } from "astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";
const CLIENT_URL = import.meta.env.PUBLIC_CLIENT_URL || "http://studio27.rs";

const cookies = Astro.cookies as AstroCookies;
const token = cookies.get("refreshToken")?.value || null;
let userData = {error:false};
try {
    const response = await fetch(`${API_URL}/api/auth/me`, {
        headers: {
            Authorization: `Bearer ${token}`,
        },
    });
    userData = await response.json();
} catch (error) {
    userData.error = true;
    console.error("Error fetching user data:", error);
}
---

<!doctype html>
<html lang="sr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <title>{title} — Studio 27</title>
    </head>
    <body class="bg-[#0a0a0a] min-h-screen">
        {
            !userData.error ? (
                <div class="relative flex h-screen overflow-hidden">
                    <Sidebar />
                    <main class="flex-1 overflow-y-auto">
                        <div class="p-6 md:p-8 lg:p-10 max-w-350 mx-auto">
                            <slot />
                        </div>
                    </main>
                </div>
            ) : (
                <div class="flex items-center justify-center h-screen px-4">
                    <div class="text-center max-w-md">
                        <div class="w-16 h-16 rounded-2xl bg-red-900/15 border border-red-900/20 flex items-center justify-center mx-auto mb-6">
                            <svg
                                viewBox="0 0 20 20"
                                fill="currentColor"
                                class="w-8 h-8 text-red-400"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                                    clip-rule="evenodd"
                                />
                            </svg>
                        </div>
                        <h1 class="text-xl font-bold text-white mb-2">
                            Pristup odbijen
                        </h1>
                        <p class="text-neutral-400 text-sm mb-6">
                            Niste prijavljeni. Molimo vas prijavite se kako
                            biste koristili aplikaciju.
                        </p>
                        <a
                            href={`${CLIENT_URL}`}
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-900 hover:bg-red-800 text-white text-sm font-medium transition-colors duration-200"
                        >
                            Prijavi se
                        </a>
                    </div>
                </div>
            )
        }
    </body>
</html>
