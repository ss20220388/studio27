---
const { stats } = Astro.props;
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 stagger-children">
    <div class="bg-neutral-900 border border-neutral-800 p-5 rounded-xl">
        <p class="text-[11px] font-medium text-neutral-500 uppercase tracking-wider">Ukupno kurseva</p>
        <p class="text-2xl font-bold text-white mt-1">{stats.totalCourses}</p>
    </div>

    <div class="bg-neutral-900 border border-neutral-800 p-5 rounded-xl">
        <p class="text-[11px] font-medium text-neutral-500 uppercase tracking-wider">Završeno</p>
        <p class="text-2xl font-bold text-emerald-400 mt-1">{stats.finished}</p>
    </div>

    <div class="bg-neutral-900 border border-neutral-800 p-5 rounded-xl">
        <p class="text-[11px] font-medium text-neutral-500 uppercase tracking-wider">U toku</p>
        <p class="text-2xl font-bold text-amber-400 mt-1">{stats.inProgress}</p>
    </div>

    <div class="bg-neutral-900 border border-neutral-800 p-5 rounded-xl">
        <p class="text-[11px] font-medium text-neutral-500 uppercase tracking-wider">Sati gledanja</p>
        <p class="text-2xl font-bold text-white mt-1">{stats.hours}h</p>
    </div>
</div>
