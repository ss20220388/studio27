---
import CourseCard from "./CourseCard.astro";

const courses = [
    { title: "React Kurs", progress: 70 },
    { title: "SQL Masterclass", progress: 35 },
];
---

<div>
    <h2 class="text-base font-semibold text-white mb-4">Nastavi gde si stao</h2>

    <div class="grid md:grid-cols-2 gap-4 pb-8">
        {
            courses.map((course) => (
                <CourseCard title={course.title} progress={course.progress} />
            ))
        }
    </div>
</div>
