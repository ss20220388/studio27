---
import CourseCard from "./CourseCard.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
const token = Astro.cookies.get("refreshToken")?.value;
const userRes = await fetch(`${API_URL}/api/auth/me`, {
    headers: { Authorization: `Bearer ${token}` },
});
const userData = await userRes.json();

const kurseviUTokuRes = await fetch(`${API_URL}/api/kursevi-u-toku/${userData.userId}`, {
    headers: { Authorization: `Bearer ${token}` },
});
const kurseviUToku = await kurseviUTokuRes.json();
---

<div>
    <h2 class="text-base font-semibold text-white mb-4">Nastavi gde si stao</h2>

    <div class="grid md:grid-cols-2 gap-4 pb-8">
        {kurseviUToku.map((kurs: any) => (
            <CourseCard
                title={kurs.naziv}
                progress={kurs.progress}
                slikaUrl={kurs.slikaUrl}
                kursId={kurs.kursId}
            />
        ))}
    </div>
</div>