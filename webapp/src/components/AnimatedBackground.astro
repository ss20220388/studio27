---
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

let radovi: any[] = [];

try {
  const resRadovi = await fetch(`${API_URL}/api/radovi`);
  if (resRadovi.ok) {
    radovi = await resRadovi.json();
  }
} catch (e) {
  console.error("Greška pri učitavanju radova:", e);
}
---

{radovi.length > 0 && (
  <div class="animated-bg-container">
    <div class="animated-images-line">
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <div class="animated-images-line" style="animation-delay: -3s;">
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <div class="animated-images-line" style="animation-delay: -6s;">
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <div class="animated-images-line" style="animation-delay: -9s;">
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
      {radovi.map((rad: any) => (
        <div class="inline-block flex-shrink-0">
          <img 
            src={`${API_URL}/api/uploaded-images${rad.url}`}
            alt="rad"
            class="h-48 w-48 object-cover opacity-20 hover:opacity-40 transition-opacity"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
)}

<style>
  /* Animated background container */
  .animated-bg-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .animated-images-line {
    display: flex;
    animation: scroll-images 20s linear infinite;
    white-space: nowrap;
  }

  @keyframes scroll-images {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
