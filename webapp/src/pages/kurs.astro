---
import { intersection } from "astro:schema";
import Layout from "../layouts/Layout.astro";
import ReactKurs from "../react components/ReactKurs";

interface Kurs {
    id: number;
    naziv: string;
    opis: string;
    cena: number;
    trajanje: number;
    slikaUrl: string;
}
interface ResponseData {
    kursevi: Kurs[];
}

const data: Response = await fetch("http://localhost:8080/api/kursevi"); // SSR: server-side fetch

const kurseviRes: ResponseData = await data.json();
const kursevi = kurseviRes.kursevi;

const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch("http://api.studio27.rs/api/auth/me", {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();
---

<Layout title="Kursevi">
   <main class="px-10 py-4 flex flex-col items-center justify-center h-screen  ">
    <h1 class="text-3xl font-bold mb-10">Svi kursevi</h1>

   <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 overflow-y-scroll h-full">
            {kursevi?.map((kurs) => (
                <ReactKurs client:idle  kurs={kurs} userId={userData.userId} accessToken={token} />
            ))}
        </div>
    </main>
</Layout>
