---
import Layout from "../layouts/Layout.astro";
import ReactKurs from "../react components/ReactKurs";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

interface Kurs {
    id: number;
    naziv: string;
    opis: string;
    cena: number;
    trajanje: number;
    slikaUrl: string;
}
interface ResponseData {
    kursevi: Kurs[];
}

const data: Response = await fetch(`${API_URL}/api/kursevi`);

const kurseviRes: ResponseData = await data.json();
const kursevi = kurseviRes.kursevi;

const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch(`${API_URL}/api/auth/me`, {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();
---

<Layout title="Svi kursevi">
  <div class="space-y-6 animate-fade-in">
    <div>
      <h1 class="text-2xl font-bold text-white">Svi kursevi</h1>
      <p class="text-sm text-neutral-500 mt-1">Pregledajte sve dostupne kurseve</p>
    </div>

    <div class="grid h-screen overflow-y-hidden md:grid-cols-2 xl:grid-cols-3 gap-4 stagger-children">
      {kursevi?.map((kurs) => (
        <ReactKurs client:idle kurs={kurs} userId={userData.userId} accessToken={token} />
      ))}
    </div>
  </div>
</Layout>
