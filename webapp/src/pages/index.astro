---
import Layout from "../layouts/Layout.astro";
import StatsCards from "../components/StatsCards.astro";
import ProgressChart from "../react components/ProgressChart";
import ContinueWatching from "../components/ContinueWatching.astro";
const token = Astro.cookies.get("refreshToken")?.value;
const userRes = await fetch("http://api.studio27.rs/api/auth/me", {
	headers: {
		Authorization: `Bearer ${token}`,
	},	
});
const userData = await userRes.json();
console.log(userData);
const brojKursevaResponse = await fetch(`http://api.studio27.rs/api/broj-kurseva/${userData.userId}`,
	{
		headers: {
			Authorization: `Bearer ${token}`,
		},
	}
);
const brojKursevaData = await brojKursevaResponse.json();
console.log(brojKursevaData);
const stats = {
	totalCourses: brojKursevaData.brojKurseva || 0,
	finished: 1,
	inProgress: 3,
	hours: 12,
};
---

<Layout title="Početna">
	<div class="space-y-8 animate-fade-in">
		<div>
			<h1 class="text-2xl font-bold text-white">Dobrodošli</h1>
			<p class="text-sm text-neutral-500 mt-1">Vaš pregled napretka i aktivnosti</p>
		</div>

		<StatsCards stats={stats} />

		<div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
				<h2 class="text-base font-semibold text-white">Statistika učenja</h2>
				<span class="text-xs text-neutral-500">pregled kurseva</span>
			</div>
			<ProgressChart client:load />
		</div>

		<ContinueWatching />
	</div>
</Layout>
