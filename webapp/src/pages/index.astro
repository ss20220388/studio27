---
import Layout from "../layouts/Layout.astro";
import StatsCards from "../components/StatsCards.astro";
import ProgressChart from "../react components/ProgressChart";
import ContinueWatching from "../components/ContinueWatching.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://app.studio27.rs";

const refreshToken = Astro.cookies.get("refreshToken")?.value;
const accessToken = Astro.cookies.get("accessToken")?.value;

let progressStats = {
	zavrseno: 0,
	uToku: 0,
	nijePoceto: 0,
};

let userData: any = { userId: null };

let stats = {
	totalCourses: 0,
	finished: 0,
	inProgress: 0,
	hours: 0,
};

try {
	const userRes = await fetch(`${API_URL}/api/auth/me`, {
		headers: {
			Authorization: `Bearer ${refreshToken}`,
		},
		credentials: "include",
	});

	if (!userRes.ok) {
		throw new Error(`Auth failed: ${userRes.status} ${userRes.statusText}`);
	}

	userData = await userRes.json();

	if (!userData.userId) {
		throw new Error("userId nije dostupan");
	}
} catch (e) {
	console.error("Greška pri auth/me:", e);
}

if (userData.userId) {
	try {
		const [brojKursevaResponse, brojZavrsenihKursevaResponse, brojUTokuKursevaResponse, brojSatiGledanjaResponse] =
			await Promise.all([
				fetch(`${API_URL}/api/broj-kurseva/${userData.userId}`, {
					headers: {
						Authorization: `Bearer ${accessToken}`,
					},
				}),
				fetch(`${API_URL}/api/progres/broj-zavrsenih-kurseva?userId=${userData.userId}`, {
					headers: {
						Authorization: `Bearer ${accessToken}`,
					},
				}),
				fetch(`${API_URL}/api/progres/broj-kurseva-u-toku?userId=${userData.userId}`, {
					headers: {
						Authorization: `Bearer ${accessToken}`,
					},
				}),
				fetch(`${API_URL}/api/broj-odgledanih-sati/${userData.userId}`, {
					headers: {
						Authorization: `Bearer ${accessToken}`,
					},
				}),
			]);

		if (brojKursevaResponse.ok) {
			const brojKursevaData = await brojKursevaResponse.json();
			stats.totalCourses = brojKursevaData.brojKurseva || 0;
		} else {
			console.log("Greška pri dohvatanju broja kurseva");
		}

		if (brojZavrsenihKursevaResponse.ok) {
			const brojZavrsenihKursevaData = await brojZavrsenihKursevaResponse.json();
			stats.finished = brojZavrsenihKursevaData.brojZavrsenihKurseva || 0;
		} else {
			console.log("Greška pri dohvatanju broja završenih kurseva");
		}

		if (brojUTokuKursevaResponse.ok) {
			const brojUTokuKursevaData = await brojUTokuKursevaResponse.json();
			stats.inProgress = brojUTokuKursevaData.brojKursevaUToku || 0;
		} else {
			console.log("Greška pri dohvatanju broja kurseva u toku");
		}

		if (brojSatiGledanjaResponse.ok) {
			const brojSatiGledanjaData = await brojSatiGledanjaResponse.json();
			stats.hours = brojSatiGledanjaData.brojSati || 0;
		} else {
			console.log("Greška pri dohvatanju broja sati");
		}

		progressStats = {
			zavrseno: stats.finished,
			uToku: stats.inProgress,
			nijePoceto: stats.totalCourses,
		};
	} catch (error) {
		console.error("Greška pri učitavanju statistike:", error);
	}
}
---

<Layout title="Početna">
	<div class="space-y-8 animate-fade-in">
		<div>
			<h1 class="text-2xl font-bold text-white">Dobrodošli</h1>
			<p class="text-sm text-neutral-500 mt-1">Vaš pregled napretka i aktivnosti</p>
		</div>

		<StatsCards stats={stats} />

		<div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
				<h2 class="text-base font-semibold text-white">Statistika učenja</h2>
				<span class="text-xs text-neutral-500">pregled kurseva</span>
			</div>

			<ProgressChart
				client:only="react"
				zavrseno={progressStats.zavrseno}
				uToku={progressStats.uToku}
				nijePoceto={progressStats.nijePoceto}
			/>
		</div>

		<ContinueWatching />
	</div>
</Layout>