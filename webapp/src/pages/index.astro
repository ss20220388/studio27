---
import Layout from "../layouts/Layout.astro";
import StatsCards from "../components/StatsCards.astro";
import ProgressChart from "../react components/ProgressChart";
import ContinueWatching from "../components/ContinueWatching.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

const token = Astro.cookies.get("refreshToken")?.value;
console.log("Token:", token);
let progressStats={
	zavrseno:0,
	uToku:0,
	nijePoceto:0,
};

let userData: any = { userId: null };
let stats = {
	totalCourses: 0,
	finished: 0,
	inProgress: 0,
	hours: 12,
};

try {
	const userRes = await fetch(`${API_URL}/api/auth/me`, {
		headers: {
			Authorization: `Bearer ${token}`,
		},	
		credentials: "include"
	});
	userData = await userRes.json();
	console.log(userData);

	const brojKursevaResponse = await fetch(`${API_URL}/api/broj-kurseva/${userData.userId}`,
		{
			headers: {
				Authorization: `Bearer ${token}`,
			},
		}
	);
	const brojKursevaData = await brojKursevaResponse.json();
	console.log(brojKursevaData);

	const brojOdgledanihKursevaResponse = await fetch(`${API_URL}/api/broj-odgledanih-kurseva/${userData.userId}`,
		{
			headers: {
				Authorization: `Bearer ${token}`,
			},
		}
	);
	const brojOdgledanihKursevaData = await brojOdgledanihKursevaResponse.json();
	console.log(brojOdgledanihKursevaData);

	const brojUTokuKursevaResponse = await fetch(`${API_URL}/api/broj-u-toku-kurseva/${userData.userId}`,
		{
			headers: {
				Authorization: `Bearer ${token}`,
			},
		}
	);
	const brojUTokuKursevaData = await brojUTokuKursevaResponse.json();
	console.log(brojUTokuKursevaData);

	stats = {
		totalCourses: brojKursevaData.brojKurseva || 0,
		finished: brojOdgledanihKursevaData.brojOdgledanihKurseva || 0,
		inProgress: brojUTokuKursevaData.brojUTokuKurseva || 0,
		hours: 12,
	};

	const response = await fetch(`${API_URL}/api/progress-stats/${userData.userId}`, {
		headers: token ? { Authorization: `Bearer ${token}` } : {},
	});

	if (response.ok) {
		progressStats = await response.json();
	}
} catch (error) {
	console.error("Greška pri učitavanju podataka:", error);
}
---

<Layout title="Početna">
	<div class="space-y-8 animate-fade-in">
		<div>
			<h1 class="text-2xl font-bold text-white">Dobrodošli</h1>
			<p class="text-sm text-neutral-500 mt-1">Vaš pregled napretka i aktivnosti</p>
		</div>

		<StatsCards stats={stats} />

		<div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
				<h2 class="text-base font-semibold text-white">Statistika učenja</h2>
				<span class="text-xs text-neutral-500">pregled kurseva</span>
			</div>
			<ProgressChart client:only="react" zavrseno={progressStats.zavrseno} uToku={progressStats.uToku} nijePoceto={progressStats.nijePoceto} />
		</div>

		<ContinueWatching />
	</div>
</Layout>
