---
import Layout from "../layouts/Layout.astro";
import SettingsCard from "../react components/SettingsTabs/SettingsCard";
const token = Astro.cookies.get("refreshToken")?.value || null;
const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
---
<Layout title="Podešavanja">
  <div class="space-y-6 animate-fade-in">
    <div>
      <h1 class="text-2xl font-bold text-white">Podešavanja naloga</h1>
      <p class="text-sm text-neutral-500 mt-1">Upravljajte svojim nalogom i podešavanjima</p>
    </div>
    <div class="w-full max-w-3xl">
      <SettingsCard token={token} client:visible />
    </div>
  </div>
</Layout>