---
// @ts-nocheck
import Layout from "../layouts/Layout.astro";
import ContactFormWebapp from "../react components/ContactFormWebapp.tsx";

const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
---

<Layout title="Kontakt">
    <div class="space-y-6 animate-fade-in max-w-2xl">
        <div>
            <h1 class="text-2xl font-bold text-white">Kontakt</h1>
            <p class="text-sm text-neutral-500 mt-1">Javite nam se za bilo kakva pitanja</p>
        </div>

        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
            <h2 class="text-sm font-semibold text-white mb-3">Telefon</h2>
            <div class="space-y-2">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-red-900/15 flex items-center justify-center">
                        <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-red-400"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" /></svg>
                    </div>
                    <a href="tel:+381665934314" class="text-sm text-red-400 hover:text-red-300 transition-colors">+381 66 5934 314</a>
                </div>
               
            </div>
        </div>

        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
            <h2 class="text-sm font-semibold text-white mb-4">Pošaljite nam poruku</h2>
            <ContactFormWebapp client:load publicApiUrl={PUBLIC_API_URL} />
        </div>
    </div>
</Layout>