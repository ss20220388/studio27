---
import React from "react";
import ReactKurs from "../react components/ReactKurs";
import Layout from "../layouts/Layout.astro";

interface Kurs {
    id: number;
    naziv: string;
    opis: string;
    cena: number;
    trajanje: number;
    slikaUrl: string;
}
const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch("http://api.studio27.rs/api/auth/me", {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();

const kurseviResponse = await fetch(
    "http://api.studio27.rs/api/moj-kursevi/" + userData.userId,
    {
        headers: {
            Authorization: `Bearer ${token}`,
        },
    },
);
const kurseviData = await kurseviResponse.json();
console.log(kurseviData);
---

<Layout title="Moji kursevi">
    <main class="px-10 py-4 flex flex-col items-center justify-center h-screen">
        <h1 class="text-3xl font-bold mb-10">Moj kursevi</h1>

        <div
            class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 overflow-y-scroll h-full"
        >
            {
                kurseviData.kursevi?.map((kurs: Kurs) => (
                    <ReactKurs
                        client:idle
                        kurs={kurs}
                        userId={userData.userId}
                        accessToken={token}
                    />
                ))
            }
        </div>
    </main>
</Layout>
