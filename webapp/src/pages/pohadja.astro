---
import React from "react";
import ReactKurs from "../react components/ReactKurs";
import Layout from "../layouts/Layout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

interface Kurs {
    id: number;
    naziv: string;
    opis: string;
    cena: number;
    trajanje: number;
    slikaUrl: string;
}
const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch(`${API_URL}/api/auth/me`, {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();

const kurseviResponse = await fetch(
    `${API_URL}/api/moj-kursevi/` + userData.userId,
    {
        headers: {
            Authorization: `Bearer ${token}`,
        },
    },
);
const kurseviData = await kurseviResponse.json();
console.log(kurseviData);
---

<Layout title="Moji kursevi">
    <div class="space-y-6 animate-fade-in">
        <div>
            <h1 class="text-2xl font-bold text-white">Moji kursevi</h1>
            <p class="text-sm text-neutral-500 mt-1">
                Kursevi na koje ste upisani
            </p>
        </div>

        <div class="bg-red-900/20 border border-red-800/40 rounded-lg p-4 mb-6">
            <p
                class="inline-block bg-red-900/40 text-white text-sm font-semibold px-4 py-2 rounded-full"
            >
                ℹ️ Klikni na kurs da vidiš detalje i kupi
            </p>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4 stagger-children">
            {
                kurseviData.kursevi?.map((kurs: Kurs) => (
                    <ReactKurs
                        client:idle
                        kurs={kurs}
                        userId={userData.userId}
                        accessToken={token}
                    />
                ))
            }
        </div>
    </div>
</Layout>
