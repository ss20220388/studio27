---
import React from "react";
import ReactKurs from "../react components/ReactKurs";
import Layout from "../layouts/Layout.astro";

interface Kurs {
    id: number;
    naziv: string;
    opis: string;
    cena: number;
    trajanje: number;
    slikaUrl: string;
}
const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch("http://api.studio27.rs/api/auth/me", {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();

const kurseviResponse = await fetch("http://api.studio27.rs/api/moj-kursevi?userId=" + userData.userId, {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const kurseviData = await kurseviResponse.json();
console.log(kurseviData);
---

<Layout title="Moji kursevi">
    <main class="p-8 overflow-y-scroll max-h-screen">
        <h1 class="text-3xl font-bold mb-8">Moji kursevi</h1>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {kurseviData.kursevi?.map((kurs: Kurs) => (
                <ReactKurs client:idle  kurs={kurs} userId={userData.userId} accessToken={token} />
            ))}
        </div>
    </main>
</Layout>
