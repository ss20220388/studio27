---
import Layout from "../../layouts/Layout.astro";

const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch("http://api.studio27.rs/api/auth/me", {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});
const userData = await response.json();

console.log("User data:", userData);

const pohadjaRes = await fetch(`http://api.studio27.rs/api/pohadjam-kurs?userId=${userData.userId}&kursId=${Astro.params.id}`, {
    headers: {
        Authorization: `Bearer ${token}`,
    },
});

const pohadjaData = await pohadjaRes.json();
console.log("Pohadja data:", pohadjaData);
const pohadjanje = pohadjaData.pohadja;
if (pohadjanje) {
    try{
        const updateResponse = await fetch(`http://api.studio27.rs/api/pohadjam-kurs/${pohadjanje.id}/update-status`, {
            method: "POST",
            headers: {
                Authorization: `Bearer ${token}`,
                "Content-Type": "application/json",
            },
            body: JSON.stringify({ status: "active" }),
        });

        if (!updateResponse.ok) {
            console.error("Failed to update course status");
        } else {
            console.log("Course status updated successfully");
        }
    } catch (error) {
        console.error("Error updating course status:", error);
    }
} else {
    console.log("Niste upisani na ovaj kurs.");
}
---
<Layout title="Detalji kursa">
    <main class="p-8">
        <h1 class="text-3xl font-bold mb-4">Detalji kursa</h1>
        {pohadjanje ? (
            <div>
                <p class="text-lg mb-2">Status: {pohadjanje.status}</p>
                <p class="text-lg mb-2">Datum početka: {new Date(pohadjanje.datumPocetka).toLocaleDateString()}</p>
                <p class="text-lg mb-2">Datum završetka: {new Date(pohadjanje.datumZavrsetka).toLocaleDateString()}</p>
            </div>
        ) : (
            <p class="text-lg mb-2">Niste upisani na ovaj kurs.</p>
        )}

    </main>
</Layout>