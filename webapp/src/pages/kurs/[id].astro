---
import Layout from "../../layouts/Layout.astro";
import KursPlayer from "../../react components/KursPlayer";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://api.studio27.rs";
const token = Astro.cookies.get("refreshToken")?.value || null;
let pohadjanje = null;
let userData = null;
let klipIlekcijeData = null;
let materijaliData = null;
try {
  const response = await fetch(`${API_URL}/api/auth/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  userData = await response.json();

  const klipIlekcijeRes = await fetch(
    `${API_URL}/api/pohadjam-kurs-lekcije?userId=${userData.userId}&kursId=${Astro.params.id}`,
    { headers: { Authorization: `Bearer ${token}` } },
  );

  klipIlekcijeData = await klipIlekcijeRes.json();
  pohadjanje = klipIlekcijeData.pohadja ? klipIlekcijeData : null;

  const response2 = await fetch(`${API_URL}/api/materijaliZaKurs/${Astro.params.id}`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  materijaliData = await response2.json();
  materijaliData = materijaliData.materijali || [];
} catch (error) {
  console.error("Error fetching data:", error);
}


---

<Layout title="Detalji kursa">
  <div class="animate-fade-in">
    {
      pohadjanje ? (
        <KursPlayer
          lekcije={klipIlekcijeData.lekcije}
          materijali={materijaliData}
          token={token}
          API_URL={API_URL}
          client:load
        />
      ) : (
        <div class="bg-red-900/15 border border-red-900/20 text-red-400 p-4 rounded-xl text-sm">
          Niste upisani na ovaj kurs.
        </div>
      )
    }
   
  </div>
</Layout>
