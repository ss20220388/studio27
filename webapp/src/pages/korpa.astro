---
import Layout from "../layouts/Layout.astro";

import ReactKurs from "../react components/ReactKurs";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

const token = Astro.cookies.get("refreshToken")?.value || null;
const response = await fetch(`${API_URL}/api/auth/me`, {
  headers: {
    Authorization: `Bearer ${token}`,
  },
});
const userData = await response.json();

interface Kurs {
  id: number;
  naziv: string;
  opis: string;
  cena: number;
  trajanje: number;
  slikaUrl: string;
}
interface ResponseData {
  kursevi: Kurs[];
}

const data: Response = await fetch(`${API_URL}/api/kursevi`);

const kurseviRes: ResponseData = await data.json();
const kursevi = kurseviRes.kursevi;
console.log("=== KORPA DEBUG ===");
console.log("API_URL:", API_URL);
console.log("Token exists:", !!token);
console.log("User Data:", userData);
console.log("Kursevi:", kursevi);
---

<Layout title="Korpa">
  <div class="space-y-6 animate-fade-in">
    <div>
      <h1 class="text-2xl font-bold text-white">Otključaj kurseve</h1>
      <p class="text-sm text-neutral-500 mt-1">Pregledajte i kupite kurseve</p>
    </div>

    <div class="bg-red-900/20 border border-red-800/40 rounded-lg p-4 mb-6">
      <p class="inline-block bg-red-900/40 text-white text-sm font-semibold px-4 py-2 rounded-full">
        ℹ️ Klikni na kurs da vidiš detalje i kupi
      </p>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4 stagger-children">
      {
        kursevi.map((kurs) => (
          <ReactKurs
            paid={false}
            client:idle
            kurs={kurs}
            userId={userData.userId}
            accessToken={token}
          />
        ))
      }
    </div>
  </div>
</Layout>
