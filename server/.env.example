# Backend Server Configuration
# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studio27baza
DB_USER=root
DB_PASSWORD=your_password_here

# Server
SERVER_PORT=8080

# JWT (ako koristiš environment variables)
JWT_SECRET=your_secret_key_here
JWT_EXPIRATION=86400000

# Logging
LOGGING_LEVEL=INFO

# Adrese (OBAVEZNO, iste kao u client/webapp/admin .env; bez kose crte na kraju)
# Lokalno:
PUBLIC_API_URL=http://api.studio27.rs
PUBLIC_CLIENT_URL=http://studio27.rs
PUBLIC_ADMIN_URL=http://admin.studio27.rs
PUBLIC_APP_URL=http://app.studio27.rs
# Kolacici za prijavu (OBAVEZNO): domen sa tackom na pocetku
APP_COOKIE_DOMAIN=.studio27.rs
# true kada sajt radi preko https (produkcija)
APP_COOKIE_SECURE=false
# Opciono: dodatni CORS domeni, odvojeni zarezom
# APP_CORS_DODATNI=

# Produkcija (primer):
# PUBLIC_API_URL=https://api.27archviz.com
# PUBLIC_CLIENT_URL=https://27archviz.com
# PUBLIC_ADMIN_URL=https://admin.27archviz.com
# PUBLIC_APP_URL=https://app.27archviz.com
# APP_COOKIE_DOMAIN=.27archviz.com
# APP_COOKIE_SECURE=true
